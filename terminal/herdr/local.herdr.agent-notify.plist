<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.herdr.agent-notify</string>

    <!--
      Desktop notification when a herdr agent stops working, standing in for
      herdr's own background notification: its in-app toast is invisible behind a
      browser, its terminal delivery is silent through iTerm, and its system
      delivery opens the wrong target on click. See agent-notify.sh.

      Install with GomGomBot's scripts/install-launchd.sh, which rewrites the
      absolute path below to wherever this checkout actually lives. Do NOT
      hand-edit the path.
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/yoyoo/.dotfiles/terminal/herdr/agent-notify.sh</string>
    </array>

    <!-- 30s. This is the "your agent finished while you were in Slack" latency,
         and a tick is one `herdr pane list`. launchd never runs two instances of
         one label, so a slow tick cannot be lapped. -->
    <key>StartInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/tmp/herdr-agent-notify.launchd.stdout</string>
    <key>StandardErrorPath</key>
    <string>/tmp/herdr-agent-notify.launchd.stderr</string>

    <!-- Safe on load: with no state file the first run only records a baseline,
         and with one it reports transitions that really happened. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
