#!/bin/bash
# Once a day at 05:00 (launchd): ask the main pane for a handoff, then /clear it in place, so the next
# session starts fresh and loads the handoff by itself. Runs under macOS bash 3.2.
#   main-refresh         the daily run: only 05:00-06:59, once a day
#   main-refresh --now   the same at any hour, as often as asked: for a main pane whose context grew too big, since
#                        nobody types /clear there any more (2026-11-05). What decides when to call it is not here.
#                        From a pane on the workers server, drop both of its server variables to reach the main pane:
#                        env -u HERDR_SOCKET_PATH -u HERDR_SESSION main-refresh --now
#   main-refresh --restart  --now, but ends the Claude process and starts a new one in the pane's shell instead of /clear:
#                        CLI settings such as the startup profile load only at process start (api#1204).
# Test knobs: MAIN_REFRESH_HOUR (wins over the clock), _POLL, _DEADLINE, _HANDOFF_WAIT (seconds, fractions ok),
# _QUIET, _RETRY_QUIET (whole seconds), _PANE_TELL, HERDR_BIN_PATH, and HERDR_ERROR_NOTIFY.
# A run from inside the main pane would make pane-tell refuse "this pane"; launchd sets none anyway.
# HERDR_SOCKET_PATH stays: a run from a workers pane must find nothing, not reach the default server.
unset HERDR_PANE_ID
now=; restart=
case "${1:-}" in --now) now=1 ;; --restart) now=1 restart=1 ;; esac
H=${HERDR_BIN_PATH:-herdr}
# Commands in ~/.local/bin are symlinks; adjacent helpers live beside the real script.
HERE=$(/usr/bin/python3 -I -c 'import os, sys; print(os.path.dirname(os.path.realpath(sys.argv[1])))' "$0")
TELL=${MAIN_REFRESH_PANE_TELL:-$HERE/pane-tell}
STATE=${XDG_STATE_HOME:-$HOME/.local/state}
DIR=$STATE/orchestrator
# 5 s: on a sleeping Mac the job gets only short dark-wake slices inside the window.
POLL=${MAIN_REFRESH_POLL:-5}
# Nightly refresh leaves time to read the last turn. Threshold-triggered --now
# instead takes the first idle turn with an empty input box, ignoring quiet time.
QUIET=${MAIN_REFRESH_QUIET:-$([ -n "$now" ] && echo 0 || echo 600)}
RETRY_QUIET=${MAIN_REFRESH_RETRY_QUIET:-$([ -n "$now" ] && echo 0 || echo 5)}
HANDOFF_WAIT=${MAIN_REFRESH_HANDOFF_WAIT:-1800}
hdir=$STATE/agent-handoff
# A named herdr server keeps its handoffs in a folder of its own: the same rule as `handoff`.
if [[ "${HERDR_SOCKET_PATH:-}" == */sessions/*/herdr.sock ]]; then s=${HERDR_SOCKET_PATH%/herdr.sock}; hdir=$hdir/${s##*/}; fi

log() { mkdir -p "$DIR" && echo "$(date '+%F %T') $*" >> "$DIR/refresh.log"; }
# A skipped run must not leave its memo behind: a later hand /clear would load it and say "continue from this".
skip() {
  local error=
  [ "${1:-}" != --error ] || { error=1; shift; }
  kill $(jobs -p) 2>/dev/null
  if [ -z "${keep_gate:-}" ] && [ -n "${req:-}" ] && newer; then
    # A late save still answers the pending request, even if the pane is busy before our first idle check.
    if memo_ready && ! acknowledge; then log "인계 저장 응답을 기록하지 못해 인계 파일을 보존함"
    else mv -f "$hdir/$key.md" "$hdir/$key.md.skipped"; fi
  fi
  log "$*"
  # Busy input, new work and the time window are expected skips. Only failed operations need an alert.
  if [ -n "$error" ]; then
    if [ -n "${HERDR_ERROR_NOTIFY:-}" ]; then
      "$HERDR_ERROR_NOTIFY" "메인 세션 새로 시작 실패" "$*" >/dev/null 2>&1
    else
      /usr/bin/python3 -I "$HERE/herdr-error-notify.py" "메인 세션 새로 시작 실패" "$*" >/dev/null 2>&1
    fi || log "오류 알림을 보내지 못함: $*"
  fi
  exit 0
}
in_window() { [ -z "$now" ] || return 0; case "${MAIN_REFRESH_HOUR:-$(date +%H)}" in 05|06) return 0 ;; esac; return 1; }
late() { in_window || skip "새벽 05~06시가 지나 건너뜀"; }
status() { "$H" pane get "$1" 2>/dev/null | jq -r '.result.pane.agent_status // empty'; }
# Polls "$@" until it passes or $limit seconds pass; a background sleep also handles fractions.
# Each poll rechecks the hour: a Mac that sleeps in the wait wakes late with the script still running.
wait_for() { # <limit> <cmd...>
  local limit=$1 t; shift
  sleep "$limit" & t=$!
  while :; do
    if ! kill -0 "$t" 2>/dev/null || { [ -n "${budget:-}" ] && ! kill -0 "$budget" 2>/dev/null; }; then
      kill "$t" 2>/dev/null; wait "$t" 2>/dev/null; return 1
    fi
    if "$@"; then break; fi
    late; sleep "$POLL"
  done
  kill "$t" 2>/dev/null; wait "$t" 2>/dev/null; return 0
}

day=$(date +%F)
term=$(cat "$DIR/main" 2>/dev/null)
[ -n "$term" ] || { log "메인 칸 파일 없음"; exit 0; }
[ -n "$now" ] || [ ! -f "$DIR/refreshed-$day" ] || exit 0
in_window || skip "새벽 05~06시가 아니라 건너뜀"
# One run at a time: a caller may ask again while a run waits (up to an hour). A lock 2 hours old is a dead run's.
lock=$DIR/refresh.lock
mkdir -p "$DIR"
if ! mkdir "$lock" 2>/dev/null; then
  { [ -n "$(find "$lock" -maxdepth 0 -mmin +120 2>/dev/null)" ] && rmdir "$lock" && mkdir "$lock"; } 2>/dev/null \
    || { log "다른 실행이 진행 중이라 건너뜀"; exit 0; }
fi
gate=$DIR/refresh-delivery.json
trap 'kill $(jobs -p) 2>/dev/null; wait 2>/dev/null; [ -n "${keep_gate:-}" ] || rm -f "$gate"; rmdir "$lock" 2>/dev/null' EXIT
row=$("$H" pane list 2>/dev/null | jq -c --arg t "$term" '[.result.panes[] | select(.terminal_id == $t)][0] // empty')
id=$(jq -r '.pane_id // empty' <<<"$row" 2>/dev/null)
[ -n "$id" ] || { log "메인 칸을 찾지 못함 ($term)"; exit 0; }
sid=$(jq -r '.agent_session.value // empty' <<<"$row")

# Stop automatic relays before waiting for the first idle turn. Serialize with
# pane-tell's final screen-check/prompt lock, so an already accepted prompt
# finishes before the hold starts. The handoff request alone may pass the hold.
hold_delivery() {
  [ -n "${holding:-}" ] && return 0
  (umask 077; /usr/bin/python3 -I - "$STATE/pane-tell/sending/$id.lock" "$gate" "$$" "$term" "$sid" <<'PY'
import fcntl, json, os, sys
lock_path, gate, pid, terminal, session = sys.argv[1:]
os.makedirs(os.path.dirname(lock_path), exist_ok=True)
with open(lock_path, "a") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    with open(gate + ".tmp", "w") as stream:
        json.dump(dict(pid=int(pid), terminal=terminal, session=session), stream)
    os.replace(gate + ".tmp", gate)
PY
  ) || skip --error "전달 보류 상태를 저장하지 못해 건너뜀"
  holding=1
}
[ -z "$now" ] || hold_delivery

# A pane moved between workspaces keeps its old id in HERDR_PANE_ID, and `handoff save` names its file by that,
# so the key is found through the session id; the listed id is the fallback.
key=$id
if [ -n "$sid" ]; then
  # ponytail: top level only (subfolders belong to named servers). Several files can hold one session id: the newest wins.
  m=$(grep -l -F -- "$sid" "$hdir"/*.md.transcript 2>/dev/null | xargs ls -t 2>/dev/null | head -n 1)
  [ -z "$m" ] || { key=${m##*/}; key=${key%.md.transcript}; }
fi
transcript=$(cat "$hdir/$key.md.transcript" 2>/dev/null)
# The watcher may time out or die after delivery. Keep the outstanding request across processes;
# the execution lock alone cannot distinguish that from a request that was never sent.
# There is one registered main pane per server. Its handoff key can change while its session stays the same.
request_file=$hdir/main-refresh.refresh-request
ack_file=$request_file.ack
if [ -f "$request_file" ]; then
  jq -e 'type == "object" and (.session | type == "string") and (.transcript | type == "string")
    and (.token | type == "string" and length > 0) and (.ask | type == "string" and length > 0)' "$request_file" >/dev/null 2>&1 \
    || skip --error "보관된 인계 요청을 읽지 못해 건너뜀"
  if jq -e --arg s "$sid" --arg t "$transcript" '.session == $s and ($s != "" or .transcript == $t)' "$request_file" >/dev/null; then
    req=1
    token=$(jq -r .token "$request_file")
    ask=$(jq -r .ask "$request_file")
    ! grep -Fqx -- "$token" "$ack_file" 2>/dev/null || acknowledged=1
    log "앞 실행의 인계 요청 응답을 계속 기다림"
  else
    rm -f "$request_file" "$ack_file"
  fi
fi

idle() { case "$(status "$id")" in idle|done) return 0 ;; esac; return 1; }
# A turn that just ended means someone may be reading it. mtime is wall clock, so this holds across sleep.
quiet() { [ $(( $(date +%s) - $(stat -f %m "$transcript" 2>/dev/null || date +%s) )) -ge "$QUIET" ]; }
rested() { idle && { [ -n "$now" ] || quiet; }; }
same_session() {
  [ -z "$sid" ] || [ "$("$H" pane get "$id" 2>/dev/null | jq -r '.result.pane.agent_session.value // empty')" = "$sid" ]
}
newer() { [ -n "$(find "$hdir/$key.md" -newer "${request_file:-$lock}" 2>/dev/null)" ]; }
# -s: an empty memo is none. The nonce also rejects a newer memo saved before queued delivery.
memo_ready() { [ -s "$hdir/$key.md" ] && newer && grep -Fqx -- "$token" "$hdir/$key.md"; }
acknowledge() {
  acknowledged=1
  # Bind the acknowledgment to its nonce: a crash after replacing the request must not reuse an old acknowledgment.
  (umask 077; printf '%s\n' "$token" > "$ack_file.tmp.$$" && mv -f "$ack_file.tmp.$$" "$ack_file")
}
# pane-tell can fail after moving the payload into waiting, before registering its receiver.
# Bound the inspection; an unreadable or oversized queue is uncertain, so retain the request.
request_may_be_queued() {
  /usr/bin/python3 -I - "$STATE/pane-tell/waiting" "$token" <<'PY'
import os
import sys

directory, token = sys.argv[1], sys.argv[2].encode()
try:
    entries = os.scandir(directory)
except FileNotFoundError:
    sys.exit(10)
except OSError:
    sys.exit(0)
try:
    with entries:
        for count, entry in enumerate(entries):
            if count >= 512 or not entry.is_file(follow_symlinks=False):
                sys.exit(0)
            with open(entry.path, "rb") as payload:
                content = payload.read(65537)
            if token in content or len(content) > 65536:
                sys.exit(0)
except OSError:
    sys.exit(0)
sys.exit(10)
PY
  [ "$?" -ne 10 ] # Only the explicit "absent" result authorizes another delivery.
}
fresh() {
  memo_ready || return 1
  # Saving is the acknowledgment, even if the pane is still finishing its reply.
  acknowledge || return 1
  idle
}
# The last real user message must still be our whole request (pane-tell prefixes it, so compare the end).
# Images and queued input count as new work; meta lines, tool results and compaction summaries do not.
request_current() {
  local last
  last=$(tail -n 2000 "$transcript" 2>/dev/null | jq -rs '[.[]
    | if .type == "attachment" and .attachment.type? == "queued_command" then "queued"
      elif .type == "user" and .isMeta != true and .isCompactSummary != true then
        .message.content | if type == "string" then . else (map(select(.type != "tool_result")) | select(length > 0) | "array") end
      else empty end][-1] // ""' 2>/dev/null)
  [[ "$last" == *"$ask" ]]
}
if [ -n "${MAIN_REFRESH_DEADLINE:-}" ]; then deadline=$MAIN_REFRESH_DEADLINE
elif [ -n "$now" ]; then deadline=1800
else deadline=$(( $(date -j -f %H:%M:%S 07:00:00 +%s) - $(date +%s) )); [ "$deadline" -gt 0 ] || deadline=0; fi
# A single budget covers every retry, including queued delivery. The watcher retries a timed-out run next minute.
if [ -n "$now" ]; then sleep "$deadline" & budget=$!; fi
attempt=0
while :; do
wait_for "$deadline" rested || skip "메인 칸이 $([ -n "$now" ] && echo '30분 동안' || echo '07:00까지') 쉬지 않아 건너뜀"
late # the Mac may have slept through the first wait
hold_delivery
# Wait for empty input without letting ordinary relays take this idle turn.
request_ready() { idle && "$TELL" --box-ready "$id" claude >/dev/null 2>&1 && idle; }
handoff_ready() { rested && request_ready; }
if [ -n "$now" ]; then
  wait_for "$deadline" handoff_ready || skip "입력창이나 대기 중인 글을 기다리다 건너뜀"
else
  "$TELL" --box-ready "$id" claude >/dev/null 2>&1 || skip "입력창이 비어 있지 않아 건너뜀"
fi
late # --box-ready takes a moment; the Mac may have slept across it
same_session || skip "세션이 바뀌어 건너뜀"
# The pane may have started answering during the readiness/session checks. Re-enter the wait before sending anything.
if ! idle; then
  [ -z "$now" ] || continue
  skip "인계 요청 전에 칸이 다시 일하고 있어 건너뜀"
fi

# A final-check race can retry without adding any conversation. Reuse this request's saved answer in that case;
# a missing memo or genuinely later user input still needs another request with its own nonce.
if [ -n "${req:-}" ] && memo_ready && request_current; then
  fresh || skip "인계 뒤에 칸이 다시 일하고 있어 건너뜀"
  log "이미 저장된 인계로 확인을 계속함"
else
if [ -z "${req:-}" ] || [ -n "${acknowledged:-}" ]; then
attempt=$((attempt + 1))
# Background jobs outlive the clear and their end reaches the next session (tested 2026-11-05), which must know what each
# one watches; one that has stopped is started again from its command, never a second copy of one still running.
what="열린 상태 다섯 가지만 인계하세요. (1) 지금 도는 부하 세션과 각 세션의 일. (2) 감시 중인 Slack 스레드와 각각의 재감시 명령. (3) 답을 기다리는 요유 질문과 그 위치(회사 결정은 보드 링크, 개인 결정은 파일 위치). (4) 이 세션에서 백그라운드로 도는 작업(main-refresh 자신은 빼고)과 각각의 재시작 명령(명령 전문). 다음 세션은 pgrep -f로 이미 도는 작업은 건너뛰고 다시 겁니다. (5) 오늘 남은 일(이 인계 요청 직전에 받은 글 중 아직 처리하지 않은 요청은 원문 포함). 배운 요령은 ~/.claude/skills/main-orchestrator/references/에 적고 인계에는 쓰지 마세요. '앞 인계 그대로' 같은 사슬 참조는 쓰지 말고 필요한 줄은 직접 옮겨 적으세요."
if [ -n "$restart" ]; then ask="[main-refresh] 시작 설정을 새로 적용하려고 이 세션의 Claude 프로세스를 다시 켭니다. 다시 켜면 이 세션의 백그라운드 작업과 Monitor도 멈추므로 (4)에 빠짐없이 적으세요. 다음 세션이 이어받도록 ${what} handoff save로 저장하고 '인계 저장함' 한 줄로 끝내세요. 다른 일은 하지 마세요. 저장하면 프로세스가 저절로 다시 켜집니다."
elif [ -n "$now" ]; then ask="[main-refresh] 대화가 길어 지금 새로 시작합니다. 다음 세션이 이어받도록 ${what} handoff save로 저장하고 '인계 저장함' 한 줄로 끝내세요. 다른 일은 하지 마세요. 저장하면 /clear가 저절로 옵니다."
else ask="[main-refresh] 새벽 정리입니다. ${what} handoff save로 저장하고 '인계 저장함' 한 줄로 끝내세요. 다른 일은 하지 마세요."; fi
# Both the delivered request and the memo must name this attempt. A save made while our request is queued is not its answer.
token="[request:$$:$attempt]"
ask="$ask 인계 첫 줄에 다음 요청 번호를 그대로 남기세요: $token"
# Persist before attempting delivery: an unknown result or a crash may still mean it arrived.
# Its unchanged mtime rejects an older memo, including a save made in the same second.
mkdir -p "$hdir"
(umask 077; jq -n --arg s "$sid" --arg t "$transcript" --arg token "$token" --arg ask "$ask" \
  '{session:$s, transcript:$t, token:$token, ask:$ask}' > "$request_file.tmp.$$" \
  && mv -f "$request_file.tmp.$$" "$request_file") || skip --error "인계 요청을 보관하지 못해 건너뜀"
rm -f "$ack_file"
req=1; acknowledged=
out=$(MAIN_REFRESH_REQUEST_TOKEN="$token" "$TELL" "$id" "$ask" 2>/dev/null) \
  || {
    # A nonzero result can still leave a durable queued payload. Retry only when its nonce
    # is absent; successful but unrecognized results below also retain the pending request.
    if ! request_may_be_queued; then
      rm -f "$request_file" "$ack_file"
      req=
    fi
    skip --error "인계 요청을 보내지 못해 건너뜀"
  }
case "$out" in
  told*) ;;
  queued*) log "인계 요청이 대기열에 들어감: 전달과 인계 저장을 기다림" ;;
  *) skip --error "인계 요청 결과를 확인하지 못해 건너뜀" ;;
esac
fi
if ! wait_for "$HANDOFF_WAIT" fresh; then
  same_session || skip "세션이 바뀌어 건너뜀"
  memo_ready && skip "인계 뒤에 칸이 다시 일하고 있어 건너뜀"
  skip --error "인계가 저장되지 않아 건너뜀"
fi
fi

late
if [ -n "$now" ]; then
  wait_for "$deadline" request_ready || skip "인계 뒤 입력창이나 대기 중인 글을 기다리다 건너뜀"
else
  "$TELL" --box-ready "$id" claude >/dev/null 2>&1 || skip "입력창이 비어 있지 않아 건너뜀"
fi
# --box-ready reads the screen twice 0.7 s apart: a sleep or a whole new turn can land in between, so the checks follow it.
late
idle || skip "인계 뒤에 칸이 다시 일하고 있어 건너뜀"
# Ordinary relays remain durable in pane-tell's queue until the new session.
# Another run may have cleared the pane meanwhile: every check above read the old session's transcript.
same_session || skip "세션이 바뀌어 건너뜀"
# Loading a handoff consumes it: another session may have removed it during the screen checks.
if ! memo_ready; then
  if [ -n "$now" ]; then
    log "인계 파일이 바뀌어 인계를 다시 요청함"
    QUIET=$RETRY_QUIET
    continue
  fi
  skip "인계 파일이 바뀌어 건너뜀"
fi
# This check runs last, right before the /clear: a message that lands during any earlier check is still seen (11/05).
# The relay hold also covers the herdr call itself.
if ! request_current; then
  if [ -n "$now" ]; then
    log "인계 뒤에 새 대화가 있어 인계를 다시 요청함"
    QUIET=$RETRY_QUIET
    continue
  fi
  skip "인계 뒤에 새 대화가 있어 건너뜀"
fi
# Straight through herdr, never pane-tell's queue: a queued /clear would fire hours later and wipe the main pane.
keep_gate=1
jq '.clearing = true' "$gate" > "$gate.tmp" && mv -f "$gate.tmp" "$gate" \
  || { keep_gate=; skip --error "새 세션 전달 보류 상태를 저장하지 못함"; }
back="되돌리기: 메인 칸 셸에서 CLAUDE_STARTUP_PROFILE=full claude"
if [ -n "$restart" ]; then
  "$H" agent prompt "$id" /exit >/dev/null 2>&1 || { keep_gate=; skip --error "/exit를 보내지 못해 건너뜀"; }
  # /exit returns before the process ends; a line typed before the shell is back would reach the old session.
  # herdr 0.9 omits `agent` for a pane at its shell; an error reply has no pane_id, so it never counts as one.
  shell_back() {
    "$H" pane get "$id" 2>/dev/null | jq -e '.result.pane | .pane_id != null and .agent == null and .agent_status == "unknown"' >/dev/null
  }
  wait_for "$deadline" shell_back || { keep_gate=; skip --error "/exit 뒤 claude가 끝나지 않아 다시 켜지 못함"; }
  # The pane's own shell runs it, so the claude alias (claude-online) picks this pane's profile by its terminal id.
  # A start that fails within a minute (a broken profile) retries with the full one; a later exit never does.
  # Not `herdr agent start`: it names the agent, and a named pane counts as one an agent opened (pane-label --close).
  # The old session is gone: keep its handoff for whichever start comes next. The kept gate holds nothing now,
  # since pane-tell releases it once this run ends and the pane's session has changed.
  "$H" pane run "$id" '_mr=$SECONDS; claude || (( SECONDS - _mr > 60 )) || CLAUDE_STARTUP_PROFILE=full claude' >/dev/null 2>&1 \
    || skip --error "claude를 다시 실행하지 못함. $back"
else
  "$H" agent prompt "$id" /clear >/dev/null 2>&1 || { keep_gate=; skip --error "/clear를 보내지 못해 건너뜀"; }
fi
# A successful command can return before /clear finishes. Do not release relays
# into the old session; a blank new session id is valid before its first prompt.
new_session_ready() { ! same_session && idle; }
wait_for "$deadline" new_session_ready \
  || skip --error "$([ -n "$restart" ] && echo "다시 켠 뒤 새 세션을 확인하지 못해 전달 보류를 유지함. $back" || echo "/clear 뒤 새 세션을 확인하지 못해 전달 보류를 유지함")"
keep_gate=
rm -f "$request_file" "$ack_file"
[ -n "$now" ] || { mkdir -p "$DIR" && : > "$DIR/refreshed-$day"; }
log "메인 칸 $id $([ -n "$restart" ] && echo '다시 켬 (--restart)' || echo "새로 시작함${now:+ (--now)}")"
break
done
