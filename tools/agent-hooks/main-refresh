#!/bin/bash
# Once a day at 05:00 (launchd): ask the main pane for a handoff, then /clear it in place, so the next
# session starts fresh and loads the handoff by itself. Runs under macOS bash 3.2.
#   main-refresh         the daily run: only 05:00-06:59, once a day
#   main-refresh --now   the same at any hour, as often as asked: for a main pane whose context grew too big, since
#                        nobody types /clear there any more (2026-11-05). What decides when to call it is not here.
#                        From a pane on the workers server, drop both of its server variables to reach the main pane:
#                        env -u HERDR_SOCKET_PATH -u HERDR_SESSION main-refresh --now
# Test knobs: MAIN_REFRESH_HOUR (wins over the clock), _POLL, _DEADLINE, _HANDOFF_WAIT (seconds, fractions ok),
# _QUIET (whole seconds), _PANE_TELL, and HERDR_BIN_PATH.
# A run from inside the main pane would make pane-tell refuse "this pane"; launchd sets none anyway.
# HERDR_SOCKET_PATH stays: a run from a workers pane must find nothing, not reach the default server.
unset HERDR_PANE_ID
now=; [ "${1:-}" != --now ] || now=1
H=${HERDR_BIN_PATH:-herdr}
TELL=${MAIN_REFRESH_PANE_TELL:-$(dirname "$0")/pane-tell}
STATE=${XDG_STATE_HOME:-$HOME/.local/state}
DIR=$STATE/orchestrator
# 5 s: on a sleeping Mac the job gets only short dark-wake slices inside the window.
POLL=${MAIN_REFRESH_POLL:-5}
# Quiet = someone may still be reading the last turn. At night that is a long time; --now is asked for in the day.
QUIET=${MAIN_REFRESH_QUIET:-$([ -n "$now" ] && echo 60 || echo 600)}
HANDOFF_WAIT=${MAIN_REFRESH_HANDOFF_WAIT:-1800}
hdir=$STATE/agent-handoff
# A named herdr server keeps its handoffs in a folder of its own: the same rule as `handoff`.
if [[ "${HERDR_SOCKET_PATH:-}" == */sessions/*/herdr.sock ]]; then s=${HERDR_SOCKET_PATH%/herdr.sock}; hdir=$hdir/${s##*/}; fi

log() { mkdir -p "$DIR" && echo "$(date '+%F %T') $*" >> "$DIR/refresh.log"; }
# A skipped run must not leave its memo behind: a later hand /clear would load it and say "continue from this".
skip() {
  kill $(jobs -p) 2>/dev/null
  if [ -n "${req:-}" ] && [ -f "$hdir/$key.md" ] && [ "$(stat -f %m "$hdir/$key.md")" -ge "$req" ]; then mv -f "$hdir/$key.md" "$hdir/$key.md.skipped"; fi
  log "$*"; "$H" notification show "메인 칸 새로 시작 건너뜀" --body "$*" >/dev/null 2>&1; exit 0; }
in_window() { [ -z "$now" ] || return 0; case "${MAIN_REFRESH_HOUR:-$(date +%H)}" in 05|06) return 0 ;; esac; return 1; }
late() { in_window || skip "새벽 05~06시가 지나 건너뜀"; }
status() { "$H" pane get "$1" 2>/dev/null | jq -r '.result.pane.agent_status // empty'; }
# Polls "$@" until it passes or $limit seconds pass; a background sleep also handles fractions.
# Each poll rechecks the hour: a Mac that sleeps in the wait wakes late with the script still running.
wait_for() { # <limit> <cmd...>
  local limit=$1 t; shift
  sleep "$limit" & t=$!
  while ! "$@"; do
    kill -0 "$t" 2>/dev/null || { return 1; }
    late; sleep "$POLL"
  done
  kill "$t" 2>/dev/null; wait "$t" 2>/dev/null; return 0
}

day=$(date +%F)
term=$(cat "$DIR/main" 2>/dev/null)
[ -n "$term" ] || { log "메인 칸 파일 없음"; exit 0; }
[ -n "$now" ] || [ ! -f "$DIR/refreshed-$day" ] || exit 0
in_window || skip "새벽 05~06시가 아니라 건너뜀"
row=$("$H" pane list 2>/dev/null | jq -c --arg t "$term" '[.result.panes[] | select(.terminal_id == $t)][0] // empty')
id=$(jq -r '.pane_id // empty' <<<"$row" 2>/dev/null)
[ -n "$id" ] || { log "메인 칸을 찾지 못함 ($term)"; exit 0; }
sid=$(jq -r '.agent_session.value // empty' <<<"$row")

# A pane moved between workspaces keeps its old id in HERDR_PANE_ID, and `handoff save` names its file by that,
# so the key is found through the session id; the listed id is the fallback.
key=$id
if [ -n "$sid" ]; then
  # ponytail: top level only (subfolders belong to named servers). Several files can hold one session id: the newest wins.
  m=$(grep -l -F -- "$sid" "$hdir"/*.md.transcript 2>/dev/null | xargs ls -t 2>/dev/null | head -n 1)
  [ -z "$m" ] || { key=${m##*/}; key=${key%.md.transcript}; }
fi
transcript=$(cat "$hdir/$key.md.transcript" 2>/dev/null)

idle() { case "$(status "$id")" in idle|done) return 0 ;; esac; return 1; }
# A turn that just ended means someone may be reading it. mtime is wall clock, so this holds across sleep.
quiet() { [ $(( $(date +%s) - $(stat -f %m "$transcript" 2>/dev/null || date +%s) )) -ge "$QUIET" ]; }
rested() { idle && quiet; }
if [ -n "${MAIN_REFRESH_DEADLINE:-}" ]; then deadline=$MAIN_REFRESH_DEADLINE
elif [ -n "$now" ]; then deadline=1800
else deadline=$(( $(date -j -f %H:%M:%S 07:00:00 +%s) - $(date +%s) )); [ "$deadline" -gt 0 ] || deadline=0; fi
wait_for "$deadline" rested || skip "메인 칸이 $([ -n "$now" ] && echo '30분 동안' || echo '07:00까지') 쉬지 않아 건너뜀"
late # the Mac may have slept through the first wait
# A queued request would count as delivered (pane-tell exits 0 on a queue), so the box must be empty first.
"$TELL" --box-ready "$id" claude >/dev/null 2>&1 || skip "입력창이 비어 있지 않아 건너뜀"
late # --box-ready takes a moment; the Mac may have slept across it

req=$(date +%s)
# Background jobs outlive the clear and their end reaches the next session (tested 2026-11-05), which must know what each
# one watches; one that has stopped is started again from its command, never a second copy of one still running.
what="지금 도는 밑 칸과 각 칸의 일, 모아 둔 결정(보드 링크, 개인 결정 파일), 감시 중인 Slack 스레드와 각각의 재감시 명령, 답을 기다리는 요유 질문과 그 자리, 이 칸에서 백그라운드로 도는 작업과 각각의 재시작 명령(명령 전문, 다음 세션은 pgrep -f로 이미 도는 것을 건너뛰고 다시 건다), 오늘 남은 일"
if [ -n "$now" ]; then ask="[main-refresh] 대화가 길어 지금 새로 시작합니다. 다음 세션이 이어받도록 ${what}을 handoff save로 남기고 '인계 저장함' 한 줄로 끝내세요. 다른 일은 하지 마세요. 저장하면 /clear가 저절로 옵니다."
else ask="[main-refresh] 새벽 정리입니다. ${what}을 handoff save로 남기고 '인계 저장함' 한 줄로 끝내세요. 다른 일은 하지 마세요."; fi
out=$("$TELL" "$id" "$ask" 2>/dev/null) \
  || skip "인계 요청을 보내지 못해 건너뜀"
case "$out" in told*) ;; *) skip "인계 요청이 대기열에 들어가 건너뜀" ;; esac
# stat -f %m is whole seconds like the request time, so a handoff from earlier does not count; -s: an empty memo is none.
fresh() { [ -s "$hdir/$key.md" ] && [ "$(stat -f %m "$hdir/$key.md")" -ge "$req" ] && idle; }
wait_for "$HANDOFF_WAIT" fresh || skip "인계가 저장되지 않아 건너뜀"

late
"$TELL" --box-ready "$id" claude >/dev/null 2>&1 || skip "입력창이 비어 있지 않아 건너뜀"
# --box-ready reads the screen twice 0.7 s apart: a sleep or a whole new turn can land in between, so the checks follow it.
late
idle || skip "인계 뒤에 칸이 다시 일하고 있어 건너뜀"
# The last real user message must still be our whole request (pane-tell prefixes it, so compare the end): a person's
# later message that merely mentions the marker is a new turn. An array that is not only tool results (an image) is one too.
last=$(tail -n 200 "$transcript" 2>/dev/null | jq -rs '[.[] | select(.type == "user" and .isMeta != true) | .message.content | if type == "string" then . else (map(select(.type != "tool_result")) | select(length > 0) | "array") end][-1] // ""' 2>/dev/null)
[[ "$last" == *"$ask" ]] || skip "인계 뒤에 새 대화가 있어 건너뜀"
# Straight through herdr, never pane-tell's queue: a queued /clear would fire hours later and wipe the main pane.
"$H" agent prompt "$id" /clear >/dev/null 2>&1 || skip "/clear를 보내지 못해 건너뜀"
[ -n "$now" ] || { mkdir -p "$DIR" && : > "$DIR/refreshed-$day"; }
log "메인 칸 $id 새로 시작함${now:+ (--now)}"
