#!/usr/bin/env bash
# Codex's weekly limit from the newest Codex session record that has one, as "<used percent>\t<reset epoch>\t<record epoch>":
# used is 0 once that week has reset, the record epoch is empty if the line has no timestamp, and nothing prints if no
# record of the last 8 days says. Share event ordering with routing; keep the legacy timestamp-free display fallback.
python3 -I "$(dirname "$(readlink -f "$0")")/agent-quota" codex-week "$(date +%s)" 2>/dev/null && exit 0
for f in $(find "${CODEX_HOME:-$HOME/.codex}/sessions" -name '*.jsonl' -mtime -8 -print0 2>/dev/null | xargs -0 ls -t 2>/dev/null | head -5); do
  grep -h '"rate_limits"' "$f" | jq -r --argjson now "$(date +%s)" '. as $line | .payload.rate_limits | objects | (.primary, .secondary)
    | select(.window_minutes? == 10080)
    | [if .resets_at < $now then 0 else .used_percent end, .resets_at,
       ($line.timestamp? // "" | sub("\\.[0-9]+"; "") | fromdateiso8601? // "")] | @tsv' 2>/dev/null | tail -1 | grep . && exit
done
