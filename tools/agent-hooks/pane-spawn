#!/usr/bin/env bash
# Opens a pane for another agent, in one command (Claude and Codex both use it). A lead's tab holds only the lead (요유 2026-11-05): its
# panes open on the hidden `workers` herdr server, in that server's `workers` workspace, and it prints `workers/<pane id>`. There one
# tab holds one lead's panes, named for the lead, so `herdr session attach workers` shows whose pane is whose and the steps of one
# job stay together. Once it is full, or with --new-tab, the lead gets another tab there. --same-tab is the old name of the default.
# It marks the calling pane 👑 unless it is already 🫡, opens the split or tab, names the pane 🫡, starts the agent, waits for its session and
# hands over the instruction. The agent's herdr name is what lets the pane close itself when its work ends (pane-label).
# Agents cannot run `herdr agent start` or `herdr pane split` themselves: the hook no-sed-inplace.py sends them here.
#   pane-spawn [--new-tab] [--kind claude|codex|auto] [--cwd <dir>] "<work name>" "<instruction>" [-- <agent arguments>]
#   pane-spawn "api#1 설계" "지시" -- --model opus --effort high
# Three callers stay where they are and open beside themselves: a pane under a lead (🫡), a job tab (`pane-tell` refuses a job pane,
# so a hidden child could reach nobody), and a pane on any server but default. So does a lead when workers cannot take the pane
# (no such server on 집맥, down or stuck): it says so on stderr and exits 0. Beside the caller the tallest pane of the rightmost column
# takes the new one, which keeps heights close; too short to read, or --new-tab, and the work gets its own tab, named for it, in the
# caller's current workspace: HERDR_PANE_ID and HERDR_WORKSPACE_ID go stale when a pane moves, so both
# come from `herdr pane get`. The agent's name records the caller's terminal id, which a move does not change; the pane
# reports to that caller first (auto-tab-close.py), and workers-watch.py sends it the alerts about that pane.
# The main pane (its terminal id is in ${XDG_STATE_HOME:-$HOME/.local/state}/orchestrator/main) does no work itself: each of its
# panes gets its own workers tab, named for the work. It never adds a pane to its own tab (--same-tab is bad usage there), and with
# `workers` unable to take the pane it opens nothing and fails.
# --check opens a check pane: a fresh pane, not the one that did the job, runs the test or command, or looks at the changed behavior
# or data, and changes nothing (요유 2026-11-05, api#1002). The agent name carries `chk`, which a rename does not change, so its
# report asks for no other check (auto-tab-close.py). Only a pane herdr_peers.delegates_checks says yes to may open one (the main
# pane today); any other lead checks results itself, so there it is bad usage and opens nothing. A check pane is Codex in its
# sandbox, which writes only in a fixed empty folder and temp and has no network: it reads GitHub through gh-read, Slack
# through the Slack MCP's read tools, and processes with ps. With --kind claude it is Claude Sonnet, which may write anywhere.
# --kind auto uses Codex regardless of recorded weekly usage (요유 2026-11-07, api#1051: reset coupons are available).
# The herdr startup/readiness responses used here provide no verified current quota-block signal.
# Historical percentages and dialog text cannot prove one.
# Until such a signal exists, auto never falls back to Claude. Startup and delivery failures retain their normal error paths.
# A lead opens a pane for code, tests or docs with it (요유 2026-11-05). The main pane posts to Slack; its work panes only report results.
# The main pane opens a Claude pane that does the job only with --why, the reason Codex cannot do it (api#1036): a Codex work pane
# writes nothing outside its folder, so gcloud cannot refresh its login there and GCP commands fail (2026-11-05). A missing
# reason or any reason mentioning Slack (case-insensitive) or 슬랙 is refused and sent to --kind auto. --why gcp and other
# reasons still pass. Check panes and every other caller skip this check.
# Claude work panes opened by a delegates_checks caller default to Sonnet 5.5 at high effort. --opus leaves model and effort
# to the global defaults. Explicit agent arguments still win; checks, jobs and every other caller keep their existing policy.
# --opener <terminal> needs no calling pane: workers-move runs it on 집맥 over ssh to carry on a 회사맥 pane's work at 퇴근 (api#1049).
# The pane opens on this Mac's workers server in a tab of its own, as the main pane's do, and its agent name records that
# terminal (the 회사맥 main pane) with `r` before the random part (herdr_peers.remote_pane). With workers down it opens nothing.
# Prints the new pane id. Exit 1: the agent did not start (the empty pane is removed). Exit 2: bad usage.
H=${HERDR_BIN_PATH:-herdr}
USAGE='usage: pane-spawn [--new-tab] [--check] [--opus] [--artifact] [--kind claude|codex|auto] [--why <reason>] [--cwd <dir>] "<work name>" "<instruction>" [-- <agent arguments>]
  --kind auto: Codex regardless of weekly usage. This launcher has no verified quota-block signal, so no automatic Claude fallback.
    Use it for code, tests and docs; work panes report results. Yoyoo can reset exhausted quota with a coupon.
  --why: in the main pane, why a pane that does the job must be Claude: gcp (it runs gcloud or other GCP commands) or another
    reason in one line. A Claude pane without one, or with a reason mentioning Slack (any case) or 슬랙, is refused there.
    Slack 글은 메인 칸이 올립니다: 밑 칸은 결과를 보고하고 --kind auto로 여세요
  --check: a check pane (main pane only): Codex, read-only, regardless of weekly usage; --kind claude for a check that must write.
  --artifact: keep the Artifact tool in a Claude pane (a job that publishes a page); every Claude pane starts without it otherwise.
  --opus: opt out of the main pane Claude work trial (Sonnet 5.5/high); use global model/effort defaults for heavy work.
    Checks, Codex, dispatch, ambient and other callers keep their existing model policy. Explicit agent arguments win.'
MIN_ROWS=${PANE_SPAWN_MIN_ROWS:-16} # a 46-row window holds 4 panes of 11-12 rows, which still show about 5 lines of work (2026-11-04); a fifth would leave 5-6
die() { echo "pane-spawn: $*" >&2; exit 2; }
# Every reader takes a tab named "자동 …" or "알아서 …" for a job's: pane-tell refuses its panes, and no mark goes on it. A work name that
# starts that way made an ordinary pane unreachable (요유 2026-11-05), so no tab it names starts that way.
tab_name() { case "$1" in "자동 "* | "알아서 "*) echo "일 $1" ;; *) echo "$1" ;; esac; }

same= new_tab= check= opus= artifact= kind= why= opener= cwd=$PWD state=${XDG_STATE_HOME:-$HOME/.local/state}
while [ $# -gt 0 ]; do
  case "$1" in
    --same-tab) same=1; shift ;;
    --new-tab) new_tab=1; shift ;;
    --check) check=1; shift ;;
    --opus) opus=1; shift ;;
    --artifact) artifact=1; shift ;;
    -h | --help) echo "$USAGE"; exit 0 ;;
    --kind | --cwd | --why | --opener)
      [ $# -ge 2 ] || die "$USAGE"
      case "$1" in --kind) kind=$2 ;; --cwd) cwd=$2 ;; --why) why=$2 ;; --opener) opener=${2#term_}; [[ "$opener" =~ ^[0-9A-Za-z]+$ ]] || die "$USAGE" ;; esac
      shift 2 ;;
    --*) die "$USAGE" ;;
    *) break ;;
  esac
done
[ $# -ge 2 ] && [ -n "$1" ] && [ -n "$2" ] || die "$USAGE"
[ -z "$opener" ] || [ -z "$check$same$new_tab" ] || die "--opener opens a moved pane's own tab: no --check, --same-tab or --new-tab"
asked=${kind:-claude} # what the caller chose, before auto resolves to Codex
# A check pane runs Codex regardless of weekly usage. A check that must write to
# GitHub, Slack or the board, or to the repo it checks, passes --kind claude: the Codex pane below cannot.
[ -z "$check" ] || [ -n "$kind" ] || kind=auto
[ "$kind" != auto ] || kind=codex
kind=${kind:-claude}
name=$1 prompt=$2
# 요유 talks only to the lead (2026-11-01), so a new pane hears it here and not from each lead's memory.
prompt+=$'\n\n이 칸은 리드 밑 칸입니다. 요유는 이 칸을 보지 않으니 요유에게 직접 묻거나 `prod 허용`, `staging 허용`, `/clear`를 부탁하지 마세요. 질문, 결정 요청, 보고는 답을 `남은 것:` 줄로 끝내면 이 칸을 연 리드에게 갑니다. 보고는 리드가 읽으니 요유에게 쓰는 형식(설명 페이지, `무엇을:`/`왜:`, `원인:`/`조치:`/`재발 방지:`)은 쓰지 말고, 리드가 확인할 결과와 근거를 편하게 적으세요.'
shift 2
[ "${1:-}" != -- ] || shift
env_args=()
case "$kind" in
  # Every Claude pane opened here works under a lead, so the advisor tool (a full uncached resend of the conversation per call)
  # is off: the pane's shell carries the variable, and the agent and its subagents inherit it. Sessions opened by hand keep it.
  claude) ready='.result.agent.agent_session.value' env_args=(--env CLAUDE_CODE_DISABLE_ADVISOR_TOOL=1 --env CLAUDE_STARTUP_ROLE=worker)
    # The Artifact tool's schema (~9k tokens) is resent on every call, so the worker profile turns it off (api#1065);
    # a job that publishes a page, such as a client hand-off, opens with --artifact. Codex panes have no such tool.
    [ -z "$artifact" ] || env_args+=(--env CLAUDE_STARTUP_ARTIFACT=1) ;;
  # Codex reports no session id before its first prompt. It runs commands with mise's shims first on PATH, so a test that swaps HOME
  # hid mise's config and installs: python3 re-ran its own shim for ever, or failed on mise's trust check (2026-11-05). mise's
  # folders by absolute path keep what it reads the same under any HOME. Codex hands a command only the variables its config lists
  # in shell_environment_policy.include_only, so these four names are listed there too (exact names: a glob would pass tokens).
  # Once Codex sees a release newer than it runs, its TUI opens on an update prompt nobody here answers, and mise installs a
  # release only a day after it comes out: every Codex pane failed to start that day (2026-11-06, 0.167.0).
  codex) ready='.result.agent.interactive_ready'
    set -- -c check_for_update_on_startup=false "$@"
    env_args=(--env "MISE_CONFIG_DIR=${MISE_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/mise}"
      --env "MISE_DATA_DIR=${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}"
      --env "MISE_STATE_DIR=${MISE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/mise}"
      --env "MISE_CACHE_DIR=${MISE_CACHE_DIR:-$HOME/Library/Caches/mise}") ;;
  *) die "$USAGE" ;;
esac
# On 2026-11-05 a script in one pane looped through a mise shim and spawned processes until the user hit macOS's per-user limit
# (kern.maxprocperuid, 8000): every pane and launchd job then failed to fork, and only a reboot ended it. macOS compares a
# process's RLIMIT_NPROC soft limit with all processes of its user, not with its own descendants (checked that day: a fresh shell
# with its limit 50 below the user's count could not fork once). So zshrc lowers the soft limit of the shell this pane starts,
# which the agent it types in, Claude or Codex, and all it runs inherit. The user usually has about 750-800 processes, so a
# runaway in a pane stops at 5000 while sessions opened by hand and launchd jobs keep 3000 to stop it with. The cap counts the
# whole user, so near 5000 every pane opened here stops forking, not only the runaway one. Panes already open keep 8000.
env_args+=(--env PANE_SPAWN_NPROC=5000)
[ -n "$opener" ] || [ -n "${HERDR_PANE_ID:-}" ] || die "run this inside a herdr pane"
command -v jq >/dev/null 2>&1 || die "jq not found"

if [ -n "$opener" ]; then
  me= ws= term=$opener label=
else
  IFS=$'\t' read -r me ws term label < <("$H" pane get "$HERDR_PANE_ID" | jq -r '.result.pane | [.pane_id, .workspace_id, (.terminal_id | ltrimstr("term_")), (.label // "")] | @tsv')
  [ -n "${term:-}" ] || die "herdr does not know this pane"
fi
export HERDR_PANE_ID=$me
delegates=
if [ -z "$opener" ] && python3 -I "$(dirname "$(readlink -f "$0")")/herdr_peers.py" --delegates-checks "term_$term"; then delegates=1; fi
if [ -n "$check" ]; then
  [ -n "$delegates" ] || die "--check is for the main pane; any other lead checks a pane's result itself (직접 확인: run the test or command, or look at the changed behavior or data)"
  name="확인 $name"
  prompt+=' 이 칸은 확인 칸입니다. 다른 칸이 다 했다고 보고한 일을 확인만 합니다. 코드나 설정을 고치지 말고, 테스트나 명령을 직접 실행하거나 바뀐 동작과 데이터를 직접 보세요. 다른 칸의 보고를 다시 읽는 것은 확인이 아닙니다. 다른 칸을 열지 마세요. 보고 첫 줄에 실행한 명령, 본 결과, 통과 여부를 모두 쓰세요.'
  if [ "$kind" != claude ]; then
    # A check runs tests and reads GitHub but leaves the repo as it was, and the sandbox enforces that, not the instruction: Codex
    # starts in a fixed empty folder, which with temp is all its workspace-write sandbox lets it write, and reads the repo by
    # absolute path. Nobody answers its approval prompts, so a blocked write fails at once. That folder is no repo, so Codex asks
    # nothing on the way in: in a repo it does not trust yet it asks after it reports ready, and the instruction typed then
    # answers yes and is lost (2026-11-05, ~/.dotfiles).
    # The sandbox has no network: with it, a command that can read Slack or GitHub can post or merge as well, and only the
    # instruction stopped that. Reads leave through tools outside the sandbox that do no writes (요유 2026-11-05):
    # - Codex rules in the folder's .codex, which the sandbox cannot write, let gh-read, ps and pgrep run outside it, each
    #   only by its real path: Codex resolves an absolute path by its last part, so without host_executable a gh-read or ps
    #   the agent wrote in temp would run outside too. ego-browser, which the user's own rules let out, drives a browser that
    #   may be signed in to Slack, so here it is forbidden (the strictest rule wins). The folder is trusted, or Codex would
    #   skip its rules. A rule is a prefix of one plain command, so `ps | grep` and `cd x && gh-read` run in the sandbox.
    # - MCP servers and plugins run outside the sandbox too. Every server the user's config names is off but two that keep
    #   only their read tools, and Codex's connectors (apps) and plugins are off.
    # ponytail: a check that needs the network for anything else (bq, curl, a package download) fails here; such a check
    # opens with --kind claude. An allow rule added later to ~/.codex/rules applies here too.
    target=$cwd cwd=$state/pane-spawn/check here=$(dirname "$(readlink -f "$0")")
    mkdir -p "$cwd/.codex/rules" || die "cannot make $cwd"
    rules=$(mktemp "$cwd/.codex/rules/.check.XXXXXX") && cat > "$rules" <<EOF && mv -f "$rules" "$cwd/.codex/rules/check.rules" || die "cannot write $cwd/.codex/rules/check.rules"
# Written by pane-spawn for its Codex check panes at each start; a change here is lost.
prefix_rule(pattern=["$here/gh-read"], decision="allow")
host_executable(name="ps", paths=["/bin/ps"])
prefix_rule(pattern=["ps"], decision="allow")
host_executable(name="pgrep", paths=["/usr/bin/pgrep"])
prefix_rule(pattern=["pgrep"], decision="allow")
prefix_rule(pattern=["ego-browser"], decision="forbidden")
EOF
    mcp=$(python3 -I - "${CODEX_HOME:-$HOME/.codex}/config.toml" <<'EOF'
import json, os, re, sys, tomllib
read_tools = {"slack": ["slack_list_channels", "slack_get_channel_history", "slack_get_thread_replies", "slack_get_users", "slack_get_user_profile"],
              "munice": ["ask_code", "ask_data"]}
servers = tomllib.load(open(sys.argv[1], "rb")).get("mcp_servers", {}) if os.path.exists(sys.argv[1]) else {}
for name in servers:
    # Codex splits a -c path at every dot and keeps quotes as part of the name, so `mcp_servers."x"` is a new, broken server.
    if not re.fullmatch(r"[A-Za-z0-9_-]+", name):
        sys.exit(f"pane-spawn: -c cannot name the MCP server {name!r}")
    keep = read_tools.get(name)
    if not keep:
        print("-c", f"mcp_servers.{name}.enabled=false", sep="\n")
        continue
    # Codex asks before a tool its server does not mark read-only, and under --ask-for-approval never that is a refusal:
    # the Slack reads failed so (2026-11-05). Only read tools are left, so they run without asking.
    print("-c", f"mcp_servers.{name}.enabled_tools={json.dumps(keep)}", "-c", f'mcp_servers.{name}.default_tools_approval_mode="approve"', sep="\n")
EOF
    ) || die "cannot turn off every MCP server in Codex's config, so a Codex check pane could write through one; open it with --kind claude"
    off=(); while IFS= read -r l; do [ -z "$l" ] || off+=("$l"); done <<<"$mcp"
    # Codex's TUI serves MCP tools of its own outside the sandbox (create_worktree runs git in a trusted repo), unless a configured
    # server holds their name: codex_worktrees, or codex_tui with a daemon. Then it starts without them. No feature turns them
    # off, and a server with no command stops Codex from starting (Codex 0.166, 2026-11-05).
    for n in codex_worktrees codex_tui; do off+=(-c "mcp_servers.$n={command=\"/usr/bin/false\",enabled=false}"); done
    # The folder's path has dots (~/.local), which a dotted -c path would split, so its trust goes in as a table.
    set -- --sandbox workspace-write --ask-for-approval never -c sandbox_workspace_write.network_access=false \
      -c "projects={\"$cwd\"={trust_level=\"trusted\"}}" "${off[@]}" --disable apps --disable plugins "$@"
    prompt+=" 확인할 폴더는 $target 입니다. $target/AGENTS.md 가 있으면 먼저 읽으세요. 이 칸은 Codex 샌드박스 안에서 빈 작업 폴더 $cwd 를 쓰므로, 확인할 폴더는 절대경로로 읽으세요. 파일은 작업 폴더와 임시 폴더에만 쓸 수 있고, 확인할 폴더를 비롯한 다른 곳은 쓰기가 막힙니다. 네트워크도 막혀 있어 curl, gh, bq 는 실패합니다. 읽기는 이렇게 합니다. GitHub는 $here/gh-read 뒤에 gh 명령을 붙여 읽고(issue·pr·run·release view/list, pr diff/checks, search, GET api), 저장소는 -R owner/repo 로 정하세요. Slack은 slack MCP 의 읽기 도구(slack_get_thread_replies, slack_get_channel_history, slack_get_user_profile)로 읽습니다. 프로세스는 ps 나 pgrep 으로 봅니다. 이 명령들은 파이프, 리다이렉트, cd 없이 명령 하나로 실행해야 샌드박스 밖에서 돌고, 걸러 낼 때는 gh 의 --jq 나 ps 의 옵션을 쓰세요. 글쓰기, 댓글, 머지 같은 쓰기는 모두 막힙니다. 막혀서 확인하지 못한 항목은 통과로 쓰지 말고, 무엇이 막혀 못 했는지 쓰세요."
  fi
fi
main= hidden= sock= addr=
mainfile=$state/orchestrator/main
workers_help="start it with: launchctl kickstart gui/$(id -u)/com.yoyoo.herdr-workers"
if [ -z "$opener" ] && [ "term_$term" = "$(cat "$mainfile" 2>/dev/null)" ]; then
  [ -z "$same" ] || die "the main pane does no work, so it never adds a pane to its own tab"
  if [ -z "$check" ] && [ "$asked" = claude ]; then
    [[ "$why" == *[![:space:]]* ]] || die "the main pane opens a Claude pane only with --why, the reason Codex cannot do the job: --why gcp (it runs gcloud or other GCP commands; a Codex work pane cannot write gcloud's login files) or --why \"<one line>\". Any other pane: --kind auto (Codex regardless of weekly usage)."
    case "$why" in
      *[sS][lL][aA][cC][kK]* | *슬랙*) die "Slack 글은 메인 칸이 올립니다: 밑 칸은 결과를 보고하고 --kind auto로 여세요" ;;
    esac
  fi
  main=1 hidden=1
  prompt+=' 보고 첫 줄에 이 칸에서 한 일을 한 문장으로 쓰세요. 메인 칸에는 그 줄과 `남은 것:` 줄만 가고 전문은 파일로 남습니다.'
elif [ -n "$opener" ]; then # the 회사맥 main pane's pane, its report carried there by workers-move bridge
  hidden=1
  prompt+=' 보고 첫 줄에 이 칸에서 한 일을 한 문장으로 쓰세요. 메인 칸에는 그 줄과 `남은 것:` 줄만 가고 전문은 파일로 남습니다.'
elif [[ "${label:-}" != *🫡* ]] && [ -z "${MUNICE_AUTO_DISPATCH:-}${MUNICE_AMBIENT:-}" ]; then
  case "${HERDR_SOCKET_PATH:-}" in */sessions/*) ;; *) hidden=1 ;; esac
fi
# Work trial and Claude checks share the existing Sonnet/high defaults; arguments after -- take precedence.
# --opus opts out only work panes. It does not alter the established check-pane policy.
trial=
if [ -n "$delegates" ] && [ "$kind" = claude ] && [ -z "$check${MUNICE_AUTO_DISPATCH:-}${MUNICE_AMBIENT:-}" ]; then trial=1; fi
if [ "$kind" = claude ] && { [ -n "$check" ] || { [ -n "$trial" ] && [ -z "$opus" ]; }; }; then
  case " $* " in *" --effort "* | *" --effort="*) ;; *) set -- --effort high "$@" ;; esac
  case " $* " in *" --model "* | *" --model="*) ;; *) set -- --model claude-sonnet-5-5 "$@" ;; esac
fi
if [ -n "$trial" ]; then
  if [ -n "$opus" ]; then
    echo "pane-spawn: Claude 전역 기본 모델·강도 사용 (--opus; 명시한 모델·강도 인자 우선)" >&2
  else
    echo "pane-spawn: Claude Sonnet 5.5·high 기본값 (Sonnet 시험 중, 무거운 일은 --opus; 명시한 모델·강도 인자 우선)" >&2
  fi
fi
[ -z "$hidden" ] || sock=$("$H" session list --json 2>/dev/null | jq -r '.sessions[] | select(.name == "workers" and .running) | .socket_path' 2>/dev/null | head -1)
[ -z "$main$opener" ] || [ -n "$sock" ] || { echo "pane-spawn: the workers herdr server is not running; $workers_help" >&2; exit 1; }
# A job has one lead: a pane under one stays under it, and what it opens reports to it (요유 2026-11-01). Only 요유 promotes it.
[[ "${label:-}" == *🫡* ]] || [ -n "$opener" ] || pane-label --lead
# What a Home lead's pane says may reach the main pane once that lead closes, and stays off company Slack and the board (요유
# 2026-11-05). The agent name carries that: h before the random part, read by herdr_peers.home_pane. A pane under such a lead sits
# in the workers workspace, so it passes the mark on from its own name.
home=
if [ -z "$main$opener" ]; then
  [ "$("$H" workspace list 2>/dev/null | jq -r --arg w "$ws" '.result.workspaces[]? | select(.workspace_id == $w) | .label' 2>/dev/null)" != Home ] || home=h
  case "$("$H" agent get "$me" 2>/dev/null | jq -r '.result.agent.name // empty' 2>/dev/null)" in spawn-*-h[0-9]*) home=h ;; esac
fi

call=("$H")
open_pane() { # <a pane whose tab takes the new one, or empty> <workspace> <name of a new tab>: prints the new pane's id, or nothing
  local target direction pane=
  if [ -z "$new_tab" ] && [ -n "$1" ]; then
    # ponytail: only the rightmost column is looked at, so a hand-made layout just grows on its right edge.
    read -r target direction < <("${call[@]}" pane layout --pane "$1" 2>/dev/null | jq -r --argjson min "$MIN_ROWS" '
      .result.layout.panes as $all
      | if ($all | length) == 1 then "\($all[0].pane_id) right"
        else ($all | map(.rect.x) | max) as $x | ($all | map(select(.rect.x == $x)) | max_by([.rect.height, .rect.y])) as $t
          | if $t.rect.height < $min then empty else "\($t.pane_id) down" end
        end' 2>/dev/null)
    [ -z "$target" ] || pane=$("${call[@]}" pane split --pane "$target" --direction "$direction" --cwd "$cwd" --no-focus "${env_args[@]}" | jq -r '.result.pane.pane_id // empty')
  fi
  [ -n "$pane" ] || pane=$("${call[@]}" tab create --workspace "$2" --cwd "$cwd" --label "$(tab_name "$3")" --no-focus "${env_args[@]}" | jq -r '.result.root_pane.pane_id // empty')
  echo "$pane"
}
owner=${label#🔴}; owner=${owner#🟢}; owner=${owner# }; owner=${owner#👑}; owner=${owner#🫡}; owner=${owner# }; owner=${owner:-$name}
case "$owner" in "새 세션 "*) owner=$name ;; esac # what a new session is called until its first task: no name (pane-label-nudge.sh)
pane=
if [ -n "$sock" ]; then
  pane=$( # a subshell, so a workers server that opens nothing leaves its socket nowhere for the fallback below
    export HERDR_SOCKET_PATH=$sock
    call=(perl -e 'alarm shift; exec @ARGV' "${PANE_SPAWN_WORKERS_LIMIT:-10}" "$H") # herdr's CLI waits on a stuck server for ever
    spaces=$("${call[@]}" workspace list) || exit 0 # no answer is not no workspace: creating one on a slow server would make a second
    w=$(jq -r '[.result.workspaces[] | select(.label == "workers")][0].workspace_id // empty' <<<"$spaces")
    [ -n "$w" ] || w=$("${call[@]}" workspace create --label workers --no-focus --cwd "$HOME" | jq -r '.result.workspace.workspace_id // empty')
    [ -n "$w" ] || exit 0
    if [ -n "$main$opener" ]; then open_pane "" "$w" "$name"; exit 0; fi
    # ponytail: a pane may join the tab a --new-tab pane opened. Nobody looks here, and the tab still names the right lead.
    near=$("${call[@]}" agent list 2>/dev/null | jq -r --arg p "spawn-$term-" '[.result.agents[]? | select((.name // "") | startswith($p)) | .pane_id] | last // empty' 2>/dev/null)
    open_pane "$near" "$w" "$owner"
  )
fi
if [ -n "$pane" ]; then # every call from here on is about the new pane, so all of them go to workers
  export HERDR_SOCKET_PATH=$sock
  addr=workers/
  [ -n "$main$opener" ] || "$H" tab rename "$("$H" pane get "$pane" 2>/dev/null | jq -r '.result.pane.tab_id // empty' 2>/dev/null)" "$(tab_name "$owner")" >/dev/null 2>&1 # the lead may have moved on since the tab got its name
elif [ -n "$main$opener" ]; then
  echo "pane-spawn: the workers herdr server opened no pane; $workers_help" >&2; exit 1
else
  [ -z "$hidden" ] || echo "pane-spawn: workers 서버에 열지 못해 이 탭에 엽니다. 회사맥이면 켜 주세요: ${workers_help#start it with: }" >&2
  pane=$(open_pane "$me" "$ws" "$name")
fi
[ -n "$pane" ] || die "herdr opened no pane"
"$H" pane rename "$pane" "🟢 🫡 $name" >/dev/null
pane-label --sync-tabs

give_up() { "$H" pane close "$pane" >/dev/null 2>&1; echo "pane-spawn: $1" >&2; exit 1; }
agent="spawn-$term-${check:+chk}${opener:+r}$home$RANDOM" # herdr allows 32 characters; terminal ids run about 15
for try in 1 2 3; do # a pane opened a moment ago may not be at its shell prompt yet
  out=$("$H" agent start "$agent" --kind "$kind" --pane "$pane" --timeout 120000 ${1+--} "$@" 2>&1) && break
  # An agent held by a dialog keeps its name, so a retry would only fail on that name and hide this. The message quotes the
  # dialog: a guess at which one it was (a trust question) sent the 2026-11-06 hunt the wrong way, and it was the update prompt.
  case "$out" in *"blocked during startup"*)
    screen=$("$H" agent read "$pane" --source visible 2>/dev/null | tr -s ' \n' '  ')
    give_up "$kind waits at a dialog as it starts, which nobody here answers. It shows: ${screen:0:400}. If it asks whether to trust $cwd, start $kind there by hand once and answer it; else open the pane with --kind claude. herdr: $out" ;;
  esac
  [ "$try" != 3 ] || give_up "$kind did not start: $out"
  sleep "${PANE_SPAWN_RETRY_WAIT:-3}"
done
for _ in $(seq 1 60); do # `agent start` can return while a wrapper still runs in the pane (dispatch/run.sh)
  "$H" agent get "$pane" 2>/dev/null | jq -e "$ready" >/dev/null && break
  [ "$_" != 60 ] || give_up "$kind never became ready"
  sleep "${PANE_SPAWN_POLL:-2}"
done
# Codex can report ready before its input box takes text, and `agent prompt` still succeeds: on 2026-11-01 an instruction
# vanished and the pane sat idle while its lead waited. So delivery counts only once the agent shows work. A miss is reported,
# not resent or closed: the wait can also fail with the instruction accepted, and a resend would run the job twice.
"$H" agent prompt "$pane" "$prompt" >/dev/null || give_up "the instruction was not delivered"
if ! "$H" agent wait "$pane" --until working --until blocked --until done --timeout "${PANE_SPAWN_START_WAIT:-30000}" >/dev/null 2>&1; then
  echo "$addr$pane"
  echo "pane-spawn: $addr$pane shows no work; if its input box is empty, send the instruction again with pane-tell" >&2
  exit 1
fi
echo "$addr$pane"
