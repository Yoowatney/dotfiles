    m = read(path)
    if m["terminal"] != terminal or m["server"] != server or m["socket"] != socket:
        sys.exit(1)
    if token and token != "recovery" and m["generation"] != token: sys.exit(1)
    if token == "recovery" and path.parent.name == "open" and m["due"] > time.time(): sys.exit(1)
