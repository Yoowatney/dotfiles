                      + " signal=" + (signal.Signals(-status).name if status < 0 else "none")
                      + " sender=unknown observed_by=" + str(os.getpid())
                      + " parent=" + str(supervisor))
                try:
                    os.write(writer, str(status).encode())
                except BrokenPipeError:
                    pass # The owner may exit after the waitpid poll.
                os.close(writer)
                result = wait_owner(owner)
                owner_status = os.waitstatus_to_exitcode(result)
                owner_exit(owner, owner_status)
                if status != 0 or owner_status != exitcode(status):
                    stop_delivery(child)
                else:
                    child.wait()
                sys.exit(exitcode(status) if owner_status == exitcode(status) else exitcode(owner_status) or 1)
            time.sleep(.01)
' "$1" "$2" "$0" "$STATE" "${3:-}" "${4:-}" "${5:-}" "${6:-}"
}
