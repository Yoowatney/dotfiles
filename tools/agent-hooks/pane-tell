                      + " waiting=" + str(os.path.isfile(payload)) + " observed_by=" + str(os.getpid())
                      + " pid=" + str(child.pid) + " parent=" + str(supervisor)
                      + " signal=" + (signal.Signals(-delivery_status).name if delivery_status < 0 else "none"))
                os.close(writer)
                sys.exit(exitcode(status) or 1)
            status = delivery_status(child.pid)
            if status is not None:
                # Observe without reaping: retain PID/group identity through
                # owner acknowledgement and any required descendant cleanup.
