    if [ "$terminal" = "$(cat "${XDG_STATE_HOME:-$HOME/.local/state}/orchestrator/main" 2>/dev/null)" ]; then batch_target=1; fi
    case "$name" in "👑 "* | "🫡 "*) batch_target=1 ;; esac
