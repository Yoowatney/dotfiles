    if (not isinstance(m, dict) or m.get("version") != 1 or m.get("terminal") != d.name or
        m.get("server") not in ("default", "workers") or
        not isinstance(m.get("socket"), str) or
        not isinstance(m.get("generation"), str) or not m["generation"].isalnum() or
        not isinstance(m.get("due"), int)):
        raise ValueError("invalid batch metadata")
