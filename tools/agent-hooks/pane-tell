    line = time.strftime("%F %T") + " " + kind + " " + os.path.basename(payload) + " " + fields
    line += " observed_epoch=" + str(time.time()) + " launch_parent=" + str(launch_parent)
    line += "".join(" source_" + key + "=" + json.dumps(value, ensure_ascii=True)
                    for key, value in context.items())
