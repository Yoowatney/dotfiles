           for key in ("pane", "server", "session", "parent")}
try:
    fd = os.open(state + "/delivery-origins/" + os.path.basename(payload), os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd) as stream:
        info = os.fstat(stream.fileno())
        if stat.S_ISREG(info.st_mode) and info.st_uid == os.getuid():
            saved = json.loads(stream.read(4096))
            context = {key: str(saved.get(key, "unknown")) for key in context}
