#!/bin/bash
# Types a message into the agent of another herdr pane, so 요유 never carries words between sessions
# (요유 2026-10: "메시지가 아니라 세션한테 전달하라고"). Claude and Codex both use it.
#   pane-tell --list                          one line per pane: id, name, cwd; pick the target from these. Panes on the other
#                                               server (default or workers) follow as <session>/<pane id>, when it runs
#   pane-tell <pane id|name text> "<message>"  name text: any piece of the pane name, case-insensitive ("KPI 표"), on this
#                                               server, else on the other one. A bare pane id is only ever this server's
#   pane-tell <session>/<pane id> "<message>"  a pane on the default or workers herdr server (workers/w1:p2); the same pane
#                                               id exists on both, so the sender is named and refused from its own server
# Exit 3: no pane matches, or the named server is not running. Exit 2: bad usage, a session other than default or workers,
# more than one match (listed on stderr), this pane itself, or an
# auto-dispatch or Slack ambient session: a prompt typed there counts as 요유 speaking and lifts the board's
# dispatch/guard.sh (for good in a dispatch session, for that round in an ambient one).
# The message arrives marked as coming from another session, since the receiver would otherwise read it as 요유's.
# A prompt typed into a box that holds 요유's half-typed words is sent along with them, cut short (요유 2026-10-31: "야 리드야",
# "z"). So it goes only into an empty box, working agent or not: Claude queues it, Codex takes it into the running turn.
# Otherwise it prints "queued ...", exits 0, and a detached process tries again until the box is empty, which outlives the
# sending pane and runs on the receiver's server. After PANE_TELL_WAIT seconds, or when the receiver is gone or holds another
# session, the message stays in ~/.local/state/pane-tell/undelivered/; `log` beside it says what became of each one. A
# message that waits PANE_TELL_ALERT seconds (10 minutes) or ends up in that folder is announced, since a one-letter leftover
# in a box once held a report back with nobody knowing (10/31): a durable terminal error alert for 요유, the only one who can
# resolve a blocked editor, and a note to the sender on its own server, who would take it as delivered, unless the sender is an auto
# session, for the reason above. A box on the workers server also queues an error alert; its note goes to the sender, or to
# the main pane when a job sent it. Only an unattended workers Codex box containing a lone `!` in Shell mode is cleared;
# the registered main's stable visible draft is archived before clearing and the archive path prefixes its relay.
# Every other nonempty box waits. Dialogs, scrolled screens and drafts that cannot be preserved wait as well.
#   pane-tell --raw <pane id> "<message>"       the same door for a prompt a machine types as it is, into any pane; one that
#                                               has to wait stays for that session, except the registered main survives /clear
#   pane-tell --box-ready <pane id> <kind>      exit 0 when the box is empty and in view (ambient/deliver.py asks this)
#   pane-tell --can-send <pane id> <kind>       read-only: empty, or a main draft that can be archived safely
# Batching (api#1051): a marked message for the main pane (the terminal in orchestrator/main), a lead (👑), or a worker (🫡)
# while it rests opens a batch, and
# all that comes for it in the next PANE_TELL_BATCH seconds (120; 0, or a file batch-off in the state folder, turns batching
# off) goes as one prompt, each message with
# its own mark, a blank line between: it prints "queued for … held …" and exits 0. The main pane read about 210k tokens a turn,
# and in the 3 days to 11/07, 32% of the turns a relay started while it rested had another relay within 2 minutes of the
# first (25% at 90 s, 44% at 180 s). The prompt still opens with a mark, and fix-round-guard, trial-count and
# yoyoo-share-guard read each message of it (split at "\n\n[pane-tell: '"). A working main pane takes a message at once: Claude
# folds it into the running turn. So does a message that may not wait or must arrive alone, after what was held: 요유's
# `prod 허용`/`staging 허용` (gcp-account-guard grants on one whole relay, for the turn it starts), 장애/보안/긴급 in its first
# 300 characters, and main-refresh's request, which checks that it is the last prompt. A batch is not tied to the session, so a
# /clear meanwhile hands it to the next one.
H=${HERDR_BIN_PATH:-herdr}
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/pane-tell
# Preserve the launching context before switching to the receiver server.
export PANE_TELL_SOURCE_PANE=${PANE_TELL_SOURCE_PANE:-${HERDR_PANE_ID:-unknown}}
export PANE_TELL_SOURCE_SERVER=${PANE_TELL_SOURCE_SERVER:-${HERDR_SESSION:-default}}
export PANE_TELL_SOURCE_SESSION=${PANE_TELL_SOURCE_SESSION:-unknown}
export PANE_TELL_SOURCE_PARENT=${PANE_TELL_SOURCE_PARENT:-$PPID}
unset ORDERED_TERMINAL
DRAFT_HELPER=$(python3 -I -c 'import os,sys; print(os.path.join(os.path.dirname(os.path.realpath(sys.argv[1])), "main-input-draft.py"))' "$0")
PEERS="default workers"
die() { echo "pane-tell: $*" >&2; exit 2; }

# Exit 0 when the ansi screen on stdin shows the agent's input box empty. Any screen it cannot place is "not empty". Dim text
# on the prompt line is a placeholder, never typed words; on the lines below it counts.
# ponytail: reads the TUI's drawing, so a redesign of either box stops delivery (messages wait, nothing merges); a key typed
# in the moment after the second read, or a Korean syllable still composing in the IME, does not show on the screen.
BOX=${DRAFT_HELPER%/*}/pane-input-box.py
if [ "${1:-}" = --box-empty ]; then python3 -I "$BOX" "$2"; exit; fi

refresh_dir=${XDG_STATE_HOME:-$HOME/.local/state}/orchestrator
refresh_handoff=${XDG_STATE_HOME:-$HOME/.local/state}/agent-handoff
if [[ "${HERDR_SOCKET_PATH:-}" == */sessions/*/herdr.sock ]]; then
  server=${HERDR_SOCKET_PATH%/herdr.sock}; server=${server##*/}
  refresh_handoff=$refresh_handoff/$server
  # Only the registered default main refreshes through this shared gate.
  [ "$server" = default ] || refresh_dir=$refresh_dir/$server
fi
is_main() { [ -n "$1" ] && [ "$1" = "$(cat "$refresh_dir/main" 2>/dev/null)" ]; }
refresh_request() {
  [ -n "${MAIN_REFRESH_REQUEST_TOKEN:-}" ] || return 1
  python3 -I -c 'import json,sys
try:
    request=json.load(open(sys.argv[1]))
    ok=request["token"] == sys.argv[2] and sys.argv[3].endswith(request["ask"])
except (OSError,ValueError,KeyError): ok=False
sys.exit(0 if ok else 1)' "$refresh_handoff/main-refresh.refresh-request" "$MAIN_REFRESH_REQUEST_TOKEN" "$1"
}
refresh_blocked() { # called under the send lock, before any draft recovery
  [ -f "$refresh_dir/refresh-delivery.json" ] || return 1
  local row terminal
  row=$("$H" pane get "$1" 2>/dev/null) || return 0
  terminal=$(printf '%s\n' "$row" | jq -r '.result.pane.terminal_id // empty')
  [ -n "$terminal" ] || return 0
  is_main "$terminal" || return 1
  refresh_request "$2" && return 1
  # A crashed pre-clear run must not strand traffic. After an accepted clear,
  # retain the hold until herdr reports a different session, even if the owner died.
  python3 -I -c 'import json,os,sys
try:
    gate=json.load(open(sys.argv[1])); pane=json.loads(sys.argv[2])["result"]["pane"]
    try: os.kill(gate["pid"],0); alive=True
    except ProcessLookupError: alive=False
    changed=pane.get("agent_session",{}).get("value","") != gate["session"]
    blocked=alive or (gate.get("clearing",False) and not changed)
except (OSError,ValueError,KeyError): blocked=True
sys.exit(0 if blocked else 1)' "$refresh_dir/refresh-delivery.json" "$row"
}

# In view, and empty on two reads: what is typed between them holds the message back.
box_ready() { # pane kind
  "$H" pane get "$1" 2>/dev/null | jq -e '(.result.pane.scroll.offset_from_bottom // 0) == 0' >/dev/null || return 1
  local i
  for i in 1 2; do
    [ "$i" = 1 ] || sleep "${PANE_TELL_SETTLE:-0.7}"
    "$H" pane read "$1" --source visible --format ansi 2>/dev/null | python3 -I "$BOX" "$2" || return 1
  done
}
recover_shell() { # pane kind: workers only; normal box readiness remains read-only
  [ "$2" = codex ] || return 1
  case "${HERDR_SOCKET_PATH:-}" in */sessions/workers/herdr.sock) ;; *) return 1 ;; esac
  "$H" pane get "$1" 2>/dev/null | jq -e '(.result.pane.scroll.offset_from_bottom // 0) == 0' >/dev/null || return 1
  local i
  for i in 1 2; do
    [ "$i" = 1 ] || sleep "${PANE_TELL_SETTLE:-0.7}"
    "$H" pane read "$1" --source visible --format ansi 2>/dev/null | python3 -I "$BOX" "$2" shell-bang || return 1
  done
  "$H" agent send-keys "$1" esc esc Backspace >/dev/null 2>&1 || return 1
  mkdir -p "$STATE"
  echo "$(date '+%F %T') cleared lone Shell-mode bang on workers/$1" >> "$STATE/log"
  # The TUI may redraw after send-keys returns. A failed check queues delivery for the next poll.
  sleep "${PANE_TELL_SETTLE:-0.7}"
  box_ready "$1" "$2"
}
send_unlocked() {
  local note message=$3
  refresh_blocked "$1" "$message" && return 1
  if ! box_ready "$1" "$2"; then
    python3 -I "$DRAFT_HELPER" prepare "$1" "$2" >/dev/null 2>&1 || recover_shell "$1" "$2" || return 1
  fi
  # Keep the original relay intact for provenance/approval hooks. The notice is
  # a separate marked message; a failed prompt keeps it for the next attempt.
  note=$(python3 -I "$DRAFT_HELPER" notice "$1" 2>/dev/null) || return 1
  [ -z "$note" ] || message=$(printf '[pane-tell: 입력창 초안 보관 안내] %s\n\n%s' "$note" "$message")
  box_ready "$1" "$2" && "$H" agent prompt "$1" "$message" >/dev/null 2>&1 || return 1
  python3 -I "$DRAFT_HELPER" ack "$1" >/dev/null 2>&1 || :
}
send() {
      # Serialize check, draft recovery and prompt on both servers. The OS
      # releases the lock even if a sender dies. Matching ids across servers may
      # briefly serialize unrelated panes, but never allow two concurrent clears.
      (umask 077; python3 -I -c '
import fcntl, os, subprocess, sys
path, script, *args = sys.argv[1:]
os.makedirs(os.path.dirname(path), exist_ok=True)
with open(path, "a") as lock:
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        sys.exit(1)
    sys.exit(subprocess.call(["/bin/bash", script, "--send-locked", *args]))
' "$STATE/sending/$1.lock" "$0" "$@")
}
if [ "${1:-}" = --send-locked ]; then send_unlocked "$2" "$3" "$4"; exit; fi
if [ "${1:-}" = --can-send ]; then
  box_ready "$2" "$3" || python3 -I "$DRAFT_HELPER" check "$2" "$3"
  exit
fi

register_receiver() ( # waiting payload, terminal: metadata contains no message text
  umask 077
  local route
  mkdir -p "$STATE/receivers" "$STATE/delivery-routes" || return
  route=$(mktemp "$STATE/delivery-routes/.new.XXXXXX") || return
  printf '%s\n%s\n%s\n' "${3:-}" "${4:-}" "${5:-}" > "$route" &&
    mv "$route" "$STATE/delivery-routes/$(basename "$1")" &&
    printf '%s\n%s\n' "$2" "${HERDR_SOCKET_PATH:-default}" > "$STATE/receivers/$(basename "$1")" || return
  python3 -I -c '
import json, os, sys, tempfile
directory = sys.argv[1] + "/delivery-origins"
os.makedirs(directory, exist_ok=True)
fd, pending = tempfile.mkstemp(prefix=".new.", dir=directory)
try:
    with os.fdopen(fd, "w") as stream:
        json.dump({key: os.environ.get("PANE_TELL_SOURCE_" + key.upper(), "unknown")
                   for key in ("pane", "server", "session", "parent")}, stream)
        stream.flush(); os.fsync(stream.fileno())
    try: os.link(pending, directory + "/" + os.path.basename(sys.argv[2]))
    except FileExistsError: pass # A retry preserves the original sender.
finally:
    os.unlink(pending)
' "$STATE" "$1"
)
receiver_server() {
  case "$1" in */sessions/workers/herdr.sock) echo workers ;; *) echo default ;; esac
}
predecessors() { # terminal: inspect metadata and existence only, never waiting message contents
  python3 -I -c '
import os, stat, sys
from pathlib import Path
state, terminal, server = sys.argv[1:]
try:
    entries = list(os.scandir(Path(state) / "receivers"))
except FileNotFoundError:
    entries = []
for entry in sorted(entries, key=lambda entry: entry.name):
    meta = Path(entry.path)
    payload = Path(state) / "waiting" / meta.name
    try:
        mode = payload.stat().st_mode
    except FileNotFoundError:
        continue
    if not stat.S_ISREG(mode):
        raise ValueError("active waiting payload is not a regular file")
    try:
        fields = meta.read_text().splitlines()
    except FileNotFoundError:
        continue
    if len(fields) != 2 or not fields[0] or not fields[1]:
        raise ValueError("active receiver metadata is malformed")
    recorded = "workers" if fields[1].endswith("/sessions/workers/herdr.sock") else "default"
    if fields[0] == terminal and recorded == server:
        print(payload)
' "$STATE" "$1" "$(receiver_server "${HERDR_SOCKET_PATH:-}")"
}
predecessors_done() { # payload, optional predecessor from an older invocation
  [ ! -f "${2:-}" ] || return 1
  local previous
  [ -f "$STATE/order/dependencies/$(basename "$1")" ] || return 0
  while IFS= read -r previous; do
    [ ! -f "$previous" ] || return 1
  done < "$STATE/order/dependencies/$(basename "$1")"
}
order_failed() { # payload: report failure, retaining the original for inspection
  local saved=$1 disposition=remains
  if mkdir -p "$STATE/undelivered" && mv "$1" "$STATE/undelivered/"; then
    saved=$STATE/undelivered/$(basename "$1"); disposition=saved
  fi
  # Timers are detached with stderr redirected. Use the existing external
  # error gateway as well, so a retained batch never fails without an alert.
  warn "전달 순서를 확인하지 못해 다른 세션의 글을 파일로 남겼습니다: $saved" "${2:-}" "${3:-}" || :
  die "cannot check the delivery order; message $disposition at $saved"
}

ordered() { # terminal, operation, arguments: never held while a queued delivery waits
  (umask 077; python3 -I -c '
import fcntl, os, subprocess, sys
path, script, *args = sys.argv[1:]
os.makedirs(os.path.dirname(path), exist_ok=True)
with open(path, "a") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    sys.exit(subprocess.call(["/bin/bash", script, "--ordered", *args]))
' "$STATE/order/$(receiver_server "${HERDR_SOCKET_PATH:-}")/$1.lock" "$0" "$@")
}
queue_file() { # payload, terminal, session, sender terminal, sender socket, optional foreground; under ordered()
  local file snapshot
  umask 077
  mkdir -p "$STATE/waiting" "$STATE/undelivered" || die "cannot keep the message"
  if [ -n "${7:-}" ]; then file=$STATE/waiting/$7; else
    file=$(mktemp "$STATE/waiting/$(date +%s).XXXXXX") || die "cannot keep the message"
    rm -f "$file" # reserve a unique name without leaving an empty orphan on failure
  fi
  mkdir -p "$STATE/order/dependencies" || die "cannot keep the delivery order"
  # Snapshot every active predecessor, including queues created before this
  # version. A cancelled middle message cannot disconnect an older dependency.
  if [ ! -f "$STATE/order/dependencies/$(basename "$file")" ]; then
    snapshot=$(mktemp "$STATE/order/dependencies/.new.XXXXXX") || die "cannot keep the delivery order"
    # The authenticated handoff request must also pass parked predecessors
    # when the first send lost the nonblocking prompt lock and had to queue.
    if is_main "$2" && refresh_request "$(cat "$1")"; then
      : > "$snapshot"
    elif ! predecessors "$2" > "$snapshot"; then
      rm -f "$snapshot"
      order_failed "$1" "$4" "$5"
    fi
    mv "$snapshot" "$STATE/order/dependencies/$(basename "$file")" || die "cannot keep the delivery order"
  fi
  # A deterministic batch handoff can be retried after registration failed.
  # Keep the source until its dependency snapshot is durable.
  if [ ! -s "$file" ]; then mv "$1" "$file" || die "cannot keep the message"; fi
  register_receiver "$file" "$2" "$3" "$4" "$5" || die "cannot keep the receiver"
  if [ "${6:-}" = foreground ]; then
    printf '%s\n' "$file"
    return 0
  fi
  nohup perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' /bin/bash "$0" --deliver "$file" "$2" "$3" "$4" "$5" </dev/null >/dev/null 2>>"$STATE/worker-errors.log" &
  echo "$(date '+%F %T') worker-scheduled $(basename "$file") pid=$!" >> "$STATE/log"
}
tell() { # pane, kind, message, receiver's terminal, its session, sender's terminal, sender's socket when on another server.
  # Returns 1 when it had to queue. The waiting process inherits HERDR_SOCKET_PATH, the receiver's server.
  [ "${ORDERED_TERMINAL+x}" = x ] && [ "$ORDERED_TERMINAL" = "$4" ] || { ordered "$4" tell "$@"; return $?; }
  local previous file
  umask 077 # messages can name customers
  mkdir -p "$STATE" || die "cannot keep the message"
  file=$(mktemp "$STATE/.message.XXXXXX") && printf '%s' "$3" > "$file" || die "cannot keep the message"
  previous=$(predecessors "$4") || order_failed "$file" "$6" "${7:-}"
  # The only permitted prompt during refresh must pass the parked old backlog.
  if { [ -z "$previous" ] || { is_main "$4" && refresh_request "$3"; }; } && send "$1" "$2" "$3"; then rm -f "$file"; return 0; fi
  # Own session so neither the caller's tool runner nor the sending pane's close takes it down.
  queue_file "$file" "$4" "$5" "$6" "${7:-}"
  return 1
}

# Prints why no prompt may be typed into this pane, nothing when one may. The dispatch job names its tabs "자동 <tag>", the
# Slack ambient poll "알아서 <#channel> <title>". The tab holds even when herdr gives no session id to look up, which let
# board.sh unwatch type into an auto pane and lift its guard (Claude review 10/21). The first human prompt catches a session
# moved or renamed out of its tab.
auto_reason() { # tab id, session id
  local tabs t first
  tabs=$("$H" tab list 2>/dev/null) || { echo "could not be checked: herdr tab list failed"; return; }
  case "$(printf '%s\n' "$tabs" | jq -r --arg t "$1" '.result.tabs[] | select(.tab_id == $t) | .label // ""')" in
    "자동 "*) echo "is in an auto-dispatch tab; comment on its board item instead"; return ;;
    "알아서 "*) echo "is in a Slack ambient tab; it takes rounds only from the ambient poll"; return ;;
  esac
  for t in "$HOME"/.claude/projects/*/"$2".jsonl; do
    [ -n "$2" ] && [ -f "$t" ] || continue
    # -a: a NUL byte would make grep print "Binary file ... matches" instead of the line
    first=$(grep -a -m1 -F '"origin":{"kind":"human"}' "$t")
    # only a session a job started: its first prompt opens with the marker ("[" may be eaten), so a session that merely
    # talks about the marker is still told (3 such panes in the 30 days to 2026-11-05 could not be reached at all)
    [[ $first =~ \"(content|text)\":\"\[?auto-dispatch\] ]] && { echo "is an auto-dispatch session; comment on its board item instead"; return; }
    [[ $first =~ \"content\":\"\[?ambient-round\] ]] &&
      { echo "is a Slack ambient session; it takes rounds only from the ambient poll"; return; }
  done
}

socket_of() { "$H" session list --json 2>/dev/null | jq -r --arg n "$1" '.sessions[] | select(.name == $n and .running) | .socket_path' 2>/dev/null | head -1; }

warn() { # what happened, sender's terminal, sender's socket when on another server
  local row helper
  if [ -n "${HERDR_ERROR_NOTIFY:-}" ]; then
    "$HERDR_ERROR_NOTIFY" "칸 전달 대기" "$1" >/dev/null 2>&1 ||
      echo "$(date '+%F %T') error notification queue failed" >> "$STATE/log"
  else
    # Resolve the installed symlink before locating the shared helper beside this script.
    helper=$(/usr/bin/python3 -I -c 'import os, sys; print(os.path.join(os.path.dirname(os.path.realpath(sys.argv[1])), "herdr-error-notify.py"))' "$0")
    /usr/bin/python3 -I "$helper" "칸 전달 대기" "$1" >/dev/null 2>&1 ||
      echo "$(date '+%F %T') error notification queue failed" >> "$STATE/log"
  fi
  case "${HERDR_SOCKET_PATH:-}" in
    # A job has no sender pane to hear it, so the main pane gets its note.
    */sessions/workers/herdr.sock)
      [ -n "$2" ] || set -- "$1" "$(cat "${XDG_STATE_HOME:-$HOME/.local/state}/orchestrator/main" 2>/dev/null)" "$(socket_of default)" ;;
  esac
  echo "$(date '+%F %T') announced: $1" >> "$STATE/log"
  [ -n "$2" ] || return 0
  ( # the sender's server, for the lookup and the note alone
    [ -z "${3:-}" ] || export HERDR_SOCKET_PATH=$3
    row=$("$H" pane list 2>/dev/null | jq -r --arg t "$2" '.result.panes[] | select(.terminal_id == $t)
      | [.pane_id, (.agent // ""), (.tab_id // ""), (.agent_session.value // "")] | @tsv')
    [ -n "$row" ] && [ -z "$(auto_reason "$(printf '%s\n' "$row" | cut -f3)" "$(printf '%s\n' "$row" | cut -f4)")" ] || exit 0
    # One try, never queued: a note about a stuck message must not get stuck itself, and the notification has already gone out.
    send "$(printf '%s\n' "$row" | cut -f1)" "$(printf '%s\n' "$row" | cut -f2)" "[pane-tell: 자동 안내입니다. 요유가 직접 친 글이 아닙니다] $1"
  )
}

deliver() { # message file, receiver's terminal (a moved pane gets a new pane id), its session when queued, sender's terminal,
  # sender's socket, predecessor payload (if any)
  local list row pane kind sid label t0=$SECONDS warned=
  while (( SECONDS - t0 < ${PANE_TELL_WAIT:-86400} )); do
    sleep "${PANE_TELL_POLL:-5}"
    list=$("$H" pane list 2>/dev/null) || continue # herdr restarting is not the receiver gone
    row=$(printf '%s\n' "$list" | jq -r --arg t "$2" '.result.panes[] | select(.terminal_id == $t)
      | [.pane_id, (.agent // ""), (.agent_session.value // ""), (.label // "이름 없는 칸")] | @tsv') || continue
    pane=$(printf '%s\n' "$row" | cut -f1); kind=$(printf '%s\n' "$row" | cut -f2); sid=$(printf '%s\n' "$row" | cut -f3); label=$(printf '%s\n' "$row" | cut -f4)
    # The registered main is a stable receiver across /clear, including queues
    # created before refresh began. Other receivers retain session binding.
    [ -n "$kind" ] && { [ -z "$3" ] || [ "$sid" = "$3" ] || is_main "$2"; } || break
    if predecessors_done "$1" "${6:-}" && send "$pane" "$kind" "$(cat "$1")"; then
      rm -f "$1"
      rm -f "$STATE/receivers/$(basename "$1")"
      rm -f "$STATE/delivery-routes/$(basename "$1")"
      ordered "$2" done "$1"
      echo "$(date '+%F %T') delivered $(basename "$1") to $pane" >> "$STATE/log"
      return
    fi
    if [ -z "$warned" ] && (( SECONDS - t0 >= ${PANE_TELL_ALERT:-600} )); then
      warned=1
      warn "$label 칸 입력창이 비어 있지 않거나 화면이 위로 올라가 있어 다른 칸의 글이 들어가지 못합니다. 입력창을 비우고 맨 아래로 내리면 바로 전달됩니다." "$4" "$5"
    fi
  done
  mv "$1" "$STATE/undelivered/"
  rm -f "$STATE/receivers/$(basename "$1")"
  rm -f "$STATE/delivery-routes/$(basename "$1")"
  ordered "$2" done "$1"
  echo "$(date '+%F %T') undelivered $(basename "$1") for $2" >> "$STATE/log"
  warn "다른 칸에 보낸 글을 전달하지 못해 파일로 남겼습니다: $STATE/undelivered/$(basename "$1")" "$4" "$5"
}
BATCH=${PANE_TELL_BATCH:-120}
[ ! -e "$STATE/batch-off" ] || BATCH=0 # the switch for every sender at once: launchd jobs set no environment of ours
# 0 when the message goes now even to a resting main pane
urgent() {
  case "$1" in *"prod 허용"* | *"staging 허용"* | "[main-refresh]"*) return 0 ;; esac
  case "${1:0:300}" in *장애* | *보안* | *긴급*) return 0 ;; esac
  return 1
}
