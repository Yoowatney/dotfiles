#!/usr/bin/env bash
# Types a message into the agent of another herdr pane, so 요유 never carries words between sessions
# (요유 2026-10: "메시지가 아니라 세션한테 전달하라고"). Claude and Codex both use it.
#   pane-tell --list                          one line per pane: id, name, cwd; pick the target from these. Panes on the other
#                                               server (default or workers) follow as <session>/<pane id>, when it runs
#   pane-tell <pane id|name text> "<message>"  name text: any piece of the pane name, case-insensitive ("KPI 표"), on this
#                                               server, else on the other one. A bare pane id is only ever this server's
#   pane-tell <session>/<pane id> "<message>"  a pane on the default or workers herdr server (workers/w1:p2); the same pane
#                                               id exists on both, so the sender is named and refused from its own server
# Exit 3: no pane matches, or the named server is not running. Exit 2: bad usage, a session other than default or workers,
# more than one match (listed on stderr), this pane itself, or an
# auto-dispatch or Slack ambient session: a prompt typed there counts as 요유 speaking and lifts the board's
# dispatch/guard.sh (for good in a dispatch session, for that round in an ambient one).
# The message arrives marked as coming from another session, since the receiver would otherwise read it as 요유's.
# A prompt typed into a box that holds 요유's half-typed words is sent along with them, cut short (요유 2026-10-31: "야 리드야",
# "z"). So it goes only into an empty box, working agent or not: Claude queues it, Codex takes it into the running turn.
# Otherwise it prints "queued ...", exits 0, and a detached process tries again until the box is empty, which outlives the
# sending pane and runs on the receiver's server. After PANE_TELL_WAIT seconds, or when the receiver is gone or holds another
# session, the message stays in ~/.local/state/pane-tell/undelivered/; `log` beside it says what became of each one. A
# message that waits PANE_TELL_ALERT seconds (10 minutes) or ends up in that folder is announced, since a one-letter leftover
# in a box once held a report back with nobody knowing (10/31): a durable terminal error alert for 요유, the only one who can
# clear the box, and a note to the sender on its own server, who would take it as delivered, unless the sender is an auto
# session, for the reason above. A box on the workers server also queues an error alert; its note goes to the sender, or to
# the main pane when a job sent it. Only an unattended workers Codex box containing a lone `!` in Shell mode is cleared;
# every other nonempty box waits, including all boxes on the default server.
#   pane-tell --raw <pane id> "<message>"       the same door for a prompt a machine types as it is, into any pane; one that
#                                               has to wait stays for the session in the pane now, like every queued message
#   pane-tell --box-ready <pane id> <kind>      exit 0 when the box is empty and in view (ambient/deliver.py asks this)
# Batching (api#1051): a marked message for the main pane (the terminal in orchestrator/main), a lead (👑), or a worker (🫡)
# while it rests opens a batch, and
# all that comes for it in the next PANE_TELL_BATCH seconds (120; 0, or a file batch-off in the state folder, turns batching
# off) goes as one prompt, each message with
# its own mark, a blank line between: it prints "queued for … held …" and exits 0. The main pane read about 210k tokens a turn,
# and in the 3 days to 11/07, 32% of the turns a relay started while it rested had another relay within 2 minutes of the
# first (25% at 90 s, 44% at 180 s). The prompt still opens with a mark, and fix-round-guard, trial-count and
# yoyoo-share-guard read each message of it (split at "\n\n[pane-tell: '"). A working main pane takes a message at once: Claude
# folds it into the running turn. So does a message that may not wait or must arrive alone, after what was held: 요유's
# `prod 허용`/`staging 허용` (gcp-account-guard grants on one whole relay, for the turn it starts), 장애/보안/긴급 in its first
# 300 characters, and main-refresh's request, which checks that it is the last prompt. A batch is not tied to the session, so a
# /clear meanwhile hands it to the next one.
H=${HERDR_BIN_PATH:-herdr}
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/pane-tell
PEERS="default workers"
die() { echo "pane-tell: $*" >&2; exit 2; }

# Exit 0 when the ansi screen on stdin shows the agent's input box empty. Any screen it cannot place is "not empty". Dim text
# on the prompt line is a placeholder, never typed words; on the lines below it counts.
# ponytail: reads the TUI's drawing, so a redesign of either box stops delivery (messages wait, nothing merges); a key typed
# in the moment after the second read, or a Korean syllable still composing in the IME, does not show on the screen.
BOX=$(cat <<'PY'
import re, sys
kind = sys.argv[1]
SGR = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")
DIM = re.compile(r"\x1b\[2m.*?(?:\x1b\[0m|$)")
plain = lambda line: SGR.sub("", line).strip()
typed = lambda line: plain(DIM.sub("", line))
lines = sys.stdin.read().replace("\r", "").split("\n")
if len(sys.argv) > 2 and sys.argv[2] == "shell-bang":
    # Shell mode replaces the prompt's › with a red !. Match the final background block, never history or a command.
    bg = [i for i, line in enumerate(lines) if "\x1b[48;" in line]
    if kind != "codex" or not bg:
        sys.exit(1)
    end = bg[-1]
    start = end
    while start > 0 and "\x1b[48;" in lines[start - 1]:
        start -= 1
    content = [line for line in lines[start:end + 1] if plain(line)]
    shell = any(re.search(r"\bShell mode\b", plain(line)) for line in lines[end + 1:])
    sys.exit(0 if len(content) == 1 and plain(content[0]) == typed(content[0]) == "!" and shell else 1)
box = []
if kind == "claude":  # the last two rules, the upper one may carry the session name; ❯ elsewhere is history or a picker
    rules = [i for i, l in enumerate(lines) if re.fullmatch(r"─{3,}( .* ─+)?", plain(l)) and len(plain(l)) >= 10]
    if len(rules) >= 2:
        box = lines[rules[-2] + 1:rules[-1]]
    if not box or not SGR.sub("", box[0]).startswith("❯\xa0"):
        sys.exit(1)
    box[0] = typed(box[0])[1:]
elif kind == "codex":  # the last › line unless its mark is dim (an old prompt), then the block of lines with its background
    marks = [i for i, l in enumerate(lines) if plain(l).startswith("›")]
    if not marks or not typed(lines[marks[-1]]).startswith("›"):
        sys.exit(1)
    i = marks[-1] + 1
    box = [typed(lines[marks[-1]])[1:]]
    while i < len(lines) and "\x1b[48;" in lines[i]:
        box.append(lines[i])
        i += 1
else:
    sys.exit(1)
sys.exit(1 if any(plain(line) for line in box) else 0)
PY
)
if [ "${1:-}" = --box-empty ]; then python3 -I -c "$BOX" "$2"; exit; fi

# In view, and empty on two reads: what is typed between them holds the message back.
box_ready() { # pane kind
  "$H" pane get "$1" 2>/dev/null | jq -e '(.result.pane.scroll.offset_from_bottom // 0) == 0' >/dev/null || return 1
  local i
  for i in 1 2; do
    [ "$i" = 1 ] || sleep "${PANE_TELL_SETTLE:-0.7}"
    "$H" pane read "$1" --source recent --lines 60 --format ansi 2>/dev/null | python3 -I -c "$BOX" "$2" || return 1
  done
}
recover_shell() { # pane kind: workers only; normal box readiness remains read-only
  [ "$2" = codex ] || return 1
  case "${HERDR_SOCKET_PATH:-}" in */sessions/workers/herdr.sock) ;; *) return 1 ;; esac
  "$H" pane get "$1" 2>/dev/null | jq -e '(.result.pane.scroll.offset_from_bottom // 0) == 0' >/dev/null || return 1
  local i
  for i in 1 2; do
    [ "$i" = 1 ] || sleep "${PANE_TELL_SETTLE:-0.7}"
    "$H" pane read "$1" --source recent --lines 60 --format ansi 2>/dev/null | python3 -I -c "$BOX" "$2" shell-bang || return 1
  done
  "$H" agent send-keys "$1" esc esc Backspace >/dev/null 2>&1 || return 1
  mkdir -p "$STATE"
  echo "$(date '+%F %T') cleared lone Shell-mode bang on workers/$1" >> "$STATE/log"
  # The TUI may redraw after send-keys returns. A failed check queues delivery for the next poll.
  sleep "${PANE_TELL_SETTLE:-0.7}"
  box_ready "$1" "$2"
}
send_unlocked() { { box_ready "$1" "$2" || recover_shell "$1" "$2"; } && "$H" agent prompt "$1" "$3" >/dev/null 2>&1; }
send() {
  case "${HERDR_SOCKET_PATH:-}" in
    */sessions/workers/herdr.sock)
      # Serialize check, recovery and prompt across senders. The OS releases this lock even if a sender dies.
      (umask 077; python3 -I -c '
import fcntl, os, subprocess, sys
path, script, *args = sys.argv[1:]
os.makedirs(os.path.dirname(path), exist_ok=True)
with open(path, "a") as lock:
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        sys.exit(1)
    sys.exit(subprocess.call(["bash", script, "--send-locked", *args]))
' "$STATE/sending/$1.lock" "$0" "$@") ;;
    *) send_unlocked "$@" ;;
  esac
}
if [ "${1:-}" = --send-locked ]; then send_unlocked "$2" "$3" "$4"; exit; fi

register_receiver() ( # waiting payload, terminal: metadata contains no message text
  umask 077
  mkdir -p "$STATE/receivers" && printf '%s\n%s\n' "$2" "${HERDR_SOCKET_PATH:-default}" > "$STATE/receivers/$(basename "$1")"
)

tell() { # pane, kind, message, receiver's terminal, its session, sender's terminal, sender's socket when on another server.
  # Returns 1 when it had to queue. The waiting process inherits HERDR_SOCKET_PATH, the receiver's server.
  send "$1" "$2" "$3" && return 0
  umask 077 # messages can name customers
  mkdir -p "$STATE/waiting" "$STATE/undelivered" || die "cannot keep the message"
  local file
  file=$(mktemp "$STATE/waiting/$(date +%s).XXXXXX") && printf '%s' "$3" > "$file" || die "cannot keep the message"
  register_receiver "$file" "$4" || die "cannot keep the receiver"
  # Own session so neither the caller's tool runner nor the sending pane's close takes it down.
  nohup perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' bash "$0" --deliver "$file" "$4" "$5" "$6" "${7:-}" </dev/null >/dev/null 2>&1 &
  return 1
}

# Prints why no prompt may be typed into this pane, nothing when one may. The dispatch job names its tabs "자동 <tag>", the
# Slack ambient poll "알아서 <#channel> <title>". The tab holds even when herdr gives no session id to look up, which let
# board.sh unwatch type into an auto pane and lift its guard (Claude review 10/21). The first human prompt catches a session
# moved or renamed out of its tab.
auto_reason() { # tab id, session id
  local tabs t first
  tabs=$("$H" tab list 2>/dev/null) || { echo "could not be checked: herdr tab list failed"; return; }
  case "$(jq -r --arg t "$1" '.result.tabs[] | select(.tab_id == $t) | .label // ""' <<<"$tabs")" in
    "자동 "*) echo "is in an auto-dispatch tab; comment on its board item instead"; return ;;
    "알아서 "*) echo "is in a Slack ambient tab; it takes rounds only from the ambient poll"; return ;;
  esac
  for t in "$HOME"/.claude/projects/*/"$2".jsonl; do
    [ -n "$2" ] && [ -f "$t" ] || continue
    # -a: a NUL byte would make grep print "Binary file ... matches" instead of the line
    first=$(grep -a -m1 -F '"origin":{"kind":"human"}' "$t")
    # only a session a job started: its first prompt opens with the marker ("[" may be eaten), so a session that merely
    # talks about the marker is still told (3 such panes in the 30 days to 2026-11-05 could not be reached at all)
    [[ $first =~ \"(content|text)\":\"\[?auto-dispatch\] ]] && { echo "is an auto-dispatch session; comment on its board item instead"; return; }
    [[ $first =~ \"content\":\"\[?ambient-round\] ]] &&
      { echo "is a Slack ambient session; it takes rounds only from the ambient poll"; return; }
  done
}

socket_of() { "$H" session list --json 2>/dev/null | jq -r --arg n "$1" '.sessions[] | select(.name == $n and .running) | .socket_path' 2>/dev/null | head -1; }

warn() { # what happened, sender's terminal, sender's socket when on another server
  local row helper
  if [ -n "${HERDR_ERROR_NOTIFY:-}" ]; then
    "$HERDR_ERROR_NOTIFY" "칸 전달 대기" "$1" >/dev/null 2>&1 ||
      echo "$(date '+%F %T') error notification queue failed" >> "$STATE/log"
  else
    # Resolve the installed symlink before locating the shared helper beside this script.
    helper=$(/usr/bin/python3 -I -c 'import os, sys; print(os.path.join(os.path.dirname(os.path.realpath(sys.argv[1])), "herdr-error-notify.py"))' "$0")
    /usr/bin/python3 -I "$helper" "칸 전달 대기" "$1" >/dev/null 2>&1 ||
      echo "$(date '+%F %T') error notification queue failed" >> "$STATE/log"
  fi
  case "${HERDR_SOCKET_PATH:-}" in
    # A job has no sender pane to hear it, so the main pane gets its note.
    */sessions/workers/herdr.sock)
      [ -n "$2" ] || set -- "$1" "$(cat "${XDG_STATE_HOME:-$HOME/.local/state}/orchestrator/main" 2>/dev/null)" "$(socket_of default)" ;;
  esac
  echo "$(date '+%F %T') announced: $1" >> "$STATE/log"
  [ -n "$2" ] || return 0
  ( # the sender's server, for the lookup and the note alone
    [ -z "${3:-}" ] || export HERDR_SOCKET_PATH=$3
    row=$("$H" pane list 2>/dev/null | jq -r --arg t "$2" '.result.panes[] | select(.terminal_id == $t)
      | [.pane_id, (.agent // ""), (.tab_id // ""), (.agent_session.value // "")] | @tsv')
    [ -n "$row" ] && [ -z "$(auto_reason "$(cut -f3 <<<"$row")" "$(cut -f4 <<<"$row")")" ] || exit 0
    # One try, never queued: a note about a stuck message must not get stuck itself, and the notification has already gone out.
    send "$(cut -f1 <<<"$row")" "$(cut -f2 <<<"$row")" "[pane-tell: 자동 안내입니다. 요유가 직접 친 글이 아닙니다] $1"
  )
}

deliver() { # message file, receiver's terminal (a moved pane gets a new pane id), its session when queued, sender's terminal,
  # sender's socket
  local list row pane kind sid label t0=$SECONDS warned=
  while (( SECONDS - t0 < ${PANE_TELL_WAIT:-86400} )); do
    sleep "${PANE_TELL_POLL:-5}"
    list=$("$H" pane list 2>/dev/null) || continue # herdr restarting is not the receiver gone
    row=$(jq -r --arg t "$2" '.result.panes[] | select(.terminal_id == $t)
      | [.pane_id, (.agent // ""), (.agent_session.value // ""), (.label // "이름 없는 칸")] | @tsv' <<<"$list") || continue
    pane=$(cut -f1 <<<"$row"); kind=$(cut -f2 <<<"$row"); sid=$(cut -f3 <<<"$row"); label=$(cut -f4 <<<"$row")
    [ -n "$kind" ] && { [ -z "$3" ] || [ "$sid" = "$3" ]; } || break
    if send "$pane" "$kind" "$(cat "$1")"; then
      rm -f "$1"
      rm -f "$STATE/receivers/$(basename "$1")"
      echo "$(date '+%F %T') delivered $(basename "$1") to $pane" >> "$STATE/log"
      return
    fi
    if [ -z "$warned" ] && (( SECONDS - t0 >= ${PANE_TELL_ALERT:-600} )); then
      warned=1
      warn "$label 칸 입력창이 비어 있지 않거나 화면이 위로 올라가 있어 다른 칸의 글이 들어가지 못합니다. 입력창을 비우고 맨 아래로 내리면 바로 전달됩니다." "$4" "$5"
    fi
  done
  mv "$1" "$STATE/undelivered/"
  rm -f "$STATE/receivers/$(basename "$1")"
  echo "$(date '+%F %T') undelivered $(basename "$1") for $2" >> "$STATE/log"
  warn "다른 칸에 보낸 글을 전달하지 못해 파일로 남겼습니다: $STATE/undelivered/$(basename "$1")" "$4" "$5"
}
BATCH=${PANE_TELL_BATCH:-120}
[ ! -e "$STATE/batch-off" ] || BATCH=0 # the switch for every sender at once: launchd jobs set no environment of ours
# 0 when the message goes now even to a resting main pane
urgent() {
  case "$1" in *"prod 허용"* | *"staging 허용"* | "[main-refresh]"*) return 0 ;; esac
  case "${1:0:300}" in *장애* | *보안* | *긴급*) return 0 ;; esac
  return 1
}
# A batch is the directory <dir>/open, one file per message named by its arrival time, and .t, its opening second. A rename
# carries it away whole, so a message moved in is either in it or refused (the batch has gone: the caller opens another).
add() { # dir, message
  local tmp
  [ -d "$1/open" ] && tmp=$(mktemp "$1/.new.XXXXXX") || return 1
  printf '%s' "$2" > "$tmp" && mv "$tmp" "$1/open/$(perl -MTime::HiRes=time -e 'printf "%017.6f", time').$$" 2>/dev/null && return
  rm -f "$tmp"; return 1
}
take() { # dir: takes the open batch and prints the file holding its messages joined in order; nothing when none is open
  local s="$1/sending.$$.$RANDOM" out f
  mv "$1/open" "$s" 2>/dev/null || return 0
  out=$(mktemp "$1/.joined.XXXXXX") || return 0
  for f in "$s"/[0-9]*; do [ -f "$f" ] || continue; [ ! -s "$out" ] || printf '\n\n' >> "$out"; cat "$f" >> "$out"; done
  rm -rf "$s"
  if [ -s "$out" ]; then echo "$out"; else rm -f "$out"; fi
}
if [ "${1:-}" = --deliver ]; then deliver "$2" "$3" "${4:-}" "${5:-}" "${6:-}"; exit; fi
if [ "${1:-}" = --flush ]; then # dir, the main pane's terminal: sends the batch when its hold ends, through the usual queue
  sleep "$BATCH"
  # ponytail: a batch opened after an urgent message took this one goes early, with this wake
  f=$(take "$2"); [ -z "$f" ] && exit 0
  mkdir -p "$STATE/waiting" "$STATE/undelivered" && w=$(mktemp "$STATE/waiting/$(date +%s).XXXXXX") && mv "$f" "$w" || exit 1
  register_receiver "$w" "$3" || exit 1
  deliver "$w" "$3" "" "" ""
  exit
fi
if [ "${1:-}" = --box-ready ]; then box_ready "$2" "$3"; exit; fi

command -v "$H" >/dev/null 2>&1 || die "herdr not found"
command -v jq >/dev/null 2>&1 || die "jq not found"
if [ "${1:-}" = --raw ]; then
  [ $# -eq 3 ] && [ -n "$2" ] && [ -n "$3" ] || die 'usage: pane-tell --raw <pane id> "<message>"'
  # no mark, so the receiver reads it as 요유's own typing: an unlock word never goes this way (api#1026)
  case "$3" in *"prod 허용"* | *"staging 허용"*) die "--raw never types prod 허용 or staging 허용: send it without --raw, marked" ;; esac
  row=$("$H" pane get "$2" 2>/dev/null | jq -r '.result.pane | [(.pane_id // ""), (.agent // ""), (.terminal_id // ""), (.agent_session.value // "")] | @tsv')
  [ -n "$(cut -f1 <<<"$row")" ] || { echo "pane-tell: no pane \"$2\"" >&2; exit 3; }
  tell "$(cut -f1 <<<"$row")" "$(cut -f2 <<<"$row")" "$3" "$(cut -f3 <<<"$row")" "$(cut -f4 <<<"$row")" ""
  exit 0
fi
pane_rows() {
  jq -r '.result.panes[]
    | [.pane_id, ((.label // "") | ltrimstr("🔴 ") | ltrimstr("🟢 ")), (.agent_session.value // ""), (.cwd // ""), (.tab_id // ""), (.agent // ""), (.terminal_id // "")] | @tsv'
}
list_panes() { "$H" pane list 2>/dev/null | pane_rows; }
srv() { [[ $1 =~ /sessions/([^/]+)/herdr\.sock$ ]] && echo "${BASH_REMATCH[1]}" || echo default; }
# The panes of the other servers, ids as <session>/<pane id>. One that is down or absent (집맥 has no workers) has none. Nor has
# a stuck one: herdr's CLI waits on it for ever, and a job waiting here would hold its lock, so it gets PANE_TELL_OTHER_LIMIT seconds.
other_panes() {
  local n sock
  for n in $PEERS; do
    [ "$n" != "$(srv "$here")" ] || continue
    sock=$(socket_of "$n")
    [ -z "$sock" ] && continue
    ( HERDR_SOCKET_PATH=$sock perl -e 'alarm shift; exec @ARGV' "${PANE_TELL_OTHER_LIMIT:-5}" "$H" pane list | pane_rows | sed "s|^|$n/|" ) 2>/dev/null
  done
}
# <session>/<pane id>: only a server other than this pane's own needs a lookup and a switch.
here=${HERDR_SOCKET_PATH:-} there= target=${1:-}
if [[ $target =~ ^(([a-z0-9_-]+)/)?(w[0-9A-Za-z]+:p[0-9A-Za-z]+)$ ]] && [ -n "${BASH_REMATCH[2]}" ]; then
  target=${BASH_REMATCH[3]} session=${BASH_REMATCH[2]}
  [[ " $PEERS " == *" $session "* ]] || die "only default and workers are reachable by name, not \"$session\""
  if [ "$session" != "$(srv "$here")" ]; then
    there=$(socket_of "$session")
    [ -n "$there" ] || { echo "pane-tell: the $session herdr server is not running, so it has no pane $target" >&2; exit 3; }
    # --deliver runs on the receiver's socket, so the sender's server needs a real path there
    [ -n "$here" ] || here=$(socket_of default)
  fi
fi
# The sender is named and placed from its own server; a moved pane keeps its old id in the env, `pane get` still resolves it
me=$("$H" pane get "${HERDR_PANE_ID:-}" 2>/dev/null | jq -r '.result.pane.pane_id // empty' 2>/dev/null)
me=${me:-${HERDR_PANE_ID:-}}
if [ -n "$there" ]; then
  mine=$(list_panes)
  export HERDR_SOCKET_PATH=$there # every call from here on is about the receiver
fi
panes=$(list_panes) || die "herdr pane list failed"
[ -n "$there" ] || mine=$panes

if [ "${1:-}" = --list ]; then
  { [ -z "$panes" ] || printf '%s\n' "$panes"; other_panes; } |
    awk -F'\t' -v me="${HERDR_PANE_ID:-}" '{print $1 "\t" ($2 == "" ? "(이름 없음)" : $2) "\t" $4 ($1 == me ? "\t(이 pane)" : "")}'
  exit 0
fi
[ $# -eq 2 ] && [ -n "$1" ] && [ -n "$2" ] || die 'usage: pane-tell --list | pane-tell <pane id|name text> "<message>"'

if [[ "$target" =~ ^w[0-9A-Za-z]+:p[0-9A-Za-z]+$ ]]; then # herdr counts on past 9: wA:p7
  hits=$(awk -F'\t' -v t="$target" '$1 == t' <<<"$panes")
else
  hits=$(awk -F'\t' -v t="$1" 'index(tolower($2), tolower(t))' <<<"$panes")
  # The other server only when this one has none: a name that found a pane here finds the same one now.
  [ -n "$hits" ] || hits=$(other_panes | awk -F'\t' -v t="$1" 'index(tolower($2), tolower(t))')
fi
[ -n "$hits" ] || { echo "pane-tell: no pane matches \"$1\" (see pane-tell --list)" >&2; exit 3; }
if [ "$(wc -l <<<"$hits" | tr -d ' ')" -gt 1 ]; then
  echo "pane-tell: more than one pane matches \"$1\"; ask 요유 which, then use its id:" >&2
  cut -f1,2 <<<"$hits" >&2
  exit 2
fi
# cut, not `IFS=$'\t' read`: read merges the tabs around an empty session id and shifts every later field
pane=$(cut -f1 <<<"$hits"); name=$(cut -f2 <<<"$hits"); sid=$(cut -f3 <<<"$hits"); tab=$(cut -f5 <<<"$hits")
kind=$(cut -f6 <<<"$hits"); terminal=$(cut -f7 <<<"$hits")
if [[ $pane == */* ]]; then # found on another server: every call from here on is about the receiver
  there=$(socket_of "${pane%%/*}"); pane=${pane#*/}
  [ -n "$there" ] || { echo "pane-tell: the server of \"$1\" has just stopped" >&2; exit 3; }
  [ -n "$here" ] || here=$(socket_of default)
  export HERDR_SOCKET_PATH=$there
fi
[ "$pane" != "$me" ] || [ -n "$there" ] || die "\"$1\" is this pane"
why=$(auto_reason "$tab" "$sid")
[ -z "$why" ] || die "$pane ($name) $why"
case "$kind" in claude | codex) ;; *) die "$pane ($name) runs no Claude or Codex, so its input box cannot be read" ;; esac
from=$(awk -F'\t' -v me="$me" '$1 == me {print $2}' <<<"$mine")
msg="[pane-tell: '${from:-자동 작업}' 세션이 보낸 글입니다. 요유가 이 pane에 직접 친 글이 아니므로, 되돌리기 어려운 일은 요유에게 확인하세요] $2"
sender=$(awk -F'\t' -v me="$me" '$1 == me {print $7}' <<<"$mine")
# A pane on another server is named with its server: a caller reusing a bare id would type into a different pane on its own.
shown=$pane; [ -z "$there" ] || shown=$(srv "$there")/$pane
batch_target=
if [ -n "$terminal" ]; then
  if [ "$terminal" = "$(cat "${XDG_STATE_HOME:-$HOME/.local/state}/orchestrator/main" 2>/dev/null)" ]; then batch_target=1; fi
  case "$name" in "👑 "* | "🫡 "*) batch_target=1 ;; esac
fi
if [ "$BATCH" -gt 0 ] 2>/dev/null && [ -n "$batch_target" ]; then
  umask 077 # messages can name customers
  dir=$STATE/batch/$terminal
  mkdir -p "$dir" || die "cannot keep the message"
  held_now() { # sends the open batch now, unbound to the session like the batch itself
    local j; j=$(take "$dir"); [ -n "$j" ] || return 0
    tell "$pane" "$kind" "$(cat "$j")" "$terminal" "" "" ""; local rc=$?; rm -f "$j"; return $rc
  }
  if urgent "$2"; then
    held_now # what was held goes first: a grant counts only for the turn it starts, so it must be the last prompt
  else
    # A stale batch has no sender left (the Mac restarted). Urgent messages above must still arrive alone.
    if [ -d "$dir/open" ] && [ $(( $(date +%s) - $(cat "$dir/open/.t" 2>/dev/null || echo 0) )) -gt $(( BATCH + 60 )) ] && add "$dir" "$msg"; then
      if held_now; then echo "told $shown ($name)"; else echo "queued for $shown ($name): its input box is not empty, so this goes in once it is"; fi
      exit 0
    fi
    if [ ! -d "$dir/open" ] && case "$("$H" pane get "$pane" 2>/dev/null | jq -r '.result.pane.agent_status // ""')" in idle | done) true ;; *) false ;; esac &&
      mkdir "$dir/open" 2>/dev/null; then
      date +%s > "$dir/open/.t"
      nohup perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' bash "$0" --flush "$dir" "$terminal" </dev/null >/dev/null 2>&1 &
    fi
    if add "$dir" "$msg"; then echo "queued for $shown ($name): held up to ${BATCH}s to go in one prompt with what else comes for this session"; exit 0; fi
  fi
fi
if tell "$pane" "$kind" "$msg" "$terminal" "$sid" "$sender" "${there:+$here}"; then echo "told $shown ($name)"; exit 0; fi
echo "queued for $shown ($name): its input box is not empty, so this goes in once it is"
