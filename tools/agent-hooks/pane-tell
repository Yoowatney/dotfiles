        now = int(time.time())
        write(path, dict(version=1, terminal=terminal, server=server, socket=socket,
                        generation=uuid.uuid4().hex, opened=now, due=now + int(delay)))
elif action == "claim":
    path = d / "claimed/.meta"
    if not path.exists():
