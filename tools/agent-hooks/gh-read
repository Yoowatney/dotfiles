#!/bin/bash
# GitHub reads for a Codex check pane, whose sandbox has no network (pane-spawn --check). The pane's rules let this one path
# run outside the sandbox, so what it passes reaches GitHub with the user's token: it runs gh only for read subcommands and
# REST GETs, and refuses everything else before gh starts.
#   gh-read issue view 12 -R owner/repo --comments
#   gh-read api repos/owner/repo/pulls/3 --jq .title
# gh starts from / with a fixed environment: a git config in a folder the agent can write, or a browser or pager command in
# its environment, would run outside the sandbox too. /bin/bash, not env, so PATH picks no interpreter.
# GH_READ_DRY=1 prints the command instead of running it (tests).
set -u
no() { echo "gh-read: $*. It runs only GitHub reads: issue/pr/run/workflow/release/label list or view, repo view, pr diff/checks/status, search, and api GETs (-X GET for fields)." >&2; exit 2; }
repo_ok() { case "$1" in */*/*) [[ "$1" == github.com/*/* ]] || no "a host other than github.com: $1" ;; esac; }
# gh reads a field value that starts with @ from that file (or stdin), so the file's content would go out in the query.
field_ok() { case "${1#*=}" in @*) no "a field value that starts with @ sends a local file: $1" ;; esac; }
[ $# -ge 2 ] || no "give a gh command"

case "$1 $2" in
  "issue view" | "issue list" | "issue status" | "pr view" | "pr list" | "pr diff" | "pr checks" | "pr status" | \
    "run view" | "run list" | "workflow view" | "workflow list" | "release view" | "release list" | "label list" | \
    "repo view" | "search issues" | "search prs" | "search repos" | "search commits" | "search code" | "api "*) ;;
  *) no "gh $1 $2 is not a read it allows" ;;
esac

if [ "$1" = api ]; then rest=("${@:2}"); else rest=("${@:3}"); fi
method= fields= endpoint= expect=
for a in ${rest[@]+"${rest[@]}"}; do # bash 3.2 under set -u calls an empty array unbound
  if [ -n "$expect" ]; then # the value of the option before it
    case "$expect" in repo) repo_ok "$a" ;; method) method=$a ;; field) field_ok "$a" ;; esac
    expect=; continue
  fi
  case "$a" in *://*) [[ "$a" == https://github.com/* ]] || no "a URL outside github.com: $a" ;; esac
  case "$a" in
    --web*) no "--web runs a browser command" ;;
    -w) no "-w is --web here; write the long option (--workflow)" ;;
    -R | --repo) expect=repo; continue ;;
    --repo=*) repo_ok "${a#--repo=}"; continue ;;
    --*) ;;
    -?) ;;
    -*) no "write one short option at a time (-c -R x, not -cR x): $a" ;;
    *) [ "$1 $2" != "repo view" ] || repo_ok "$a" ;;
  esac
  [ "$1" = api ] || continue
  case "$a" in
    -X | --method) expect=method ;;
    --method=*) method=${a#--method=} ;;
    -f | -F | --field | --raw-field) fields=1 expect=field ;;
    --field=* | --raw-field=*) fields=1; field_ok "${a#*=}" ;;
    -q | --jq | -t | --template | --cache) expect=value ;;
    --jq=* | --template=* | --cache=* | --paginate | --slurp | -i | --include | --silent) ;;
    -*) no "gh api $a is not allowed" ;;
    *) [ -z "$endpoint" ] || no "gh api takes one endpoint"; endpoint=$a ;;
  esac
done
if [ "$1" = api ]; then
  [ -n "$endpoint" ] || no "gh api needs an endpoint"
  case "${endpoint#/}" in graphql*) no "graphql can hold a mutation" ;; esac
  [ "$(printf %s "${method:-GET}" | tr '[:lower:]' '[:upper:]')" = GET ] || no "gh api -X $method writes"
  [ -z "$fields" ] || [ -n "$method" ] || no "fields make gh api POST; add -X GET"
fi

run=(env -i "HOME=$HOME" "USER=${USER:-}" "LANG=${LANG:-en_US.UTF-8}" PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin
  GH_PAGER=cat GH_PROMPT_DISABLED=1 GH_NO_UPDATE_NOTIFIER=1 NO_COLOR=1 gh "$@")
if [ -n "${GH_READ_DRY:-}" ]; then echo "cd / && ${run[*]}"; exit 0; fi
cd / && exec "${run[@]}"
