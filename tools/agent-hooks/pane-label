#!/usr/bin/env bash
# Names the herdr pane this agent runs in, so 요유 can tell panes apart (Claude and Codex both use it).
# The name starts with a mark (요유 2026-10-17): 🟢 요유 may close this session, 🔴 something here stops when
# it closes (a background command, a Monitor, a loop or wakeup, a session cron, a background agent).
# Claude's pane-hold.sh hook sets 🔴 by itself; going back to 🟢 is the agent's `--free`.
# No-op outside herdr. Display only: always exits 0 except on bad usage.
#   pane-label "api#736 Dependabot 정리"      set the name, keeping the mark (🟢 when there is none)
#   pane-label --hold | --free                set the mark to 🔴 / 🟢, keeping the name
#   pane-label --lead | --unlead              add / drop 👑 after the mark: 요유's lead pane (요유 2026-10-30). herdr has
#                                             no per-pane border or background colour, and the collapsed sidebar shows
#                                             no text, so the name in the pane border is the one place it can show.
#                                             Renames keep it.
#   pane-label --clear                        remove it
#   pane-label --clear-if-prefix "api#736 "   remove it only if it still names that item
#   pane-label --close                        close this pane once the agent's turn ends, only in a tab a job opened
#                                             (the dispatch job: MUNICE_AUTO_DISPATCH=1, the Slack ambient poll:
#                                             MUNICE_AMBIENT=1) or a pane `herdr agent start` opened (herdr's agent name
#                                             is set; a session started by hand has none); detached, so it outlives the
#                                             tool call. Skips a 🔴 or 👑 pane, and cancels if the agent works again within
#                                             the grace period (요유 typed a new message, or the next ambient round
#                                             arrived). An agent-started pane closes only through the Stop hook
#                                             auto-tab-close.py, which saves the report first and sets
#                                             PANE_CLOSE_REPORTED=1: its report would go with the pane
H=${HERDR_BIN_PATH:-herdr}
[ -n "${HERDR_PANE_ID:-}" ] && command -v "$H" >/dev/null 2>&1 || exit 0
HOLD=🔴
FREE=🟢
LEAD=👑

current() { "$H" pane get "$HERDR_PANE_ID" 2>/dev/null | jq -r '.result.pane.label // ""' 2>/dev/null; }
status() { "$H" pane get "$HERDR_PANE_ID" 2>/dev/null | jq -r '.result.pane.agent_status // ""' 2>/dev/null; }
agent_name() { "$H" agent get "$HERDR_PANE_ID" 2>/dev/null | jq -r '.result.agent.name // ""' 2>/dev/null; }
close_when_idle() {
  local wait=${PANE_CLOSE_WAIT:-600} grace=${PANE_CLOSE_GRACE:-20} poll=${PANE_CLOSE_POLL:-2} t0=$SECONDS
  while [ "$(status)" = working ]; do (( SECONDS - t0 < wait )) || return 0; sleep "$poll"; done
  t0=$SECONDS
  while (( SECONDS - t0 < grace )); do
    [ "$(status)" = working ] && return 0
    [ "$(mark_of "$(current)")" = "$HOLD" ] && return 0
    sleep "$poll"
  done
  [ "$(mark_of "$(current)")" = "$HOLD" ] || "$H" pane close "$HERDR_PANE_ID" >/dev/null 2>&1
}
mark_of() { case "$1" in "$HOLD"*) echo "$HOLD" ;; "$FREE"*) echo "$FREE" ;; esac; }
name_of() { local t=${1#"$HOLD"}; t=${t#"$FREE"}; echo "${t# }"; }
task_of() { local t; t=$(name_of "$1"); t=${t#"$LEAD"}; echo "${t# }"; }
is_lead() { [[ "$(name_of "$1")" == "$LEAD"* ]]; }
rename() { "$H" pane rename "$HERDR_PANE_ID" "$@" >/dev/null 2>&1; }
mark() { # mark name
  if [ -n "$2" ]; then rename "$1 $2"; else rename "$1"; fi
}
lead() { # lead|"" label: rewrite the label with or without 👑, keeping mark and task
  local m t; m=$(mark_of "$2"); t=$(task_of "$2")
  if [ -n "$1" ]; then mark "${m:-$FREE}" "$LEAD${t:+ $t}"; else mark "${m:-$FREE}" "$t"; fi
}

case "${1:-}" in
  "") echo 'usage: pane-label "<text>" | --hold | --free | --lead | --unlead | --clear | --clear-if-prefix "<prefix>" | --close' >&2; exit 2 ;;
  --clear) rename --clear ;;
  --lead) lead 1 "$(current)" ;;
  --unlead) lead "" "$(current)" ;;
  --clear-if-prefix)
    cur=$(task_of "$(current)")
    [ -n "${2:-}" ] && [[ "$cur" == "$2"* ]] && rename --clear ;;
  --hold) mark "$HOLD" "$(name_of "$(current)")" ;;
  --free) mark "$FREE" "$(name_of "$(current)")" ;;
  --close)
    # Only a tab a job opened (dispatch, Slack ambient) or a pane `herdr agent start` opened closes itself; 요유 closes the
    # sessions they started (요유 2026-10-21).
    job="${MUNICE_AUTO_DISPATCH:-}${MUNICE_AMBIENT:-}"
    if [ -z "$job" ] && [ -z "$(agent_name)" ]; then
      echo "pane-label: 요유가 연 세션이라 닫지 않음 (자동·알아서 탭과 herdr agent start로 연 칸만 닫힘)" >&2; exit 0
    fi
    if is_lead "$(current)"; then echo "pane-label: 👑 pane, not closing" >&2; exit 0; fi
    if [ -z "$job" ] && [ -z "${PANE_CLOSE_REPORTED:-}" ]; then
      echo "pane-label: 보고 끝에 '세션: 닫음'을 쓰면 Stop 훅이 보고를 남기고 닫음" >&2; exit 0
    fi
    if [ "$(mark_of "$(current)")" = "$HOLD" ]; then echo "pane-label: 🔴 pane, not closing" >&2; exit 0; fi
    # Own session so the agent's tool runner does not kill it with the command's process group.
    nohup perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' bash "$0" --close-now >/dev/null 2>&1 &
    echo "pane-label: closing this pane once the turn ends" ;;
  --close-now) close_when_idle ;;
  *)
    cur=$(current)
    m=$(mark_of "$*")
    [ -n "$m" ] || m=$(mark_of "$cur")
    if is_lead "$cur" || is_lead "$*"; then lead 1 "${m:-$FREE} $(task_of "$*")"
    else mark "${m:-$FREE}" "$(name_of "$*")"; fi ;;
esac
exit 0
