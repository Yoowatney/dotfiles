#!/usr/bin/env bash
# Names the herdr pane this agent runs in, so 요유 can tell panes apart (Claude and Codex both use it).
# The name starts with a mark (요유 2026-10-17): 🟢 요유 may close this session, 🔴 something here stops when
# it closes (a background command, a Monitor, a loop or wakeup, a session cron, a background agent).
# Claude's pane-hold.sh hook sets 🔴 by itself; going back to 🟢 is the agent's `--free`.
# No-op outside herdr. Display only: always exits 0 except on bad usage.
#   pane-label "api#736 Dependabot 정리"      set the name, keeping the mark (🟢 when there is none)
#   pane-label --hold | --free                set the mark to 🔴 / 🟢, keeping the name
#   pane-label --lead | --unlead              add / drop 👑 after the mark: 요유's lead pane (요유 2026-10-30). herdr has
#                                             no per-pane border or background colour, and the collapsed sidebar shows
#                                             no text, so the name in the pane border is the one place it can show.
#                                             Renames keep it.
#                                             🫡 sits in the same place on a pane under a lead: herdr has an agent name for
#                                             it (`herdr agent start`), it is outside the job tabs, and it is not 👑. It
#                                             comes by itself from the first name on, and marks and renames keep it.
#   pane-label --mark-subs                    add 🫡 to the panes already running; new ones need no call
#   pane-label --sync-tabs                    make every tab name follow its panes, in every running herdr session (요유
#                                             2026-10-31): `👑 ` when a pane in it is a lead, else `🫡 ` when one is under a
#                                             lead, no mark otherwise. Job tabs (자동·알아서) never get one: other code reads
#                                             those names by their first word. Every rename here runs it. launchd
#                                             (com.yoyoo.herdr-tab-marks, every 10 s) runs it for what no session sees: a pane
#                                             closed or moved, a tab renamed by hand. It polls because herdr sends no event
#                                             when a pane is renamed, so nothing could listen for a new 👑.
#   pane-label --clear                        remove it
#   pane-label --clear-if-prefix "api#736 "   remove it only if it still names that item
#   pane-label --close                        close this pane once the agent's turn ends, only in a tab a job opened
#                                             (the dispatch job: MUNICE_AUTO_DISPATCH=1, the Slack ambient poll:
#                                             MUNICE_AMBIENT=1) or a pane `herdr agent start` opened (herdr's agent name
#                                             is set; a session started by hand has none); detached, so it outlives the
#                                             tool call. Skips a 🔴 pane, and cancels if the agent works again within
#                                             the grace period (요유 typed a new message, or the next ambient round
#                                             arrived). An agent-started pane closes only through the Stop hook
#                                             auto-tab-close.py, which saves the report first, keeps a 👑 until the panes
#                                             it opened are gone, and sets PANE_CLOSE_REPORTED=1: the report would go
#                                             with the pane
H=${HERDR_BIN_PATH:-herdr}
{ [ -n "${HERDR_PANE_ID:-}" ] || [ "${1:-}" = --sync-tabs ]; } && command -v "$H" >/dev/null 2>&1 || exit 0
HOLD=🔴
FREE=🟢
LEAD=👑
SUB=🫡

current() { "$H" pane get "$HERDR_PANE_ID" 2>/dev/null | jq -r '.result.pane.label // ""' 2>/dev/null; }
status() { "$H" pane get "$HERDR_PANE_ID" 2>/dev/null | jq -r '.result.pane.agent_status // ""' 2>/dev/null; }
# HERDR_PANE_ID goes stale when a pane moves to another workspace; `pane get` still resolves it, `agent get` does not.
pane_now() { "$H" pane get "$HERDR_PANE_ID" 2>/dev/null | jq -r '.result.pane.pane_id // empty' 2>/dev/null; }
agent_name() { local id; id=$(pane_now); "$H" agent get "${id:-$HERDR_PANE_ID}" 2>/dev/null | jq -r '.result.agent.name // ""' 2>/dev/null; }
close_when_idle() {
  local wait=${PANE_CLOSE_WAIT:-600} grace=${PANE_CLOSE_GRACE:-20} poll=${PANE_CLOSE_POLL:-2} t0=$SECONDS
  while [ "$(status)" = working ]; do (( SECONDS - t0 < wait )) || return 0; sleep "$poll"; done
  t0=$SECONDS
  while (( SECONDS - t0 < grace )); do
    [ "$(status)" = working ] && return 0
    [ "$(mark_of "$(current)")" = "$HOLD" ] && return 0
    sleep "$poll"
  done
  [ "$(mark_of "$(current)")" = "$HOLD" ] || "$H" pane close "$HERDR_PANE_ID" >/dev/null 2>&1
}
mark_of() { case "$1" in "$HOLD"*) echo "$HOLD" ;; "$FREE"*) echo "$FREE" ;; esac; }
name_of() { local t=${1#"$HOLD"}; t=${t#"$FREE"}; echo "${t# }"; }
task_of() { local t; t=$(name_of "$1"); t=${t#"$LEAD"}; t=${t#"$SUB"}; echo "${t# }"; }
is_lead() { [[ "$(name_of "$1")" == "$LEAD"* ]]; }
# $1 the current label. A pane already 🫡 stays so: pane-spawn names it before herdr has its agent.
sub_of() {
  [ -z "${MUNICE_AUTO_DISPATCH:-}${MUNICE_AMBIENT:-}" ] || return 0
  if [[ "$(name_of "$1")" == "$SUB"* ]] || [ -n "$(agent_name)" ]; then echo "$SUB"; fi
}
# One herdr session, named by HERDR_SOCKET_PATH. A name 요유 changed after the list was read stays; the next run looks again.
# ponytail: a tab with no name shows its position; once marked, that number stays as a fixed name, since herdr cannot clear a
# name. No such tab holds a mark today (session.json); skip tabs whose label equals their number if one ever does.
sync_session() {
  local tabs panes id old new
  tabs=$("$H" tab list 2>/dev/null) && panes=$("$H" pane list 2>/dev/null) || return 0
  jq -rn --argjson t "$tabs" --argjson p "$panes" '
    ($p.result.panes | group_by(.tab_id)
      | map({key: .[0].tab_id, value: map((.label // "") | ltrimstr("🔴") | ltrimstr("🟢") | ltrimstr(" "))})
      | from_entries) as $names
    | $t.result.tabs[]
    | (.label | sub("^((👑|🫡) ?)+"; "")) as $base
    | ($names[.tab_id] // []) as $in
    | (if ($base | test("^(자동|알아서) ")) then ""
       elif any($in[]; startswith("👑")) then "👑 "
       elif any($in[]; startswith("🫡")) then "🫡 "
       else "" end + $base) as $want
    | select($want != .label and $want != "")
    | [.tab_id, .label, $want] | join("\u001f")' 2>/dev/null |
    while IFS=$'\x1f' read -r id old new; do
      [ "$("$H" tab get "$id" 2>/dev/null | jq -r '.result.tab.label' 2>/dev/null)" = "$old" ] || continue
      "$H" tab rename "$id" "$new" >/dev/null 2>&1
    done
}
sync_tabs() {
  local sock
  "$H" session list --json 2>/dev/null | jq -r '.sessions[] | select(.running) | .socket_path' 2>/dev/null |
    while IFS= read -r sock; do HERDR_SOCKET_PATH=$sock sync_session; done
}
rename() { "$H" pane rename "$HERDR_PANE_ID" "$@" >/dev/null 2>&1; sync_tabs; }
mark() { # mark name
  if [ -n "$2" ]; then rename "$1 $2"; else rename "$1"; fi
}
lead() { # lead|"" label: rewrite the label with or without 👑, keeping mark and task; 👑 replaces 🫡 and gives it back
  local m t s; m=$(mark_of "$2"); t=$(task_of "$2")
  if [ -n "$1" ]; then mark "${m:-$FREE}" "$LEAD${t:+ $t}"
  else s=$(sub_of "$2"); mark "${m:-$FREE}" "$s${s:+${t:+ }}$t"; fi
}

case "${1:-}" in
  "") echo 'usage: pane-label "<text>" | --hold | --free | --lead | --unlead | --mark-subs | --sync-tabs | --clear | --clear-if-prefix "<prefix>" | --close' >&2; exit 2 ;;
  --sync-tabs) sync_tabs ;;
  --clear) rename --clear ;;
  --lead) lead 1 "$(current)" ;;
  --unlead) lead "" "$(current)" ;;
  --mark-subs)
    labels=$("$H" pane list 2>/dev/null | jq -c '[.result.panes[] | {key: .pane_id, value: (.label // "")}] | from_entries')
    jobs=$("$H" tab list 2>/dev/null | jq -c '[.result.tabs[] | select((.label // "") | test("^(자동|알아서) ")) | .tab_id]')
    "$H" agent list 2>/dev/null |
      jq -r --argjson l "${labels:-{\}}" --argjson j "${jobs:-[]}" \
        '.result.agents[] | select(.name != null and (.tab_id as $t | $j | index($t) | not)) | [.pane_id, ($l[.pane_id] // "")] | @tsv' |
      while IFS=$'\t' read -r pane label; do
        case "$label" in *"$LEAD"* | *"$SUB"*) continue ;; esac
        env -u MUNICE_AUTO_DISPATCH -u MUNICE_AMBIENT HERDR_PANE_ID="$pane" bash "$0" "${label:-$FREE}"
        echo "$pane $label"
      done ;;
  --clear-if-prefix)
    cur=$(task_of "$(current)")
    [ -n "${2:-}" ] && [[ "$cur" == "$2"* ]] && rename --clear ;;
  --hold) mark "$HOLD" "$(name_of "$(current)")" ;;
  --free) mark "$FREE" "$(name_of "$(current)")" ;;
  --close)
    # Only a tab a job opened (dispatch, Slack ambient) or a pane `herdr agent start` opened closes itself; 요유 closes the
    # sessions they started (요유 2026-10-21).
    job="${MUNICE_AUTO_DISPATCH:-}${MUNICE_AMBIENT:-}"
    if [ -z "$job" ] && [ -z "$(agent_name)" ]; then
      echo "pane-label: 요유가 연 세션이라 닫지 않음 (자동·알아서 탭과 herdr agent start로 연 칸만 닫힘)" >&2; exit 0
    fi
    if [ -z "$job" ] && [ -z "${PANE_CLOSE_REPORTED:-}" ]; then
      echo "pane-label: 보고 끝에 '세션: 닫음'을 쓰면 Stop 훅이 보고를 남기고 닫음" >&2; exit 0
    fi
    if [ "$(mark_of "$(current)")" = "$HOLD" ]; then echo "pane-label: 🔴 pane, not closing" >&2; exit 0; fi
    # Own session so the agent's tool runner does not kill it with the command's process group.
    nohup perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' bash "$0" --close-now >/dev/null 2>&1 &
    echo "pane-label: closing this pane once the turn ends" ;;
  --close-now) close_when_idle ;;
  *)
    cur=$(current)
    m=$(mark_of "$*")
    [ -n "$m" ] || m=$(mark_of "$cur")
    if is_lead "$cur" || is_lead "$*"; then lead 1 "${m:-$FREE} $(task_of "$*")"
    else s=$(sub_of "$cur"); t=$(task_of "$*"); mark "${m:-$FREE}" "$s${s:+${t:+ }}$t"; fi ;;
esac
exit 0
