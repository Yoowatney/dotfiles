#!/usr/bin/env bash
# Names the herdr pane this agent runs in, so 요유 can tell panes apart (Claude and Codex both use it).
# The name starts with a mark (요유 2026-10-17): 🟢 요유 may close this session, 🔴 something here stops when
# it closes (a background command, a Monitor, a loop or wakeup, a session cron, a background agent).
# Claude's pane-hold.sh hook sets 🔴 by itself; going back to 🟢 is the agent's `--free`.
# No-op outside herdr. Display only: always exits 0 except on bad usage.
#   pane-label "api#736 Dependabot 정리"      set the name, keeping the mark (🟢 when there is none)
#   pane-label --hold | --free                set the mark to 🔴 / 🟢, keeping the name
#   pane-label --clear                        remove it
#   pane-label --clear-if-prefix "api#736 "   remove it only if it still names that item
H=${HERDR_BIN_PATH:-herdr}
[ -n "${HERDR_PANE_ID:-}" ] && command -v "$H" >/dev/null 2>&1 || exit 0
HOLD=🔴
FREE=🟢

current() { "$H" pane get "$HERDR_PANE_ID" 2>/dev/null | jq -r '.result.pane.label // ""' 2>/dev/null; }
mark_of() { case "$1" in "$HOLD"*) echo "$HOLD" ;; "$FREE"*) echo "$FREE" ;; esac; }
name_of() { local t=${1#"$HOLD"}; t=${t#"$FREE"}; echo "${t# }"; }
rename() { "$H" pane rename "$HERDR_PANE_ID" "$@" >/dev/null 2>&1; }
mark() { # mark name
  if [ -n "$2" ]; then rename "$1 $2"; else rename "$1"; fi
}

case "${1:-}" in
  "") echo 'usage: pane-label "<text>" | --hold | --free | --clear | --clear-if-prefix "<prefix>"' >&2; exit 2 ;;
  --clear) rename --clear ;;
  --clear-if-prefix)
    cur=$(name_of "$(current)")
    [ -n "${2:-}" ] && [[ "$cur" == "$2"* ]] && rename --clear ;;
  --hold) mark "$HOLD" "$(name_of "$(current)")" ;;
  --free) mark "$FREE" "$(name_of "$(current)")" ;;
  *)
    m=$(mark_of "$*")
    [ -n "$m" ] || m=$(mark_of "$(current)")
    mark "${m:-$FREE}" "$(name_of "$*")" ;;
esac
exit 0
