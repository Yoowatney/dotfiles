#!/usr/bin/env bash
# Opens an agent test pane with no herdr agent name, for the one thing pane-spawn cannot test: how a session 요유 started by
# hand behaves (the name is what tells the two apart). Every other pane comes from pane-spawn.
# A pane with no name never closes itself, and 4 of them sat idle after a test on 10/31. So this pane goes on its own: when
# its agent exits, or PANE_TEMP_TTL seconds (1 hour) after it started, whoever forgets. Nothing runs outside the pane, so
# nothing is left to die first. Label `임시 …`: yoyoo-share-guard.py sends the last report of the session that opened it back
# while one is open, and this pane has no name to say whose it is, so the opener goes in $PANE_TEMP_DIR/<its terminal id>.
#   pane-temp [--kind claude|codex] [--cwd <dir>] [--env KEY=VALUE]... "<name>" [-- <agent arguments>]
#   pane-temp --kind codex "손세션 시험" -- --model gpt-5
# Prints the new pane id. Exit 1: the agent did not start (the empty pane is removed). Exit 2: bad usage.
H=${HERDR_BIN_PATH:-herdr}
STATE=${PANE_TEMP_DIR:-$HOME/.local/state/pane-temp}
USAGE='usage: pane-temp [--kind claude|codex] [--cwd <dir>] [--env KEY=VALUE]... "<name>" [-- <agent arguments>]'
die() { echo "pane-temp: $*" >&2; exit 2; }

kind=claude cwd=$PWD envs=()
while [ $# -gt 0 ]; do
  case "$1" in
    --kind | --cwd | --env)
      [ $# -ge 2 ] || die "$USAGE"
      case "$1" in
        --kind) kind=$2 ;;
        --cwd) cwd=$2 ;;
        --env) envs+=(--env "$2") ;;
      esac
      shift 2 ;;
    --*) die "$USAGE" ;;
    *) break ;;
  esac
done
[ $# -ge 1 ] && [ -n "$1" ] || die "$USAGE"
name=$1
shift
if [ $# -gt 0 ]; then [ "$1" = -- ] || die "$USAGE"; shift; fi # an option after the name would reach the agent
case "$kind" in claude | codex) ;; *) die "$USAGE" ;; esac
[ -n "${HERDR_PANE_ID:-}" ] || die "run this inside a herdr pane"
command -v jq >/dev/null 2>&1 || die "jq not found"

caller=$("$H" pane get "$HERDR_PANE_ID") # HERDR_* go stale when a pane moves
ws=$(jq -r '.result.pane.workspace_id // empty' <<<"$caller")
[ -n "$ws" ] || die "herdr does not know this pane"
pane=$("$H" tab create --workspace "$ws" --cwd "$cwd" --label "임시 $name" ${envs[@]+"${envs[@]}"} --no-focus | jq -r '.result.root_pane.pane_id // empty')
[ -n "$pane" ] || die "herdr opened no pane"
"$H" pane rename "$pane" "🟢 임시 $name" >/dev/null
terminal=$("$H" pane get "$pane" | jq -r '.result.pane.terminal_id // empty')
if [ -n "$terminal" ] && mkdir -p "$STATE"; then
  jq -r '.result.pane.terminal_id // empty' <<<"$caller" >"$STATE/$terminal"
  find "$STATE" -type f -mtime +7 -delete 2>/dev/null
fi

# The pane's own shell runs the agent, so an alias or function applies: `claude` gets its permission flag, `codex` --no-daemon.
# Closing the pane ends the agent and the timer. It resolves its own id at the end: a move changes it.
agent=$(printf '%q ' "$kind" "$@")
umask 077
launch=$(mktemp -d "${TMPDIR:-/tmp}/pane-temp-launch.XXXXXX") || exit 1
# Bracketed terminal paste can truncate a long command. Source a private file in
# the interactive shell so aliases/functions still apply and argv never crosses
# the terminal input buffer. The marker acknowledges execution, not pane.run.
printf -v close '%q pane close "$(%q pane get "$HERDR_PANE_ID" | jq -r .result.pane.pane_id)"' "$H" "$H"
{
  printf 'if mkdir %q 2>/dev/null; then\n' "$launch/claimed"
  printf '{\n'
  printf '( sleep %q; %s ) &\n' "${PANE_TEMP_TTL:-3600}" "$close"
  printf 'touch %q\n' "$launch/started"
  printf '%s\n' "$agent"
  printf 'printf "%%s\\n" "$?" >&3\n'
  printf '%s\n' "$close"
  printf '} 3> %q\n' "$launch/status"
  printf 'fi\n'
} >"$launch/run"
printf -v run '. %q' "$launch/run"
for try in 1 2 3; do # a pane opened a moment ago may not be at its shell prompt yet; none of the closing runs until this does
  "$H" pane run "$pane" "$run" >/dev/null && break
  [ ! -e "$launch/started" ] || break # an ambiguous API error must not launch a second process
  [ "$try" != 3 ] || { "$H" pane close "$pane" >/dev/null 2>&1; rm -rf "$launch"; echo "pane-temp: $kind did not start" >&2; exit 1; }
  sleep "${PANE_TEMP_RETRY_WAIT:-3}"
done
for _ in $(seq 1 "${PANE_TEMP_START_POLLS:-300}"); do
  [ ! -e "$launch/started" ] || break
  sleep "${PANE_TEMP_POLL:-0.1}"
done
if [ ! -e "$launch/started" ]; then
  "$H" pane close "$pane" >/dev/null 2>&1
  rm -rf "$launch"
  echo "pane-temp: the shell did not execute the launch command" >&2
  exit 1
fi
sleep "${PANE_TEMP_SETTLE:-1}"
confirmed= problem= status=
# A shell acknowledgement precedes the CLI process. Wait for a detected agent or
# its exit status; otherwise a slow wrapper can hide a later argument rejection.
for _ in $(seq 1 "${PANE_TEMP_AGENT_POLLS:-100}"); do
  screen=$("$H" agent read "$pane" --source visible 2>/dev/null)
  if printf '%s\n' "$screen" | grep -Eiq 'hook(s)? need(s)? review|review (new|changed|untrusted) hooks|do you trust|trust (the contents|this (directory|folder|workspace))'; then
    problem='the agent is waiting for startup trust or hook review'; break
  fi
  status=$(cat "$launch/status" 2>/dev/null)
  [ -z "$status" ] || break
  if "$H" pane get "$pane" 2>/dev/null | jq -e --arg kind "$kind" '.result.pane | .agent == $kind and (.agent_status == "idle" or .agent_status == "working" or .agent_status == "done")' >/dev/null; then
    confirmed=1; break
  fi
  sleep "${PANE_TEMP_AGENT_POLL:-0.1}"
done
rm -rf "$launch" # the sourced block is parsed and fd 3 still records a later exit
if [ -n "$problem" ]; then
  "$H" pane close "$pane" >/dev/null 2>&1
  echo "pane-temp: $problem" >&2
  exit 1
fi
if [ -n "$status" ] && [ "$status" != 0 ]; then
  "$H" pane close "$pane" >/dev/null 2>&1
  echo "pane-temp: $kind exited during startup (status $status)" >&2
  exit 1
fi
if [ -z "$confirmed$status" ]; then
  "$H" pane close "$pane" >/dev/null 2>&1
  echo "pane-temp: agent startup was not confirmed" >&2
  exit 1
fi
echo "$pane"
