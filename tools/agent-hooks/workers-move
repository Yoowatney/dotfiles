def state_root(env) -> str:
    return os.path.join(env.get("XDG_STATE_HOME") or os.path.join(env.get("HOME") or os.path.expanduser("~"), ".local", "state"), "workers-move")


def path(env, name) -> str:
    return os.path.join(state_root(env), name)


def report_dir(env) -> str:
    return env.get("PANE_REPORT_DIR") or os.path.join(env.get("HOME") or os.path.expanduser("~"), ".local", "state", "pane-reports")


def log(env, text):
    os.makedirs(state_root(env), exist_ok=True)
    with open(path(env, "run.log"), "a", encoding="utf-8") as f:
        f.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {text}\n")


def load(env, name, default):
    try:
        with open(path(env, name), encoding="utf-8") as f:
            data = json.load(f)
        return data if isinstance(data, type(default)) else default
    except (OSError, ValueError):
        return default


def save(env, name, data):
    os.makedirs(state_root(env), exist_ok=True)
    tmp = path(env, name) + f".{os.getpid()}.tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=1)
    os.replace(tmp, path(env, name))


def locked(env, name):
    """The open lock file, or None when another run holds it."""
    os.makedirs(state_root(env), exist_ok=True)
    f = open(path(env, name), "a")
    try:
        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return f
    except OSError:
        f.close()
        return None


def remote_host(env) -> str:
    if env.get("WORKERS_MOVE_REMOTE"):
        return env["WORKERS_MOVE_REMOTE"]
    try:
        with open(os.path.join(env.get("HOME") or os.path.expanduser("~"), ".config", "herdr", "remote-host")) as f:
            return f.readline().strip()
    except OSError:
        return ""


def remote(env, op, timeout=120, **args) -> dict | None:
    """One op of REMOTE on 집맥; None when ssh failed or its answer is unreadable (the op may have run)."""
    host = remote_host(env)
    if not host:
        return None
    ssh = shlex.split(env["WORKERS_MOVE_SSH"]) if env.get("WORKERS_MOVE_SSH") else [
        "ssh", "-o", "ConnectTimeout=5", "-o", "BatchMode=yes", "-o", "ServerAliveInterval=5", "-o", "ServerAliveCountMax=3"]
    # ASCII only: a non-interactive ssh shell may have no UTF-8 locale for argv
    cmd = ssh + [host, "/usr/bin/python3 -I - " + shlex.quote(json.dumps(dict(args, op=op)))]
    try:
        r = subprocess.run(cmd, input=REMOTE, capture_output=True, text=True, timeout=timeout)
        return json.loads(r.stdout.strip().splitlines()[-1]) if r.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired, ValueError, IndexError):
        return None


def clean_env(env) -> dict:
    """launchd's view: a run started from the main pane must not count as that pane (pane-tell refuses telling itself)."""
    return {k: v for k, v in env.items() if not k.startswith("HERDR_") or k == "HERDR_BIN_PATH"}


def tell(env, address, text) -> bool:
    try:
        return subprocess.run([env.get("WORKERS_MOVE_TELL") or os.path.join(HERE, "pane-tell"), address, text], env=clean_env(env),
                              timeout=30, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def main_pane(env):
    """(address, pane) of the main pane, or ("", {})."""
    return (herdr_peers.all_panes(clean_env(env)) or {}).get(herdr_peers.main_terminal(env)) or ("", {})


def plain_label(label) -> str:
    return re.sub(r"^[🟢🔴👑🫡\s]+", "", label or "").strip()


def candidates(env) -> list | None:
    """The main pane's panes on workers, check panes left out; None when workers or the main pane cannot be read."""
    main = herdr_peers.main_terminal(env)
    sock = herdr_peers.socket_of(env, "workers")
    if not main or not sock:
        return None
    agents = herdr_peers.herdr(env, "agent", "list", socket=sock).get("agents")
    panes = herdr_peers.herdr(env, "pane", "list", socket=sock).get("panes")
    if agents is None or panes is None:
        return None
    by_pane = {p.get("pane_id"): p for p in panes}
    prefix = f"spawn-{main[len('term_'):]}-"
    found = []
    for a in agents:
        name = a.get("name") or ""
        if not name.startswith(prefix) or name[len(prefix):].startswith("chk"):
            continue
        p = by_pane.get(a.get("pane_id"), {})
        term = a.get("terminal_id") or p.get("terminal_id")
        if not term:
            continue
        found.append({"terminal": term, "pane": a.get("pane_id"), "agent": name, "kind": a.get("agent") or "claude",
                      "session": (a.get("agent_session") or {}).get("value") or "", "label": p.get("label") or name,
                      "cwd": a.get("foreground_cwd") or a.get("cwd") or p.get("cwd") or "", "status": a.get("agent_status")})
    return found


def transcript(env, session) -> str:
    home = env.get("HOME") or os.path.expanduser("~")
    found = (glob.glob(f"{home}/.claude/projects/*/{glob.escape(session)}.jsonl")
             + glob.glob(f"{home}/.codex/sessions/*/*/*/rollout-*-{glob.escape(session)}.jsonl")) if session else []
    return found[0] if found else ""


def first_prompt(file) -> str:
    """The pane's instruction: the first prompt in its Claude transcript or Codex log."""
    try:
        with open(file, encoding="utf-8") as f:
            for line in f:
                e = json.loads(line)
                if e.get("type") == "user" and not e.get("isMeta") and isinstance((e.get("message") or {}).get("content"), str):
                    return e["message"]["content"].strip()
                p = e.get("payload") or {}
                if p.get("type") == "message" and p.get("role") == "user":
                    text = "".join(c.get("text", "") for c in p.get("content") or [] if isinstance(c, dict))
                    if text and not text.startswith(("# AGENTS.md", "<")):
                        return text.strip()
    except (OSError, ValueError):
        pass
    return ""


def parse_memo(text) -> tuple:
    """(move, why, folder) from a handoff note; move is None when the reply holds no note."""
    plain = (text or "").replace("**", "").replace("`", "")
    m = re.search(re.escape(MARK) + r"[ \t]*(옮기지[ \t]*않음|옮김)[ \t]*[:：]?[ \t]*([^\n]*)", plain)
    if not m:
        return None, "", ""
    folder = re.search(r"^\s*[-*]?\s*폴더\s*[:：]\s*(/\S+)", plain, re.M)
    return m[1] == "옮김", m[2].strip(), folder[1].rstrip(".,)") if folder else ""


def git(top, *args, timeout=60) -> tuple:
    try:
        r = subprocess.run(["git", "-C", top, *args], capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout.strip(), r.stderr.strip()
    except (OSError, subprocess.TimeoutExpired) as e:
        return 1, "", str(e)


def git_state(folder) -> dict:
    """Can the work in folder go to 집맥 as it is? ok, why, and for a git folder top, main_tree, branch, push, synced."""
    if not os.path.isdir(folder):
        return {"ok": False, "why": f"{folder} 폴더가 없습니다"}
    rc, top, _ = git(folder, "rev-parse", "--show-toplevel")
    if rc:
        return {"ok": True, "git": False}
    if git(top, "status", "--porcelain")[1]:
        return {"ok": False, "why": f"{top}에 커밋하지 않은 변경이 있습니다"}
    branch = git(top, "symbolic-ref", "--short", "-q", "HEAD")[1]
    if not branch:
        return {"ok": False, "why": f"{top}이 분리된 HEAD입니다"}
    main_tree = os.path.dirname(git(top, "rev-parse", "--path-format=absolute", "--git-common-dir")[1].rstrip("/"))
    default = git(top, "symbolic-ref", "--short", "-q", "refs/remotes/origin/HEAD")[1].split("/", 1)[-1] or "main"
    upstream = git(top, "rev-parse", "--abbrev-ref", "-q", "@{u}")[0] == 0
    ahead = int(git(top, "rev-list", "--count", "@{u}..HEAD")[1] or 0) if upstream else None
    state = {"ok": True, "git": True, "top": top, "main_tree": main_tree, "branch": branch, "push": False,
             "synced": any(os.path.realpath(top) == os.path.realpath(os.path.expanduser(s)) for s in SYNCED)}
    if branch == default:
        if not upstream or ahead:
            return {"ok": False, "why": f"{top}의 기본 브랜치 {branch}에 push하지 않은 커밋이 있습니다"}
        return state
    if os.path.realpath(top) == os.path.realpath(main_tree):
        return {"ok": False, "why": f"{top} 원본 체크아웃에서 {branch} 브랜치 작업 중입니다(집맥은 원본의 브랜치를 바꾸지 않습니다)"}
    return dict(state, push=not upstream or bool(ahead))


def mark(env, kind, key, on=True):
    """`moving` (auto-tab-close sends the pane's reply nowhere) or `reported` (workers-watch hears nothing more of it)."""
    if not key:
        return
    p = os.path.join(herdr_peers.state_dir(env), kind, key)
    if not on:
        try:
            os.unlink(p)
        except OSError:
            pass
        return
    os.makedirs(os.path.dirname(p), exist_ok=True)
    with open(p, "a"):
        os.utime(p)


def settle(env, moves, rec, step, why=""):
    """A pane that stays here: its note was its report, and its reply goes to its lead again."""
    rec.update(step=step, reason=why)
    if step != "skipped":
        mark(env, "reported", rec["terminal"]), mark(env, "reported", rec["session"])
    mark(env, "moving", rec["terminal"], on=False)
    save(env, "moves.json", moves)


def note(env, rec, memo, g) -> str:
    where = f"폴더: {rec['folder']}" + (f", 브랜치: {g['branch']} (push됨)" if g.get("git") else "")
    return (f"# 퇴근 인계: {plain_label(rec['label'])}\n\n회사맥 칸: workers/{rec['pane']} ({rec['agent']}), 세션 {rec['session']}, "
            f"넘긴 때 {datetime.datetime.now():%m-%d %H:%M}\n{where}\n\n## 원래 지시\n\n"
            f"{first_prompt(transcript(env, rec['session'])) or '(기록에서 찾지 못했습니다)'}\n\n## 인계 메모\n\n{memo.strip()}\n")


def instruction(rec, g, made) -> str:
    text = (f"[퇴근 인계] 회사맥 칸 '{plain_label(rec['label'])}'이 요유 퇴근 때 넘긴 일을 집맥에서 이어 갑니다. 먼저 {{memo}}를 Read로 끝까지 "
            f"읽으세요. 원래 지시와 인계 메모가 들어 있습니다. 폴더는 {rec['folder']}"
            + (f"이고 브랜치 {g['branch']}가 push되어 있습니다. " if g.get("git") else "입니다. ")
            + "집맥에는 브라우저(ego)가 없고 요유 계정이 필요한 GCP 단계도 할 수 없으니, 그런 단계가 나오면 멈추고 보고하세요. "
            "~/.claude, ~/.codex, ~/.dotfiles, munice-claude 원본 같은 전역 설정과 메모리는 고치지 마세요: 집맥은 회사맥에서 복사받습니다. "
            "Slack 스레드는 감시하지 마세요: 퇴근하는 동안 Slack 스레드는 집맥 ambient가 맡습니다.")
    if g.get("synced"):
        text += " 이 폴더는 집맥이 3분마다 pull하는 원본 체크아웃이니 커밋하거나 파일을 고치지 마세요. 고칠 일이면 워크트리를 따로 만드세요."
    if made:
        text += " 이 폴더는 집맥에 새로 만든 워크트리라 node_modules, .env 같은 git 밖 파일이 없을 수 있습니다."
    return text


def claude_trusts(env, key) -> bool:
    """Has Claude on this Mac been told to trust key (a repo's main tree, or a folder outside git)?"""
    try:
        with open(os.path.join(env.get("HOME") or os.path.expanduser("~"), ".claude.json"), encoding="utf-8") as f:
            return bool(((json.load(f).get("projects") or {}).get(key) or {}).get("hasTrustDialogAccepted"))
    except (OSError, ValueError, AttributeError):
        return False


def move_one(env, moves, rec, memo, agents_now) -> None:
    """Steps 2-4 for one pane whose note arrived. Each outcome is saved before the next step."""
    go, why, folder = parse_memo(memo)
    if not go:
        return settle(env, moves, rec, "kept", why or "칸이 옮기지 않기로 했습니다")
    if any(herdr_peers.opener(a.get("name")) == rec["terminal"] for a in agents_now):
        return settle(env, moves, rec, "kept", "이 칸이 연 칸이 아직 열려 있습니다")
    rec["folder"] = folder or rec["cwd"]
    g = git_state(rec["folder"])
    if not g["ok"]:
        return settle(env, moves, rec, "kept", g["why"])
    if g.get("push"):
        rc, _, err = git(g["top"], "push", "-q", "-u", "origin", "HEAD", timeout=180)
        if rc:
            return settle(env, moves, rec, "kept", f"push하지 못했습니다: {err[-300:]}")
    p = remote(env, "prepare", folder=rec["folder"], top=g.get("top"), main_tree=g.get("main_tree"), branch=g.get("branch"))
    if not p or not p.get("ok"):
        return settle(env, moves, rec, "kept", (p or {}).get("why") or "집맥에 닿지 못했습니다")
    rec.update(step="opening", top=g.get("top"), branch=g.get("branch"), git=bool(g.get("git")))
    save(env, "moves.json", moves)
    o = remote(env, "open", timeout=900, agent=rec["agent"], memo=note(env, rec, memo, g), opener=herdr_peers.main_terminal(env),
               folder=rec["folder"], name=f"{plain_label(rec['label'])} (집맥)", prompt=instruction(rec, g, p.get("made")),
               main_tree=g.get("main_tree") or rec["folder"], trust=claude_trusts(env, g.get("main_tree") or rec["folder"]))
    if o is None or o.get("unknown"):  # it may have opened: never a second pane, never the same work here too
        return settle(env, moves, rec, "unknown", "집맥 칸을 여는 도중 ssh가 끊겼습니다. 집맥 workers 서버에 그 칸이 있는지 보세요")
    if not o.get("ok"):
        return settle(env, moves, rec, "kept", f"집맥 칸을 열지 못했습니다: {o.get('why')}")
    rec.update(step="opened", remote=o["address"], remote_kind=o.get("kind"), memo=o.get("memo"), warn=o.get("warn") or "",
               start=o.get("start"), opened_at=time.time())
    save(env, "moves.json", moves)
    close_local(env, moves, rec)


def close_local(env, moves, rec):
    mark(env, "reported", rec["terminal"]), mark(env, "reported", rec["session"])
    herdr_peers.herdr(env, "pane", "close", rec["pane"], socket=herdr_peers.socket_of(env, "workers"))  # fails open: no answer to check
    rec["step"] = "moved"
    mark(env, "moving", rec["terminal"], on=False)
    save(env, "moves.json", moves)


def summary(moves, keys) -> str:
    moved = [moves[k] for k in keys if moves[k].get("step") in ("opened", "moved")]
    kept = [moves[k] for k in keys if moves[k].get("step") not in ("opened", "moved")]
    lines = [f"[퇴근 인계] 끝났습니다. 집맥으로 넘긴 칸 {len(moved)}개, 회사맥에 둔 칸 {len(kept)}개."]
    lines += [f"- 넘김: {plain_label(m['label'])}(workers/{m['pane']}) → 집맥 {m['remote']} ({m.get('remote_kind')})"
              + (f" 주의: {m['warn']}" if m.get("warn") else "") for m in moved]
    lines += [f"- 둠: {plain_label(m['label'])}(workers/{m['pane']}): {m.get('reason') or m.get('step')}" for m in kept]
    if moved:
        lines.append("집맥 칸의 보고와 알림은 회사맥이 깨어 있을 때 1분 안에 이 칸에 옵니다. 집맥 칸에 답하기: "
                     "`workers-move tell <집맥 칸 id> \"<글>\"`, 화면 보기: `workers-move read <집맥 칸 id>`.")
    if kept:
        lines.append("회사맥에 둔 칸은 인계 메모를 쓰고 멈춰 있습니다. 출근 뒤 `workers-move resume`으로 이어 가게 하세요.")
    return "\n".join(lines)


def run(env) -> int:
    lock = locked(env, "run.lock")
    if not lock:
        print("workers-move: 이미 도는 중입니다")
        return 0
    addr = main_pane(env)[0]

    def say(text):
        log(env, text.replace("\n", " / "))
        print(text)
        if addr:
            tell(env, addr, text)

    check = remote(env, "check", timeout=60)
    if not check or not check.get("workers"):
        say("[퇴근 인계] 집맥에 닿지 못했거나 집맥 workers 서버를 켜지 못해 아무 칸도 넘기지 않았습니다. 회사맥 칸은 그대로입니다.")
        return 1
    found = candidates(env)
    if found is None:
        say("[퇴근 인계] 메인 칸이나 workers 서버의 칸 목록을 읽지 못해 아무 칸도 넘기지 않았습니다.")
        return 1
    moves = load(env, "moves.json", {})
    keys = []
    now = time.time()
    for c in found:
        key, old = c["terminal"], moves.get(c["terminal"]) or {}
        keys.append(key)
        if old.get("step") in ("opened", "moved") and old.get("agent") == c["agent"]:
            old["pane"] = c["pane"]  # its 집맥 pane is open: this pane's close was left, or did not take
            close_local(env, moves, old)
        elif old.get("step") == "opening":  # a run died while it opened one
            settle(env, moves, old, "unknown", "지난 실행이 집맥 칸을 여는 도중 멈췄습니다. 집맥 workers 서버에 그 칸이 있는지 보세요")
        elif old.get("step") == "unknown":
            pass  # never asked again: its work may be running on 집맥 (Codex review)
        elif old.get("step") == "asked" and now - old.get("asked_at", 0) < WAIT:
            pass  # a run cut short asked it already
        else:
            rec = moves[key] = {k: v for k, v in c.items() if k != "status"}
            rec.update(step="asked", asked_at=now)
            if c["status"] == "blocked":
                settle(env, moves, rec, "skipped", "질문 창에서 멈춰 있어 인계 요청을 넣지 않았습니다")
                continue
            mark(env, "moving", key)
            if not tell(env, f"workers/{c['pane']}", ASK):
                settle(env, moves, rec, "skipped", "인계 요청을 칸에 넣지 못했습니다")
    save(env, "moves.json", moves)
    if not keys:
        say("[퇴근 인계] 넘길 밑 칸이 없습니다.")
        return 0
    poll = float(env.get("WORKERS_MOVE_POLL") or POLL)
    deadline, last = time.time() + float(env.get("WORKERS_MOVE_WAIT") or WAIT), time.time()
    try:
        while waiting := [k for k in keys if moves[k].get("step") == "asked"]:
            if time.time() - last > poll + float(env.get("WORKERS_MOVE_SLEPT") or SLEPT):  # the lid closed during the wait: at 출근 nothing goes to 집맥 (Claude review)
                for k in waiting:
                    settle(env, moves, moves[k], "kept", "기다리는 동안 회사맥이 잠들어 옮기지 않았습니다")
                break
            listed = herdr_peers.herdr(env, "agent", "list", socket=herdr_peers.socket_of(env, "workers")).get("agents")
            by_pane = {a.get("pane_id"): a for a in listed or []}
            for k in waiting if listed is not None else []:
                rec = moves[k]
                try:
                    a = by_pane.get(rec["pane"])
                    if a is None:
                        settle(env, moves, rec, "kept", "인계 메모를 쓰기 전에 칸이 사라졌습니다")
                        continue
                    t = transcript(env, rec["session"])
                    if a.get("agent_status") not in ("idle", "done") or not t or os.path.getmtime(t) < rec["asked_at"]:
                        continue
                    memo = atc.last_reply(rec["session"], env.get("HOME") or "")
                    if MARK in memo:
                        move_one(env, moves, rec, memo, listed)
                except Exception as error:  # noqa: BLE001 - one pane's trouble stops no other
                    if rec.get("step") in ("asked", "opening"):
                        settle(env, moves, rec, "unknown" if rec["step"] == "opening" else "kept", f"오류: {error!r}"[:300])
            if time.time() >= deadline:
                for k in waiting:
                    if moves[k].get("step") == "asked":
                        settle(env, moves, moves[k], "kept", "기다리는 동안 인계 메모가 오지 않았습니다")
                break
            last = time.time()
            time.sleep(poll)
    finally:
        for k in keys:
            if moves[k].get("step") == "asked":
                mark(env, "moving", k, on=False)
    text = summary(moves, keys)
    with open(path(env, "last-summary.txt"), "w", encoding="utf-8") as f:
        f.write(text + "\n")
    say(text)
    return 0


def split_entries(text):
    heads = list(ENTRY.finditer(text))
    for i, m in enumerate(heads):
        yield m[1], m[2], m[3] or "", text[m.end():heads[i + 1].start() if i + 1 < len(heads) else len(text)].strip("\n")


def fast_forward(rec) -> str:
    """Bring the 회사맥 folder to what the 집맥 pane pushed, since the check runs here; "" when done, else why not."""
    if not rec.get("git"):
        return ""
    top, branch = rec["top"], rec["branch"]
    if not os.path.isdir(top):
        return f"회사맥에 {top} 폴더가 없습니다"
    cur = git(top, "symbolic-ref", "--short", "-q", "HEAD")[1]
    if cur != branch:
        return f"회사맥의 {top}이 {cur + ' 브랜치' if cur else '분리된 HEAD'}에 있습니다"
    if git(top, "status", "--porcelain")[1]:
        return f"회사맥의 {top}에 커밋하지 않은 변경이 있습니다"
    rc, _, err = git(top, "fetch", "-q", "origin", branch, timeout=120)
    if not rc:
        rc, _, err = git(top, "merge", "--ff-only", "-q", f"origin/{branch}")
    return f"회사맥의 {top}를 집맥이 push한 {branch}에 맞추지 못했습니다: {err[-200:]}" if rc else ""


def deliver(env, rec, item, main, ffs) -> bool:
    addr, to = main
    pane = rec["remote"].split("/", 1)[-1]
    cenv = clean_env(env)
    file = os.path.join(report_dir(env), item["day"] + ".md")
    at = f"{item['time']} 항목"
    where = f"칸: 집맥:{rec['remote']} {plain_label(rec['label'])} (집맥)"
    hint = f"집맥 칸입니다. 답은 `workers-move tell {pane} \"<글>\"`, 화면은 `workers-move read {pane}`로 봅니다."

    def send(message):
        return tell(env, addr, f"{message}\n{hint}")

    if item["text"].startswith("[workers-watch]"):
        return send(f"집맥 칸 알림입니다. {item['text'][len('[workers-watch]'):].strip()}\n{where}\n전체: {file} ({at})")
    m = SESSION_LINE.match(item["text"])
    reply = item["text"][m.end():] if m else item["text"]
    if rec["key"] not in ffs:
        ffs[rec["key"]] = fast_forward(rec)
    if ffs[rec["key"]]:
        return send(f"바로 전달하는 칸의 보고입니다(확인 칸을 열지 않습니다: {ffs[rec['key']]}).\n"
                    f"{atc.short_report(reply, None)}\n{where}\n전체 보고: {file} ({at})")
    me = {"pane_id": f"집맥:{rec['remote']}", "terminal_id": f"집맥:{rec['remote']}", "label": f"{rec['label']} (집맥)",
          "agent_session": {"value": m[1] if m else ""}, "cwd": rec["folder"]}
    now = datetime.datetime.strptime(f"{item['day']} {item['time']}", "%Y-%m-%d %H:%M:%S")
    try:
        routed = atc.route_main_report(reply, me, rec["agent"], addr, to, file, now, cenv, send)
    except (OSError, ValueError, KeyError) as error:
        return send(f"바로 전달하는 칸의 보고입니다(확인 자동 연결 실패). {error}\n{atc.short_report(reply, None)}\n{where}\n전체 보고: {file} ({at})")
    if routed is None:
        return send(f"이 칸의 보고입니다(집맥). {atc.share.RELAY_NOTE}:\n{atc.short_report(reply)}\n{where}\n전체 보고: {file} ({at})")
    return routed


def running(env) -> bool:
    """A go or resume run holds run.lock."""
    lock = locked(env, "run.lock")
    if lock:
        lock.close()
    return not lock


def placed(moves) -> set:
    return {k for k, r in moves.items() if r.get("step") in ("opening", "opened", "moved")}


def bridge(env) -> int:
    lock = locked(env, "bridge.lock")
    if not lock:
        return 0
    moves = load(env, "moves.json", {})
    b = load(env, "bridge.json", {})
    offsets, queue, done, gone = (b.setdefault(k, d) for k, d in (("offsets", {}), ("queue", []), ("done", []), ("gone", {})))
    active = {k: dict(r, key=k) for k, r in moves.items() if r.get("step") in ("opened", "moved") and r.get("remote") and k not in done}
    if not active and not queue:
        return 0
    if active:
        today = datetime.date.today()
        for r in active.values():
            day0, size0 = r.get("start") or [today.isoformat(), 0]
            offsets.setdefault(f"{day0}.md", size0)
            d = datetime.date.fromisoformat(day0)
            while (d := d + datetime.timedelta(days=1)) <= today:
                offsets.setdefault(f"{d.isoformat()}.md", 0)
        wanted = {f"{(today - datetime.timedelta(days=n)).isoformat()}.md" for n in range(8)}
        os.makedirs(report_dir(env), exist_ok=True)
        got = None
        # A pane being opened on 집맥 has no address saved yet: what it writes now would be read past and lost (Codex review)
        if not (running(env) and any(r.get("step") == "opening" for r in moves.values())):
            got = remote(env, "bridge", timeout=60, files={f: o for f, o in offsets.items() if f in wanted})
            if got and placed(load(env, "moves.json", {})) != placed(moves):
                got = None  # a move went on during the read: read again next minute
        if got:
            by_addr = {r["remote"]: k for k, r in active.items()}
            for name, chunk in sorted((got.get("chunks") or {}).items()):
                day = name[:-3]
                with open(os.path.join(report_dir(env), name), "a", encoding="utf-8") as copy:
                    for at, addr, label, body in split_entries(chunk["text"]):
                        if addr in by_addr:
                            copy.write(f"\n## {at} 집맥:{addr} {label}\n\n{body}\n")
                            queue.append({"key": by_addr[addr], "day": day, "time": at, "text": body})
                offsets[name] = offsets.get(name, 0) + chunk["bytes"]
            panes = got.get("panes")
            for k, r in active.items():
                if panes is None or r["remote"].split("/", 1)[-1] in panes:
                    gone.pop(k, None)
                else:
                    gone.setdefault(k, time.time())
        save(env, "bridge.json", b)
    main = main_pane(env)
    ffs: dict = {}
    while queue and main[0]:
        item = queue[0]
        rec = active.get(item["key"]) or dict(moves.get(item["key"]) or {}, key=item["key"])
        if rec.get("remote") and not deliver(env, rec, item, main, ffs):
            break  # in order: the next minute tries this one first
        queue.pop(0)
        save(env, "bridge.json", b)
    # gone for a minute, and this minute read every entry to the end: its last one, written as it closed, is in the queue
    for k in active if got and not got.get("held") else []:
        if k in gone and time.time() - gone[k] >= GONE and not any(i["key"] == k for i in queue):
            done.append(k)
            gone.pop(k)
    save(env, "bridge.json", b)
    return 0


def resume(env) -> int:
    lock = locked(env, "run.lock")
    if not lock:
        print("workers-move: go가 도는 중입니다")
        return 1
    moves = load(env, "moves.json", {})
    here = {c["terminal"] for c in candidates(env) or []}
    told = []
    for k, rec in moves.items():
        if rec.get("step") == "kept" and k in here and tell(env, f"workers/{rec['pane']}", RESUME):
            rec["step"] = "resumed"
            told.append(plain_label(rec["label"]))
    save(env, "moves.json", moves)
    print(f"workers-move: 이어 가라고 한 칸 {len(told)}개" + (": " + ", ".join(told) if told else ""))
    return 0


def remote_pane_id(text) -> str:
    return re.sub(r"^(?:집맥:)?(?:workers/)?", "", text or "")


def main(argv, env) -> int:
    cmd = argv[1] if len(argv) > 1 else ""
    if cmd == "--selftest":
        return selftest()
    if cmd == "go":
        if env.get("WORKERS_MOVE_FG"):
            return run(env)
        os.makedirs(state_root(env), exist_ok=True)
        with open(path(env, "run.log"), "a") as out:
            me = os.path.realpath(__file__)
            try:  # caffeinate -i: idle sleep waits for the notes; a closed lid still sleeps
                subprocess.Popen(["/usr/bin/caffeinate", "-i", me, "run"], env=clean_env(env), stdin=subprocess.DEVNULL, stdout=out,
                                 stderr=out, start_new_session=True)
            except OSError:
                subprocess.Popen([me, "run"], env=clean_env(env), stdin=subprocess.DEVNULL, stdout=out, stderr=out, start_new_session=True)
        print(f"workers-move: 시작했습니다. 칸마다 인계 메모를 기다리고(최대 {int(float(env.get('WORKERS_MOVE_WAIT') or WAIT)) // 60}분), "
              f"요약은 이 칸에 pane-tell로 옵니다. 기록: {path(env, 'run.log')}")
        return 0
    if cmd == "run":
        return run(env)
    if cmd == "list":
        found = candidates(env)
        if found is None:
            print("workers-move: 메인 칸이나 workers 서버의 칸 목록을 읽지 못했습니다")
            return 1
        for c in found:
            print(f"workers/{c['pane']}\t{c['status']}\t{c['kind']}\t{plain_label(c['label'])}\t{c['cwd']}")
        return 0
    if cmd == "bridge":
        return bridge(env)
    if cmd == "resume":
        return resume(env)
    if cmd == "tell" and len(argv) == 4:
        r = remote(env, "tell", timeout=60, pane=remote_pane_id(argv[2]), text=argv[3])
        print("workers-move: 넣었습니다" if r and r.get("ok") else f"workers-move: 넣지 못했습니다: {(r or {}).get('why') or 'ssh 실패'}")
        return 0 if r and r.get("ok") else 1
    if cmd == "read" and len(argv) == 3:
        r = remote(env, "read", timeout=30, pane=remote_pane_id(argv[2]))
        print((r or {}).get("screen") or "workers-move: 읽지 못했습니다")
        return 0 if r and r.get("ok") else 1
    print(__doc__.split("\n\n")[1])
    return 2


