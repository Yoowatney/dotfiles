#!/usr/bin/env python3
"""Local subscription quota routing. Never requests credentials or buys credits."""
import datetime as dt
import fcntl
import hashlib
import json
import math
import os
from pathlib import Path
import platform
import sys
import tempfile
import time
import tomllib

WEEK = 604800
MAX_AGE = 600
FUTURE_SLOP = 5  # A rollout can grow while the scan is in progress.
DECISION_BYTES = 1048576


def read_json(path):
    try:
        value = json.loads(path.read_text())
        return value if isinstance(value, dict) else {}
    except (OSError, ValueError):
        return {}


def state_dir():
    return Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))) / "agent-quota"


def machine():
    return hashlib.sha256(platform.node().encode()).hexdigest()


def identity(value):
    return hashlib.sha256(value.encode()).hexdigest() if isinstance(value, str) and value else None


def claude_account():
    config = Path(os.environ.get("CLAUDE_CONFIG_DIR", str(Path.home() / ".claude")))
    # Claude uses ~/.claude.json, or $CLAUDE_CONFIG_DIR/.claude.json for a custom directory.
    path = Path.home() / ".claude.json" if config == Path.home() / ".claude" else config / ".claude.json"
    account = read_json(path).get("oauthAccount", {})
    return account if isinstance(account, dict) else {}


def epoch(value):
    try:
        if isinstance(value, str):
            value = dt.datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()
        return float(value) if isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value) else None
    except (ValueError, OverflowError):
        return None


def percentage(value):
    return epoch(value) if isinstance(value, (int, float)) and not isinstance(value, bool) and 0 <= value <= 100 else None


def private_write(path, data):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd, name = tempfile.mkstemp(dir=path.parent)
    try:
        with os.fdopen(fd, "w") as stream:
            json.dump(data, stream, allow_nan=False)
        os.replace(name, path)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def capture_claude(data, now):
    limits = data.get("rate_limits")
    tick = data.get("cost", {}).get("total_api_duration_ms")
    sid = data.get("session_id")
    account = claude_account()
    account_id = identity(account.get("accountUuid"))
    if not isinstance(limits, dict) or not account_id or not isinstance(sid, str) or not percentage_tick(tick):
        return
    # An initial repaint can describe an idle session. Use its actual assistant response time.
    response_at = None
    try:
        with Path(data["transcript_path"]).open("rb") as stream:
            stream.seek(max(0, stream.seek(0, 2) - 262144))
            for line in stream.read().splitlines():
                try:
                    event = json.loads(line)
                    at = epoch(event.get("timestamp"))
                    if event.get("type") == "assistant" and at is not None:
                        response_at = max(response_at or at, at)
                except (ValueError, AttributeError):
                    continue
    except (OSError, KeyError, TypeError):
        return
    if response_at is None or not 0 <= now - response_at <= MAX_AGE:
        return
    folder = state_dir()
    folder.mkdir(parents=True, exist_ok=True, mode=0o700)
    # Serialize repaint watermarks across simultaneous statusline invocations.
    fd = os.open(folder / "capture.lock", os.O_CREAT | os.O_RDWR, 0o600)
    with os.fdopen(fd, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        watermark = folder / ("session-" + identity(sid) + ".json")
        last = read_json(watermark)
        if last.get("account") == account_id and last.get("tick", -1) >= tick:
            return
        private_write(watermark, {"account": account_id, "tick": tick})
        record = {"account": account_id, "machine": machine(), "observed_at": response_at,
                  "five_hour": limits.get("five_hour"), "seven_day": limits.get("seven_day")}
        previous_at = epoch(read_json(folder / "claude.json").get("observed_at"))
        if previous_at is None or previous_at <= response_at:
            private_write(folder / "claude.json", record)


def percentage_tick(value):
    return isinstance(value, (float, int)) and not isinstance(value, bool) and math.isfinite(value) and value > 0


def latest_codex(now, display=False):
    root = Path(os.environ.get("CODEX_HOME", str(Path.home() / ".codex")))
    newest = None
    paths = []
    for path in (root / "sessions").glob("**/*.jsonl"):
        try:
            modified = path.stat().st_mtime
            if modified >= now - 8 * 86400:
                paths.append((modified, path))
        except OSError:
            continue
    # The display may omit archives; admission always checks all recent rollouts.
    if display:
        paths = sorted(paths, reverse=True)[:5]
    for _, path in paths:
        try:
            if path.stat().st_mtime < now - 8 * 86400:
                continue
            # The last token_count is near the end; bound I/O per active session.
            with path.open("rb") as stream:
                stream.seek(max(0, path.stat().st_size - 262144))
                lines = stream.read().splitlines()
            for line in lines:
                try:
                    row = json.loads(line)
                    payload = row.get("payload", {})
                    limits = payload.get("rate_limits")
                    at = epoch(row.get("timestamp"))
                    if not isinstance(limits, dict) or at is None or limits.get("limit_id", "codex") != "codex":
                        continue
                    if newest is None or at > newest[0]:
                        newest = at, limits
                except (ValueError, AttributeError):
                    continue
        except OSError:
            continue
    return root, newest


def invalid(reason):
    return {"eligible": False, "reason": reason}


API_ENV = {"OPENAI_API_KEY", "CODEX_API_KEY", "OPENAI_BASE_URL", "ANTHROPIC_API_KEY",
           "ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_BASE_URL", "CLAUDE_CODE_USE_BEDROCK",
           "CLAUDE_CODE_USE_VERTEX", "CLAUDE_CODE_USE_FOUNDRY"}


def subscription_settings(kind, root, cwd):
    # Inspect the target folder too: a project may override the caller's subscription login.
    paths = [root / ("config.toml" if kind == "codex" else "settings.json")]
    for folder in (cwd, *cwd.parents):
        if kind == "codex":
            paths.append(folder / ".codex/config.toml")
        else:
            paths.extend(folder / ".claude" / name for name in ("settings.json", "settings.local.json"))
    if kind == "claude" and sys.platform == "darwin":
        paths.append(Path("/Library/Application Support/ClaudeCode/managed-settings.json"))
    for path in set(paths):
        if not path.exists():
            continue
        try:
            data = tomllib.loads(path.read_text()) if kind == "codex" else json.loads(path.read_text())
            if not isinstance(data, dict):
                return False
            if kind == "claude":
                env = data.get("env", {})
                if not isinstance(env, dict) or any(env.get(key) for key in API_ENV):
                    return False
                if data.get("apiKeyHelper") or data.get("forceLoginMethod") not in (None, "claudeai"):
                    return False
            else:
                profile = data.get("profiles", {}).get(data.get("profile"), {})
                for settings in (data, profile):
                    if not isinstance(settings, dict) or settings.get("model_provider") not in (None, "openai"):
                        return False
                    if settings.get("forced_login_method") not in (None, "chatgpt"):
                        return False
                if data.get("model_providers", {}).get("openai"):
                    return False
        except (OSError, ValueError, AttributeError, TypeError):
            return False
    return True


def normalize(at, short, week, now, short_key, week_key, ceiling, optional_short=False):
    if at is None or not -FUTURE_SLOP <= now - at <= MAX_AGE:
        return invalid("missing/stale/future observation")
    if (not isinstance(short, dict) and not (optional_short and short is None)) or not isinstance(week, dict):
        return invalid("missing limit window")
    five = percentage(short.get(short_key)) if short is not None else None
    sr = epoch(short.get("resets_at")) if short is not None else None
    seven, wr = percentage(week.get(week_key)), epoch(week.get("resets_at"))
    if (short is not None and (five is None or sr is None or not now < sr <= now + 18000)) or seven is None or wr is None or not now < wr <= now + WEEK:
        return invalid("invalid/reset limit window")
    gap = seven - 100 * (now - (wr - WEEK)) / WEEK
    eligible = (five is None or five < 80) and seven <= ceiling
    return {"eligible": eligible, "reason": "within reserve" if eligible else "reserve reached",
            "short": five, "week": seven, "gap": gap, "observed_at": at, "resets_at": wr}


def codex_quota(now, cwd):
    root, newest = latest_codex(now)
    auth_path = root / "auth.json"
    auth = read_json(auth_path)
    tokens = auth.get("tokens", {})
    if auth.get("auth_mode") != "chatgpt" or not isinstance(tokens, dict) or not identity(tokens.get("account_id")):
        return invalid("subscription account unknown")
    if any(os.environ.get(k) for k in ("OPENAI_API_KEY", "CODEX_API_KEY", "OPENAI_BASE_URL")):
        return invalid("API environment override")
    if not subscription_settings("codex", root, cwd):
        return invalid("subscription settings unknown/overridden")
    if newest is None:
        return invalid("usage unknown")
    at, limits = newest
    try:
        if at < auth_path.stat().st_mtime:
            return invalid("observation predates current login")
    except OSError:
        return invalid("account unavailable")
    credits = limits.get("credits")
    if not isinstance(credits, dict) or credits.get("has_credits") is not False or credits.get("unlimited") is not False:
        return invalid("paid credit availability unknown/enabled")
    windows = [limits.get("primary"), limits.get("secondary")]
    short = next((w for w in windows if isinstance(w, dict) and w.get("window_minutes") == 300), None)
    week = next((w for w in windows if isinstance(w, dict) and w.get("window_minutes") == 10080), None)
    return normalize(at, short, week, now, "used_percent", "used_percent", 95, optional_short=True)


def claude_quota(now, cwd):
    snap = read_json(state_dir() / "claude.json")
    account = claude_account()
    current = identity(account.get("accountUuid"))
    if not current or snap.get("account") != current or snap.get("machine") != machine():
        return invalid("observation account/machine mismatch")
    if account.get("hasExtraUsageEnabled") is not False:
        return invalid("extra usage unknown/enabled")
    if any(os.environ.get(k) for k in ("ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_BASE_URL", "CLAUDE_CODE_USE_BEDROCK", "CLAUDE_CODE_USE_VERTEX", "CLAUDE_CODE_USE_FOUNDRY")):
        return invalid("API environment override")
    root = Path(os.environ.get("CLAUDE_CONFIG_DIR", str(Path.home() / ".claude")))
    if not subscription_settings("claude", root, cwd):
        return invalid("subscription settings unknown/overridden")
    return normalize(epoch(snap.get("observed_at")), snap.get("five_hour"), snap.get("seven_day"), now, "used_percentage", "used_percentage", 80)


def select(now, policy, cwd=None):
    result = {"kind": None, "policy": policy, "reason": "invalid policy"}
    if policy == "codex-only":
        return dict(result, kind="codex", reason="legacy policy; quota routing bypassed")
    if policy != "quota-aware":
        return result
    cwd = Path(cwd or Path.cwd()).resolve()
    codex, claude = codex_quota(now, cwd), claude_quota(now, cwd)
    result.update(codex=codex, claude=claude)
    # Unknown Codex usage is not evidence for switching. The legacy default can run only when its own safety is known.
    if "week" not in codex:
        return dict(result, reason="Codex subscription usage/safety unknown; no automatic switch")
    if codex["eligible"] and claude["eligible"]:
        # Keep Codex unless its week is ahead of pace and Claude offers >5pp relief.
        kind = "claude" if codex["gap"] >= 5 and (claude["gap"] <= 0 or codex["gap"] - claude["gap"] > 5) else "codex"
        return dict(result, kind=kind, reason="weekly pace and reserve")
    if codex["eligible"] or claude["eligible"]:
        return dict(result, kind="codex" if codex["eligible"] else "claude", reason="only eligible subscription")
    return dict(result, reason="no fresh subscription within reserve with paid usage disabled")


def policy_value():
    local = state_dir() / "policy"
    return (local if local.exists() else Path(__file__).with_name("agent-quota-policy")).read_text().strip()


def record_decision(result, now):
    folder = state_dir()
    folder.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd = os.open(folder / "decisions.lock", os.O_CREAT | os.O_RDWR, 0o600)
    with os.fdopen(fd, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        path = folder / "decisions.jsonl"
        entry = (json.dumps(dict(result, timestamp=now), allow_nan=False) + "\n").encode()
        retained = b""
        if path.exists():
            with path.open("rb") as stream:
                size = stream.seek(0, 2)
                start = max(0, size - (DECISION_BYTES - len(entry)))
                stream.seek(start)
                retained = stream.read()
                if start:
                    retained = retained.partition(b"\n")[2]
                # Older append-only logs may end with a write interrupted halfway through a row.
                retained = retained[:retained.rfind(b"\n") + 1]
        fd, name = tempfile.mkstemp(dir=folder)
        try:
            with os.fdopen(fd, "wb") as stream:
                stream.write(retained + entry)
            os.replace(name, path)
        finally:
            if os.path.exists(name):
                os.unlink(name)


def main():
    now = time.time()
    command = sys.argv[1] if len(sys.argv) in (2, 3) else ""
    if command == "capture-claude":
        capture_claude(json.load(sys.stdin), now)
        return 0
    if command == "select":
        result = select(now, policy_value(), sys.argv[2] if len(sys.argv) == 3 else None)
        record_decision(result, now)
        print(json.dumps(result, allow_nan=False))
        return 0 if result["kind"] else 1
    if command == "codex-week":
        # The display wrapper supplies its clock, also used by its reset wording.
        if len(sys.argv) == 3:
            now = float(sys.argv[2])
        _, newest = latest_codex(now, display=True)
        if newest:
            at, limits = newest
            for window in (limits.get("primary"), limits.get("secondary")):
                if isinstance(window, dict) and window.get("window_minutes") == 10080:
                    used, reset = epoch(window.get("used_percent")), epoch(window.get("resets_at"))
                    if used is not None and reset is not None:
                        used = max(0, min(100, used))
                        print(f"{0 if reset <= now else used:g}\t{int(reset)}\t{int(at)}")
                        return 0
        return 1
    print("usage: agent-quota select|capture-claude|codex-week", file=sys.stderr)
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, TypeError, AttributeError) as error:
        # Do not print input or exception messages, which might contain private JSON.
        print("agent-quota: local quota unavailable (" + type(error).__name__ + ")", file=sys.stderr)
        sys.exit(1)
