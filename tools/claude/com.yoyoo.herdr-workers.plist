<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.yoyoo.herdr-workers</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>/Users/yoyoo/.dotfiles/tools/claude/herdr-workers-server.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/yoyoo/Library/Logs/herdr-workers.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/yoyoo/Library/Logs/herdr-workers.log</string>
</dict>
</plist>
