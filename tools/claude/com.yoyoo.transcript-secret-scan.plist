<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.yoyoo.transcript-secret-scan</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>-I</string>
		<string>/Users/yoyoo/.dotfiles/tools/claude/transcript-secret-scan.py</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/yoyoo</string>
		<key>PATH</key>
		<string>/Users/yoyoo/.local/bin:/opt/homebrew/bin:/opt/homebrew/share/google-cloud-sdk/bin:/usr/bin:/bin</string>
		<key>CLOUDSDK_ACTIVE_CONFIG_NAME</key>
		<string>munice</string>
	</dict>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>13</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>LowPriorityIO</key>
	<true/>
	<key>Nice</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>/Users/yoyoo/Library/Logs/transcript-secret-scan.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/yoyoo/Library/Logs/transcript-secret-scan.log</string>
</dict>
</plist>
