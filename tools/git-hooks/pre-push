#!/usr/bin/env bash
# Git pre-push: run the tests of the commits being pushed and refuse the push when one fails.
#
# It tests the commit, not the working tree: a half-edited file or an untracked test must not decide what goes out.
# Tests are every tools/**/*.test.sh and every tools/**/*.py that mentions --selftest, so a new one needs no list.
# Git does not clone hook settings. Each clone turns this on with `git config core.hooksPath tools/git-hooks`:
# init.sh does that and verify.sh checks it.
#
# ponytail: `git push --no-verify` and `git -c core.hooksPath=` skip it. Agents are refused the first by the shared Bash
# hook; a determined caller gets past any local check, and only a server-side check would stop one.
set -uo pipefail

export PRE_PUSH_LIMIT=${PRE_PUSH_LIMIT:-300}   # seconds per test: a stuck test must end as a failure, not hold the push
JOBS=6   # one after another takes over 2 minutes, and an agent's Bash call gives up at 2 minutes

T=$(mktemp -d) || exit 1
trap 'rm -rf "$T"' EXIT

shas=$(awk '$2 !~ /^0+$/ { print $2 }' | sort -u)   # a deletion (all zeros) sends no commit
[ -n "$shas" ] || exit 0

for sha in $shas; do
  mkdir "$T/$sha" && git archive "$sha" | tar -x -C "$T/$sha" || { echo "pre-push: could not unpack $sha" >&2; exit 1; }
done

# Git exports GIT_DIR and friends to hooks, and a test's `git init` in its sandbox would land in this repo. The session's own
# variables go too, so a test gets the same answer from any terminal and cannot reach the real herdr pane behind this push.
# shellcheck disable=SC2046  # one name per word
unset $(git rev-parse --local-env-vars) $(compgen -e | grep -E '^(HERDR|CLAUDE|CODEX|MUNICE)')

run() {
  local log="$OUT/${1//\//_}.log" cmd=(bash "$1") rc=0
  [[ $1 != *.py ]] || cmd=(python3 -I "$1" --selftest)
  # alarm survives exec and SIGALRM ends the test with exit 142. macOS has no `timeout` of its own.
  perl -e 'alarm shift; exec @ARGV' "$PRE_PUSH_LIMIT" "${cmd[@]}" </dev/null >"$log" 2>&1 || rc=$?
  [ "$rc" = 0 ] && return
  [ "$rc" = 142 ] && echo "stopped after ${PRE_PUSH_LIMIT}s" >>"$log"
  echo "$1" >>"$OUT/failed"
}
export -f run

for sha in $shas; do
  export OUT="$T/$sha.out"
  mkdir "$OUT"
  cd "$T/$sha" || exit 1
  list=$( { find tools -name '*.test.sh'; grep -rl --include='*.py' -e --selftest tools; } 2>/dev/null )
  if [ -z "$list" ]; then
    echo "pre-push: found no tests in ${sha:0:7}; refusing rather than passing untested" >&2
    exit 1
  fi
  echo "pre-push: running $(wc -l <<<"$list" | tr -d ' ') tests on ${sha:0:7}" >&2
  xargs -P "$JOBS" -I{} bash -c 'run "$1"' _ {} <<<"$list"
  if [ -s "$OUT/failed" ]; then
    echo "pre-push: push refused, these tests failed on ${sha:0:7}:" >&2
    while read -r f; do
      echo "--- $f" >&2
      tail -n 15 "$OUT/${f//\//_}.log" >&2
    done <"$OUT/failed"
    exit 1
  fi
done
