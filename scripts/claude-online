#!/bin/bash
# Launch Claude Code only once the network can actually resolve names.
#
# Why this exists: the first command typed after a closed lid opens races Wi-Fi
# association and dies with "API Error: Can't reach the API server (ENOTFOUND)".
#
# Why it does NOT copy GomGomBot's moderation-scan guard: that one checks
# `scutil --dns` for a `nameserver[0]` line. This Mac has DNS statically set to
# 1.1.1.1/8.8.8.8 (the gateway 172.16.8.1 serves no DNS at all — measured 0/10),
# so that line is present even with the radio down. It would pass instantly and
# guard nothing. Resolving a real name is the only honest check.
set -u
HOST="${CLAUDE_PROBE_HOST:-api.anthropic.com}"
DEADLINE=$(( $(date +%s) + ${CLAUDE_WAIT_SECS:-45} ))

if ! dscacheutil -q host -a name "$HOST" 2>/dev/null | grep -q ip_address; then
  printf 'waiting for DNS'
  while [ "$(date +%s)" -lt "$DEADLINE" ]; do
    printf '.'
    sleep 1
    if dscacheutil -q host -a name "$HOST" 2>/dev/null | grep -q ip_address; then
      printf ' ok\n'; break
    fi
  done
  # Fall through on timeout: better to launch and let Claude report the error
  # than to silently refuse to start.
  [ "$(date +%s)" -lt "$DEADLINE" ] || printf ' timeout — 그냥 실행합니다\n'
fi

# CLI settings survive /clear because they belong to this process. Do not narrow
# setting-sources or use --bare: both would also remove safety hooks and rules.
# A full session remains available for jobs needing an excluded integration:
# CLAUDE_STARTUP_PROFILE=full claude ...
profile_args=()
# Keep profile values out of argv: broad process-name queries also inspect argv.
# Files survive /clear and concurrent launches; a content hash keeps them stable.
settings_file() (
  umask 077
  local dir="${XDG_STATE_HOME:-$HOME/.local/state}/claude-startup" sum temporary path
  if ! mkdir -p "$dir" 2>/dev/null || [ ! -w "$dir" ]; then
    dir=$(mktemp -d "${TMPDIR:-/tmp}/claude-startup.XXXXXX") || return 1
  fi
  sum=$(printf '%s' "$settings" | shasum -a 256 | cut -d ' ' -f1) || return 1
  path="$dir/settings-$sum.json"
  # Reuse unchanged content without touching mtime or triggering config reloads.
  if [ -f "$path" ] && [ ! -L "$path" ] && cmp -s "$path" <(printf '%s\n' "$settings"); then
    printf '%s\n' "$path"; return
  fi
  temporary=$(mktemp "$dir/settings.XXXXXX") || return 1
  printf '%s\n' "$settings" >"$temporary" && mv -f "$temporary" "$path" || return 1
  printf '%s\n' "$path"
)
role=${CLAUDE_STARTUP_ROLE:-}
main_file="${XDG_STATE_HOME:-$HOME/.local/state}/orchestrator/main"
if [ -z "$role" ] && [ -n "${HERDR_PANE_ID:-}" ] && [ -f "$main_file" ]; then
  terminal=$(herdr pane get "$HERDR_PANE_ID" 2>/dev/null | jq -r '.result.pane.terminal_id // empty')
  [ -z "$terminal" ] || [ "$(cat "$main_file")" != "$terminal" ] || role=main
fi
# What this start loads, for main-refresh: its 05:00 run restarts instead of /clear once that changes (main-startup).
# Not a claude run inside a session (CLAUDECODE: `claude -p` from the main pane's Bash tool): that is not the pane's process.
[ "$role" != main ] || [ -n "${CLAUDECODE:-}" ] || /bin/bash "$(dirname "$0")/../tools/agent-hooks/main-startup" record 2>/dev/null || :
if [ -z "$role" ]; then
  case "$PWD/" in "$HOME/work/munice/"*) role=general ;; esac
fi
# paneRules (worker only): rule files a pane under a lead loads without their `<!-- pane:skip -->` blocks, which only
# leads and the main pane need. The full file goes in claudeMdExcludes and the filtered copy comes back through
# --append-system-prompt-file, so the file stays the one source and sessions opened by hand still load it whole
# (api#1031). Claude hides HTML comments from rule files it loads, so the markers cost those sessions nothing.
pane_view() { # A rule file without its lead-only blocks.
  # ponytail: one-line comments only; a marker inside a multi-line comment is not seen.
  awk '
    /^<!-- \/pane:skip -->$/ { skip = 0; next }
    /^<!-- pane:skip -->$/ { skip = 1; next }
    skip { next }
    /^<!-- pane: .* -->$/ { sub(/^<!-- pane: /, ""); sub(/ -->$/, ""); print; next }
    /^<!--.*-->$/ { next }
    { print }' "$1"
}
rules_text=""
pane_rules() { # Rewrites $settings; adds the filtered copies to $rules_text.
  local file under excludes=()
  while IFS=$'\t' read -r file under; do
    file=${file/#\~/$HOME} under=${under/#\~/$HOME}
    [ -f "$file" ] || continue
    if [ -n "$under" ]; then case "$PWD/" in "$under"/*) ;; *) continue ;; esac; fi
    excludes+=("$file")
    rules_text+="Contents of $file, as loaded in a pane under a lead:"$'\n\n'"$(pane_view "$file")"$'\n\n'
  done < <(jq -r '.paneRules[]? | [.file, .under // ""] | @tsv' <<<"$settings")
  settings=$(jq -c 'del(.paneRules) | if $ARGS.positional == [] then . else .claudeMdExcludes = $ARGS.positional end' \
    --args ${excludes[@]+"${excludes[@]}"} <<<"$settings")
}
save_rules() { # $rules_text into $rules_file.
  local dir="${XDG_STATE_HOME:-$HOME/.local/state}/claude-startup" sum
  mkdir -p "$dir" || return 1
  sum=$(printf '%s' "$rules_text" | shasum -a 256 | cut -c1-16)
  rules_file="$dir/pane-rules-$sum.md" # same text, same file: launches never pile up copies
  [ -f "$rules_file" ] || { printf '%s' "$rules_text" >"$rules_file.$$" && mv "$rules_file.$$" "$rules_file"; } || return 1
}
settings="" rules_file="" worker_view=""
case "$role" in
  worker | main | general | check)
    if [ "${CLAUDE_STARTUP_PROFILE:-}" != full ]; then
      profile="$(cd "$(dirname "$0")/.." && pwd)/tools/claude/startup-profile.json"
      settings=$(jq -c --arg role "$role" '.common * (.roles[$role] // {})' "$profile") || exit 1
      # pane-spawn --artifact: a job that publishes a page keeps the Artifact tool; the rest of the profile stays (api#1065).
      [ -z "${CLAUDE_STARTUP_ARTIFACT:-}" ] || settings=$(jq -c 'del(.enableArtifact)' <<<"$settings") || exit 1
      # dietSkills (worker only): skills a pane under a lead almost never calls (api#1066). pane-spawn --skills keeps them; the key never reaches claude.
      if [ -n "${CLAUDE_STARTUP_SKILLS:-}" ]; then settings=$(jq -c 'del(.dietSkills)' <<<"$settings") || exit 1
      else settings=$(jq -c '(. * (.dietSkills // {})) | del(.dietSkills)' <<<"$settings") || exit 1; fi
      # analysisOff (worker only): connections only an investigation or analysis job needs (요유 2026-11-26). pane-spawn
      # --analysis keeps them, and so does harness v0.1.0; the key never reaches claude.
      if [ -n "${CLAUDE_STARTUP_ANALYSIS:-}" ] || [ "$(cat "$HOME/.config/agent-harness/version" 2>/dev/null)" = v0.1.0 ]; then
        settings=$(jq -c 'del(.analysisOff)' <<<"$settings") || exit 1
      else
        settings=$(jq -c '(.analysisOff // {}) as $off | del(.analysisOff) | if $off == {} then . else .deniedMcpServers += $off.deniedMcpServers | .enabledPlugins += $off.enabledPlugins end' <<<"$settings") || exit 1
      fi
      [ "$(jq -r 'has("paneRules")' <<<"$settings")" != true ] || worker_view=1
      pane_rules || exit 1
    fi ;;
esac
# Claude reads project settings only in the start folder and CLAUDE.local.md only above it. Hand a sub-folder or a
# worktree its project's plugins and rules (project-scope.py), whatever the role or profile. The profile wins.
scope=$(python3 -I "$(cd "$(dirname "$0")/.." && pwd)/tools/agent-hooks/project-scope.py" "$PWD" 2>/dev/null) || scope=""
if [ -n "$scope" ]; then
  [ "$(jq -r '.enabledPlugins == {}' <<<"$scope")" = true ] ||
    settings=$(jq -c --argjson scope "$scope" '{enabledPlugins: $scope.enabledPlugins} * (. // {})' <<<"${settings:-null}") || exit 1
  while IFS= read -r file; do
    [ -f "$file" ] || continue
    if [ -n "$worker_view" ]; then body=$(pane_view "$file"); else body=$(cat "$file"); fi
    rules_text+="Contents of $file, the project rules of this worktree:"$'\n\n'"$body"$'\n\n'
  done < <(jq -r '.localRules[]' <<<"$scope")
fi
if [ -n "$rules_text" ] && ! save_rules; then
  # A pane that cannot get the filtered copy starts with the full rule files rather than not at all.
  rules_file=""
  [ -z "$settings" ] || settings=$(jq -c 'del(.claudeMdExcludes)' <<<"$settings") || exit 1
fi
if [ -n "$settings" ]; then
  settings_path=$(settings_file) || { echo 'claude-online: cannot save startup settings' >&2; exit 1; }
  profile_args=(--settings "$settings_path")
fi
[ -z "$rules_file" ] || profile_args+=(--append-system-prompt-file "$rules_file")
# A Claude check needs process and network inspection too. Protect the checked
# folder in the whole process tree, including Edit/Write and shell children;
# Claude's Bash-only sandbox would leave its file tools outside that boundary.
# Resolve symlinks before building the Seatbelt literal, and fail closed.
if [ -n "${CLAUDE_CHECK_TARGET:-}" ]; then
  [ "$(uname -s)" = Darwin ] && [ -x /usr/bin/sandbox-exec ] || { echo 'claude-online: check protection requires macOS sandbox-exec' >&2; exit 1; }
  target=$(cd "$CLAUDE_CHECK_TARGET" 2>/dev/null && pwd -P) || { echo 'claude-online: check target must be an existing folder' >&2; exit 1; }
  literal=$(jq -Rn --arg target "$target" '$target') || exit 1
  # ps is setuid and cannot exec under Seatbelt without this exception.
  # Only Apple's immutable read-only binary leaves the sandbox. A copied or
  # similarly named executable and shell redirections keep the write boundary.
  seatbelt="(version 1)(allow default)(deny file-write* (subpath $literal))"
  seatbelt+='(allow process-exec (literal "/bin/ps") (with no-sandbox))'
  exec /usr/bin/sandbox-exec -p "$seatbelt" \
    "${CLAUDE_BIN:-claude}" ${profile_args[@]+"${profile_args[@]}"} "$@"
fi
exec claude ${profile_args[@]+"${profile_args[@]}"} "$@"
